# Public browser key from https://web3forms.com. Not a server credential.
# Set the same repository variable in GitHub Actions before enabling live submissions.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) and Microsoft Clarity project ID.
# Public IDs. Leave empty to build without analytics. Set the same repository variables in GitHub Actions.
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=
