---
import Icon from "./Icon.astro";
interface Props {
  href?: string;
  disabled?: boolean;
  secondary?: boolean;
  icon?: string;
  type?: "button" | "submit";
  class?: string;
}
const {
  href,
  disabled = false,
  secondary = false,
  icon = "arrow-right",
  type = "button",
  class: className = "",
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  disabled={href ? undefined : disabled}
  type={href ? undefined : type}
  class:list={["action", { "action--secondary": secondary }, className]}
>
  {!secondary && <span class="action-halo" aria-hidden="true"><span></span></span>}
  <span class="action-label"><slot /></span>
  {icon && (
    <span class:list={["action-icon", { "action-icon--travel": icon === "arrow-right" }]} aria-hidden="true">
      <Icon name={icon} />
      {icon === "arrow-right" && <Icon name={icon} class="action-arrow-copy" />}
    </span>
  )}
</Tag>
