---
import Preferences from "./Preferences.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
const menu = [
  {
    key: "projects",
    label: "Projects",
    href: "/projects",
    wide: true,
    rows: [
      { title: "Web Design & Dev", num: "01" },
      { title: "Branding & Graphic Design", num: "02" },
      { title: "Digital Art & Illustration", num: "03" },
      { title: "Music & Audiovisual", num: "04" },
      { title: "See all projects", num: "05", href: "/projects" },
      { title: "Services", num: "06", href: "/services" },
    ],
    feature: {
      eyebrow: "FEATURED CASE",
      title: "Green Nation Collective",
      meta: "Web Design & Dev · 2025–26",
      cta: "See case",
    },
  },
  {
    key: "about",
    label: "About",
    href: "/about",
    heading: "ABOUT",
    rows: [
      { title: "My story", num: "01" },
      { title: "Career timeline", num: "02" },
      { title: "Skills & Stack", num: "03" },
      { title: "How I work", num: "04" },
    ],
    feature: {
      eyebrow: "ABOUT ME",
      title: "10+ years creating for international agencies and brands",
      cta: "Download CV",
    },
  },
  {
    key: "experiments",
    label: "Experiments",
    href: "/projects?category=experiments",
    heading: "EXPERIMENTS",
    rows: [
      { title: "Code", num: "01" },
      { title: "Generative art", num: "02" },
      { title: "Prototypes", num: "03" },
      { title: "Music", num: "04" },
    ],
    feature: {
      eyebrow: "RECENT EXPERIMENT",
      title: "[placeholder title]",
      cta: "See experiment",
    },
  },
  {
    key: "thoughts",
    label: "Thoughts",
    href: "/#thoughts",
    heading: "THOUGHTS",
    rows: [
      { title: "Latest posts", num: "01" },
      { title: "Categories", num: "02" },
      { title: "Archive", num: "03" },
    ],
    feature: {
      eyebrow: "RECENT POST",
      title: "[placeholder title]",
      meta: "[placeholder date]",
      cta: "Read",
    },
  },
];

const rowHref = (item: any, index: number) =>
  item.rows[index]?.href || (item.key === "about"
    ? ["/about", "/about#timeline", "/about#skills", "/about#how-i-work"][index]
    : item.key === "projects"
      ? index === 4
        ? "/projects"
        : `/projects?category=${index}`
      : item.key === "thoughts"
        ? "/#thoughts"
        : "/projects?category=experiments");
const clean = (text: string) => text.replace(/[→↗←]/g, "").trim();
import LogoModel from "./LogoModel.astro";
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-nav" transition:name="site-header" transition:persist="site-header" transition:animate="none">
  <a class="site-logo" transition:name="site-logo" transition:animate="none" href="/" aria-label="Pedr0 Nogueira home">
    <LogoModel />
  </a>
  <nav class="desktop-nav" transition:name="site-navigation" transition:animate="none" aria-label="Main navigation">
    {menu.map((item) => (
      <div class="nav-item" data-menu={item.key}>
        <a
          href={item.href}
          class="nav-link"
          aria-expanded="false"
          aria-controls={`nav-${item.key}`}
        >
          {item.label}
          <span class="nav-link-arrow" aria-hidden="true">
            <img
              src="/assets/figma/31-59-imgIconPixelArrowDownRight.svg"
              width="8"
              height="8"
              alt=""
            />
          </span>
        </a>
        <div
          id={`nav-${item.key}`}
          class:list={["nav-panel", { "nav-panel--wide": item.wide }]}
          inert
        >
          <div class="nav-list">
            <p class="nav-heading">{item.heading || "the works"}</p>
            {item.rows.map((row, index) => (
              <a href={rowHref(item, index)} class="nav-row">
                <span>
                  {clean(row.title)}
                  {item.key === "projects" && index === 4 && (
                    <Icon name="arrow-right" size={18} />
                  )}
                </span>
                <small>{row.num}</small>
              </a>
            ))}
          </div>
          <a
            href={
              item.key === "about"
                ? site.cvUrl || undefined
                : item.key === "projects"
                  ? "/work/green-nation-collective"
                  : item.href
            }
            aria-disabled={
              item.key === "about" && !site.cvUrl ? "true" : undefined
            }
            class="nav-feature"
          >
            <div class="nav-feature-thumb"></div>
            <small class="nav-feature-eyebrow">{item.feature.eyebrow}</small>
            <p>{item.feature.title}</p>
            {item.feature.meta && <small>{item.feature.meta}</small>}
            <span class="nav-feature-cta">
              {clean(item.feature.cta)} <Icon name="arrow-right" />
            </span>
          </a>
        </div>
      </div>
    ))}
  </nav>
  <div class="site-nav-actions">
    <div class="desktop-preferences">
      <Preferences />
    </div>
    <Button href="/contact">Book a call</Button>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<dialog transition:name="mobile-menu" transition:persist="mobile-menu" transition:animate="none" id="mobile-menu" class="mobile-dialog" tabindex="-1" aria-label="Main navigation">
  <div class="mobile-menu-header">
    <a class="site-logo" href="/" aria-label="Pedr0 Nogueira home">
      <LogoModel />
    </a>
    <button class="menu-close" aria-label="Close menu">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav aria-label="Mobile navigation">
    {menu.map((item) => (
      <details>
        <summary>
          {item.label}
          <Icon name="chevron-right" />
        </summary>
        <div class="mobile-submenu">
          <p class="nav-heading">{item.heading || "the works"}</p>
          {item.rows.map((row, index) => (
            <a class="nav-row" href={rowHref(item, index)}>
              <span>{clean(row.title)}</span>
              <small>{row.num}</small>
            </a>
          ))}
          <a
            class="nav-feature"
            href={
              item.key === "about"
                ? site.cvUrl || undefined
                : item.key === "projects"
                  ? "/work/green-nation-collective"
                  : item.href
            }
            aria-disabled={
              item.key === "about" && !site.cvUrl ? "true" : undefined
            }
          >
            <div class="nav-feature-thumb"></div>
            <small class="nav-feature-eyebrow">{item.feature.eyebrow}</small>
            <p>{item.feature.title}</p>
            {item.feature.meta && <small>{item.feature.meta}</small>}
            <span class="nav-feature-cta">
              {clean(item.feature.cta)} <Icon name="arrow-right" />
            </span>
          </a>
        </div>
      </details>
    ))}
  </nav>
  <Preferences id="mobile-preferences" inline />
  <Button href="/contact">Book a call</Button>
</dialog>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { gsap } from "gsap";
  onPageLoad((scope) => {
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu")!;
  const trigger = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // Hover wave: letters sway back and forth in depth, in sequence, starting from the one closest to where the pointer came in.
  const waveLogo = document.querySelector<HTMLElement>(".site-nav .site-logo");
  const waveModel = waveLogo?.querySelector<HTMLElement>(".site-logo__model");
  const faceChars = [...(waveLogo?.querySelectorAll<HTMLElement>(".site-logo__layer:first-child .site-logo__char") ?? [])];
  let waves: Animation[] = [];
  if (waveLogo && waveModel && faceChars.length && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    waveLogo.addEventListener("pointerenter", (event) => {
      if (reducedMotion.matches) return;
      // Re-entering while the letters are still settling keeps the current wave going.
      const settling = waves.filter((wave) => wave.playState === "running");
      if (settling.length) { settling.forEach((wave) => wave.effect?.updateTiming({ iterations: Infinity })); return; }
      waves = faceChars.map((char, index) => {
        const box = char.getBoundingClientRect();
        const distance = Math.hypot(event.clientX - (box.left + box.width / 2), event.clientY - (box.top + box.height / 2));
        // ponytail: 6ms of delay per px from the pointer; raise it for a slower ripple.
        return waveModel.animate(
          [
            { [`--w${index}`]: "0px", easing: "cubic-bezier(.45, 0, .55, 1)" },
            { [`--w${index}`]: "-12px", offset: .4, easing: "cubic-bezier(.45, 0, .55, 1)" },
            { [`--w${index}`]: "4px", offset: .75, easing: "cubic-bezier(.45, 0, .55, 1)" },
            { [`--w${index}`]: "0px" },
          ],
          { duration: 1400, delay: distance * 6, iterations: Infinity },
        );
      });
    }, { signal: scope.signal });
    // On leave each letter finishes the bob it is in, so nothing snaps.
    waveLogo.addEventListener("pointerleave", () => {
      waves.forEach((wave) => {
        const iteration = wave.effect?.getComputedTiming().currentIteration ?? 0;
        wave.effect?.updateTiming({ iterations: (iteration ?? 0) + 1 });
      });
    }, { signal: scope.signal });
    scope.cleanup(() => waves.forEach((wave) => wave.cancel()));
  }
  // Light magnetic pull on the 3D logo: it leans toward a nearby pointer. CSS eases the motion.
  const logo = document.querySelector<HTMLElement>(".site-nav .site-logo");
  if (logo && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let frame = 0;
    let pointer = { x: 0, y: 0 };
    const update = () => {
      frame = 0;
      const box = logo.getBoundingClientRect();
      const dx = pointer.x - (box.left + box.width / 2);
      const dy = pointer.y - (box.top + box.height / 2);
      // ponytail: linear falloff over 420px; tune RANGE/strength here.
      const pull = reducedMotion.matches ? 0 : Math.max(0, 1 - Math.hypot(dx, dy) / 420);
      logo.style.setProperty("--logo-tilt-x", `${(-dy / 14) * pull}deg`);
      logo.style.setProperty("--logo-tilt-y", `${(dx / 10) * pull}deg`);
      logo.style.setProperty("--logo-shift-x", `${(dx / 9) * pull}px`);
      logo.style.setProperty("--logo-shift-y", `${(dy / 9) * pull}px`);
    };
    window.addEventListener("pointermove", (event) => {
      pointer = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(update);
    }, { passive: true, signal: scope.signal });
    document.documentElement.addEventListener("pointerleave", () => {
      pointer = { x: -1e4, y: -1e4 };
      if (!frame) frame = requestAnimationFrame(update);
    }, { signal: scope.signal });
    scope.cleanup(() => cancelAnimationFrame(frame));
  }
  const mobileAnimations = new Set<Animation>();
  let closing = false;
  const menuLogo = dialog.querySelector<HTMLElement>(".mobile-menu-header .site-logo");
  const stopMobileAnimations = () => {
    mobileAnimations.forEach(animation => animation.cancel());
    mobileAnimations.clear();
  };
  const animateMobile = (element: Element, frames: Keyframe[], options: KeyframeAnimationOptions) => {
    const animation = element.animate(frames, options);
    mobileAnimations.add(animation);
    animation.onfinish = () => {
      // Remove filled exit effects so reopening cannot fall back to opacity: 0.
      animation.cancel();
      mobileAnimations.delete(animation);
    };
    return animation;
  };
  const close = (immediate = false) => {
    if (!dialog.open || closing) return;
    stopMobileAnimations();
    if (immediate || reducedMotion.matches) { dialog.close(); return; }
    closing = true;
    const icon = dialog.querySelector(".menu-close .pixel-icon")!;
    const animation = animateMobile(icon,
      [{ opacity: 1, transform: "rotate(0) scale(1)" }, { opacity: 0, transform: "rotate(70deg) scale(0.8)" }],
      { duration: 130, easing: "ease-in", fill: "forwards" });
    animation.finished.catch(() => {}).then(() => {
      if (!scope.signal.aborted && dialog.open) dialog.close();
      closing = false;
    });
  };
  trigger.addEventListener("click", (event) => {
    if (dialog.open) return;
    stopMobileAnimations();
    closing = false;
    dialog.showModal();
    // Safari focuses the first link when opening a dialog. Keep touch openings
    // on the dialog itself; keyboard openings retain a visible actionable focus.
    dialog.scrollTop = 0;
    if (event.detail > 0) dialog.focus({ preventScroll: true });
    else dialog.querySelector<HTMLButtonElement>(".menu-close")?.focus({ preventScroll: true });
    trigger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    // The menu's logo opens in the bar's isometric pose and turns to face the camera.
    requestAnimationFrame(() => requestAnimationFrame(() => menuLogo?.classList.add("is-flat")));
    if (!reducedMotion.matches) {
      const entries = dialog.querySelectorAll(":scope > nav > details, .preferences-panel--inline > fieldset, :scope > .action");
      entries.forEach((element, index) => animateMobile(element,
        [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "translateY(0)" }],
        { duration: 280, delay: index * 28, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "backwards" }));
      const icon = dialog.querySelector(".menu-close .pixel-icon")!;
      animateMobile(icon,
        [{ opacity: 0, transform: "rotate(-70deg) scale(0.8)" }, { opacity: 1, transform: "rotate(0) scale(1)" }],
        { duration: 260, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
    }
  }, { signal: scope.signal });
  dialog.querySelector(".menu-close")?.addEventListener("click", () => close(), { signal: scope.signal });
  dialog.addEventListener("cancel", (event) => { event.preventDefault(); close(); }, { signal: scope.signal });
  reducedMotion.addEventListener("change", () => { if (reducedMotion.matches) stopMobileAnimations(); }, { signal: scope.signal });
  scope.cleanup(() => { stopMobileAnimations(); if (dialog.open) dialog.close(); });
  dialog.addEventListener("close", () => {
    menuLogo?.classList.remove("is-flat");
    // Once the menu is gone, the bar's logo starts flat and turns back to its extruded pose.
    const barLogo = document.querySelector<HTMLElement>(".site-nav .site-logo");
    if (barLogo && !reducedMotion.matches) {
      barLogo.classList.add("no-transition", "is-flat");
      barLogo.getBoundingClientRect();
      barLogo.classList.remove("no-transition");
      requestAnimationFrame(() => requestAnimationFrame(() => barLogo.classList.remove("is-flat")));
    }
    stopMobileAnimations();
    closing = false;
    trigger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    trigger.focus({ preventScroll: true });
  }, { signal: scope.signal });
  dialog
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => close(true), { signal: scope.signal }));
  matchMedia("(min-width:1025px)").addEventListener("change", (e) => {
    if (e.matches && dialog.open) close(true);
  }, { signal: scope.signal });
  const items = [...document.querySelectorAll<HTMLElement>(".nav-item")];
  let openItem: HTMLElement | null = null;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  const children = (item: HTMLElement) => [
    ...item.querySelectorAll<HTMLElement>(
      ".nav-heading, .nav-row, .nav-feature",
    ),
  ];
  const setOpen = (active: HTMLElement | null) => {
    clearTimeout(closeTimer);
    if (active === openItem) return;
    openItem = active;
    items.forEach((item) => {
      const open = item === active;
      const wasOpen = item.classList.contains("is-open");
      item.classList.toggle("is-open", open);
      item
        .querySelector(".nav-link")!
        .setAttribute("aria-expanded", String(open));
      item.querySelector<HTMLElement>(".nav-panel")!.inert = !open;
      const content = children(item);
      gsap.killTweensOf(content);
      if (open && !wasOpen && !reducedMotion.matches) {
        gsap.fromTo(
          content,
          { opacity: 0, y: 16 },
          {
            opacity: 1,
            y: 0,
            duration: 0.32,
            stagger: 0.045,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
        );
      } else {
        gsap.set(content, { clearProps: "transform,opacity" });
      }
    });
  };
  reducedMotion.addEventListener("change", () => {
    if (reducedMotion.matches)
      items.forEach((item) => {
        gsap.killTweensOf(children(item));
        gsap.set(children(item), { clearProps: "transform,opacity" });
      });
  }, { signal: scope.signal });
  scope.cleanup(() => {
    clearTimeout(closeTimer);
    setOpen(null);
    if (dialog.open) dialog.close();
    document.body.style.overflow = "";
    items.forEach((item) => gsap.killTweensOf(children(item)));
  });
  items.forEach((item) => {
    const link = item.querySelector<HTMLAnchorElement>(".nav-link")!;
    item.addEventListener("mouseenter", () => setOpen(item), { signal: scope.signal });
    item.addEventListener("mouseleave", () => {
      if (!item.contains(document.activeElement)) {
        closeTimer = scope.timeout(() => {
          if (openItem === item) setOpen(null);
        }, 5000);
      }
    }, { signal: scope.signal });
    item.addEventListener("focusin", () => setOpen(item), { signal: scope.signal });
    item.addEventListener("focusout", (event) => {
      if (
        event.relatedTarget instanceof Node &&
        !item.contains(event.relatedTarget)
      )
        setOpen(null);
    }, { signal: scope.signal });
    item.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        link.focus();
        setOpen(null);
      }
      if (event.key === "ArrowDown" && event.target === link) {
        event.preventDefault();
        setOpen(item);
        // Wait for the visibility transition to enter its visible state.
        scope.frame(() =>
          scope.frame(() => {
            if (item.classList.contains("is-open"))
              item.querySelector<HTMLAnchorElement>(".nav-row")?.focus();
          }),
        );
      }
    }, { signal: scope.signal });
  });
  document.addEventListener("click", (event) => {
    if (!items.some((item) => item.contains(event.target as Node)))
      setOpen(null);
  }, { signal: scope.signal });
  // The main nav pill lights up while the pointer is close and its glow trails
  // the cursor, easing towards it until both position and intensity settle.
  const desktopNav = document.querySelector<HTMLElement>(".desktop-nav");
  if (desktopNav) {
    let frame = 0;
    let rect = desktopNav.getBoundingClientRect();
    let currentX = 50;
    let currentY = 50;
    let currentAlpha = 0;
    let targetX = currentX;
    let targetY = currentY;
    let targetAlpha = 0;
    const apply = () => {
      desktopNav.style.setProperty("--nav-glow-x", `${currentX.toFixed(2)}%`);
      desktopNav.style.setProperty("--nav-glow-y", `${currentY.toFixed(2)}%`);
      desktopNav.style.setProperty("--nav-glow-alpha", currentAlpha.toFixed(3));
    };
    const tick = () => {
      frame = 0;
      currentX += (targetX - currentX) * 0.07;
      currentY += (targetY - currentY) * 0.07;
      currentAlpha += (targetAlpha - currentAlpha) * 0.09;
      apply();
      if (
        Math.abs(targetX - currentX) > 0.06 ||
        Math.abs(targetY - currentY) > 0.06 ||
        Math.abs(targetAlpha - currentAlpha) > 0.004
      ) {
        frame = requestAnimationFrame(tick);
      }
    };
    const onPointerMove = (event: PointerEvent) => {
      if (reducedMotion.matches) return;
      rect = desktopNav.getBoundingClientRect();
      const outsideX = Math.max(rect.left - event.clientX, 0, event.clientX - rect.right);
      const outsideY = Math.max(rect.top - event.clientY, 0, event.clientY - rect.bottom);
      const distance = Math.hypot(outsideX, outsideY);
      targetAlpha = Math.max(0, Math.min(1, 1 - distance / 120));
      targetX = Math.max(4, Math.min(96, ((event.clientX - rect.left) / rect.width) * 100));
      targetY = Math.max(6, Math.min(94, ((event.clientY - rect.top) / rect.height) * 100));
      if (!frame) frame = requestAnimationFrame(tick);
    };
    window.addEventListener("pointermove", onPointerMove, { passive: true, signal: scope.signal });
    window.addEventListener("resize", () => { rect = desktopNav.getBoundingClientRect(); }, { passive: true, signal: scope.signal });
    scope.cleanup(() => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      desktopNav.style.removeProperty("--nav-glow-x");
      desktopNav.style.removeProperty("--nav-glow-y");
      desktopNav.style.removeProperty("--nav-glow-alpha");
    });
  }
  // The lighter gradient centre follows the pointer with a soft ease so the
  // panel feels lit rather than highlighted in a fixed corner.
  document.querySelectorAll<HTMLElement>(".nav-panel").forEach((panel) => {
    let frame = 0;
    let currentX = 24;
    let currentY = 20;
    let targetX = currentX;
    let targetY = currentY;
    const apply = () => {
      panel.style.setProperty("--nav-glow-x", `${currentX.toFixed(2)}%`);
      panel.style.setProperty("--nav-glow-y", `${currentY.toFixed(2)}%`);
    };
    const tick = () => {
      frame = 0;
      // A gentle follow: the glow trails the pointer instead of sticking to it.
      currentX += (targetX - currentX) * 0.055;
      currentY += (targetY - currentY) * 0.055;
      apply();
      if (
        Math.abs(targetX - currentX) > 0.06 ||
        Math.abs(targetY - currentY) > 0.06
      ) {
        frame = requestAnimationFrame(tick);
      }
    };
    panel.addEventListener("pointermove", (event) => {
      if (reducedMotion.matches) return;
      const rect = panel.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width) * 100;
      targetY = ((event.clientY - rect.top) / rect.height) * 100;
      if (!frame) frame = requestAnimationFrame(tick);
    }, { signal: scope.signal });
    scope.cleanup(() => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    });
  });
  });
</script>
