---
import Preferences from "./Preferences.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
const menu = [
  {
    key: "projects",
    label: "Projects",
    href: "/projects",
    wide: true,
    rows: [
      { title: "Web Design & Dev", num: "01" },
      { title: "Branding & Graphic Design", num: "02" },
      { title: "Digital Art & Illustration", num: "03" },
      { title: "Music & Audiovisual", num: "04" },
      { title: "See all projects", num: "05", href: "/projects" },
    ],
    feature: {
      eyebrow: "FEATURED CASE",
      title: "Green Nation Collective",
      meta: "Web Design & Dev · 2025–26",
      cta: "See case",
    },
  },
  {
    key: "about",
    label: "About",
    href: "/about",
    heading: "ABOUT",
    rows: [
      { title: "My story", num: "01" },
      { title: "Career timeline", num: "02" },
      { title: "Skills & Stack", num: "03" },
      { title: "How I work", num: "04" },
    ],
    feature: {
      eyebrow: "ABOUT ME",
      title: "10+ years creating for international agencies and brands",
      cta: "Download CV",
    },
  },
  {
    key: "experiments",
    label: "Experiments",
    href: "/projects?category=experiments",
    heading: "EXPERIMENTS",
    rows: [
      { title: "Code", num: "01" },
      { title: "Generative art", num: "02" },
      { title: "Prototypes", num: "03" },
      { title: "Music", num: "04" },
    ],
    feature: {
      eyebrow: "RECENT EXPERIMENT",
      title: "[placeholder title]",
      cta: "See experiment",
    },
  },
  {
    key: "thoughts",
    label: "Thoughts",
    href: "/#thoughts",
    heading: "THOUGHTS",
    rows: [
      { title: "Latest posts", num: "01" },
      { title: "Categories", num: "02" },
      { title: "Archive", num: "03" },
    ],
    feature: {
      eyebrow: "RECENT POST",
      title: "[placeholder title]",
      meta: "[placeholder date]",
      cta: "Read",
    },
  },
];

const rowHref = (item: any, index: number) =>
  item.key === "about"
    ? ["/about", "/about#timeline", "/about#skills", "/#process"][index]
    : item.key === "projects"
      ? index === 4
        ? "/projects"
        : `/projects?category=${index}`
      : item.key === "thoughts"
        ? "/#thoughts"
        : "/projects?category=experiments";
const clean = (text: string) => text.replace(/[→↗←]/g, "").trim();
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-nav">
  <a class="site-logo" href="/" aria-label="Pedr0 Nogueira home">
    Pedr0
    <br />
    Nogueira
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {menu.map((item) => (
      <div class="nav-item">
        <a href={item.href} class="nav-link" aria-expanded="false">
          {item.label}
        </a>
        <div class:list={["nav-panel", { "nav-panel--wide": item.wide }]}>
          <div>
            <p class="mono">{item.heading || "the works"}</p>
            {item.rows.map((row, index) => (
              <a href={rowHref(item, index)} class="nav-row">
                <span>{clean(row.title)}</span>
                <small>{row.num}</small>
              </a>
            ))}
          </div>
          <a
            href={
              item.key === "about"
                ? site.cvUrl || undefined
                : item.key === "projects"
                  ? "/work/green-nation-collective"
                  : item.href
            }
            aria-disabled={
              item.key === "about" && !site.cvUrl ? "true" : undefined
            }
            class="nav-feature"
          >
            <div class="nav-feature-thumb"></div>
            <small class="mono">{item.feature.eyebrow}</small>
            <p>{item.feature.title}</p>
            {item.feature.meta && <small>{item.feature.meta}</small>}
            <span class="label">
              {clean(item.feature.cta)} <Icon name="arrow-right" />
            </span>
          </a>
        </div>
      </div>
    ))}
  </nav>
  <div class="site-nav-actions">
    <div class="desktop-preferences">
      <Preferences />
    </div>
    <Button href="/contact">Book a call</Button>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-dialog" aria-label="Main navigation">
  <div class="mobile-menu-header">
    <a class="site-logo" href="/">
      Pedr0
      <br />
      Nogueira
    </a>
    <button class="menu-close" aria-label="Close menu">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav aria-label="Mobile navigation">
    {menu.map((item) => (
      <details>
        <summary>
          {item.label}
          <Icon name="chevron-right" />
        </summary>
        <div class="mobile-submenu">
          {item.rows.map((row, index) => (
            <a href={rowHref(item, index)}>{clean(row.title)}</a>
          ))}
          <a class="nav-feature" href={item.href}>
            <small>{item.feature.eyebrow}</small>
            <p>{item.feature.title}</p>
            <span>
              {clean(item.feature.cta)} <Icon name="arrow-right" />
            </span>
          </a>
        </div>
      </details>
    ))}
  </nav>
  <Preferences id="mobile-preferences" inline />
  <Button href="/contact">Book a call</Button>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu")!;
  const trigger = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const close = () => dialog.close();
  trigger.addEventListener("click", () => {
    dialog.showModal();
    trigger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });
  dialog.querySelector(".menu-close")?.addEventListener("click", close);
  dialog.addEventListener("close", () => {
    trigger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    trigger.focus();
  });
  dialog
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", close));
  matchMedia("(min-width:1025px)").addEventListener("change", (e) => {
    if (e.matches && dialog.open) close();
  });
  document.querySelectorAll<HTMLElement>(".nav-item").forEach((item) => {
    const a = item.querySelector("a")!;
    const set = (open: boolean) => {
      item.classList.toggle("is-open", open);
      a.setAttribute("aria-expanded", String(open));
      if (open && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        import("gsap").then(({ gsap }) => {
          if (!item.classList.contains("is-open")) return;
          const panel = item.querySelector(".nav-panel");
          if (panel)
            gsap.fromTo(
              panel.children,
              { y: 6, opacity: 0.75 },
              {
                y: 0,
                opacity: 1,
                duration: 0.18,
                ease: "power2.out",
                clearProps: "transform,opacity",
              },
            );
        });
      }
    };
    item.addEventListener("mouseenter", () => set(true));
    item.addEventListener("mouseleave", () => set(false));
    item.addEventListener("focusin", () => set(true));
    item.addEventListener("focusout", () =>
      setTimeout(() => {
        if (!item.contains(document.activeElement)) set(false);
      }, 0),
    );
    item.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        a.focus();
        set(false);
      }
    });
  });
</script>
