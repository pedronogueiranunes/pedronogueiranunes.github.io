---
// Menu content is data-driven so the 4 megamenu columns share one markup block
// instead of 4 hand-copied ones. "Projects" is the wide two-column layout from
// Figma (32:263 -> 31:59); the other three are the narrow single-column layout
// (32:132 / 32:198 / 32:262).
const menu = [
  {
    key: 'projects',
    label: 'Projects',
    href: '#work',
    wide: true,
    rows: [
      { title: 'Web Design & Dev', num: '01' },
      { title: 'Branding & Graphic Design', num: '02' },
      { title: 'Digital Art & Illustration', num: '03' },
      { title: 'Music & Audiovisual', num: '04' },
      { title: 'See all projects →', num: '05', href: '#work' },
    ],
    feature: {
      eyebrow: 'FEATURED CASE',
      title: 'Green Nation Collective',
      meta: 'Web Design & Dev · 2025–26',
      cta: 'See case →',
    },
  },
  {
    key: 'about',
    label: 'About',
    href: '#about',
    heading: 'ABOUT',
    rows: [
      { title: 'My story', num: '01' },
      { title: 'Career timeline', num: '02' },
      { title: 'Skills & Stack', num: '03' },
      { title: 'How I work', num: '04' },
    ],
    feature: {
      eyebrow: 'ABOUT ME',
      title: '10+ years creating for international agencies and brands',
      cta: 'Download CV →',
    },
  },
  {
    key: 'experiments',
    label: 'Experiments',
    href: '#experiments',
    heading: 'EXPERIMENTS',
    rows: [
      { title: 'Code', num: '01' },
      { title: 'Generative art', num: '02' },
      { title: 'Prototypes', num: '03' },
      { title: 'Music', num: '04' },
    ],
    feature: {
      eyebrow: 'RECENT EXPERIMENT',
      title: '[placeholder title]',
      cta: 'See experiment →',
    },
  },
  {
    key: 'thoughts',
    label: 'Thoughts',
    href: '#thoughts',
    heading: 'THOUGHTS',
    rows: [
      { title: 'Latest posts', num: '01' },
      { title: 'Categories', num: '02' },
      { title: 'Archive', num: '03' },
    ],
    feature: {
      eyebrow: 'RECENT POST',
      title: '[placeholder title]',
      meta: '[placeholder date]',
      cta: 'Read →',
    },
  },
];
---

<header class="mega-navbar">
  <div class="mega-navbar__logo">its pedro!</div>

  <nav class="mega-navbar__pill">
    {menu.map((item) => (
      <div class="mega-navbar__item">
        <a class="mega-navbar__link" href={item.href}>
          {item.label}
          <span class="mega-navbar__arrow" aria-hidden="true">→</span>
        </a>
        <div class={`mega-navbar__panel ${item.wide ? 'mega-navbar__panel--wide' : ''}`}>
          <div class="mega-navbar__col">
            {item.heading && <p class="mega-navbar__heading">{item.heading}</p>}
            <div class="mega-navbar__rows">
              {item.rows.map((row) => (
                <a class="mega-navbar__row" href={row.href ?? '#'}>
                  <span class="mega-navbar__row-title">{row.title}</span>
                  <span class="mega-navbar__row-num">{row.num}</span>
                </a>
              ))}
            </div>
          </div>
          <a class="mega-navbar__feature" href="#">
            <div class="mega-navbar__feature-thumb"></div>
            <p class="mega-navbar__feature-eyebrow">{item.feature.eyebrow}</p>
            <p class="mega-navbar__feature-title">{item.feature.title}</p>
            {item.feature.meta && <p class="mega-navbar__feature-meta">{item.feature.meta}</p>}
            <p class="mega-navbar__feature-cta">{item.feature.cta}</p>
          </a>
        </div>
      </div>
    ))}
  </nav>

  <div class="mega-navbar__actions">
    <button class="pill-toggle" id="lang-toggle" type="button" aria-label="Toggle language">
      <img src="/assets/icon-globe.svg" alt="" width="14" height="14">
      <span id="lang-toggle-label">US</span>
    </button>
    <button class="pill-toggle pill-toggle--grow" id="theme-toggle" type="button" aria-label="Toggle theme">
      <img src="/assets/icon-moon.svg" alt="" width="14" height="14">
    </button>
    <button class="btn-primary" type="button">Book a call</button>
  </div>

  <button class="mega-navbar__burger" id="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-menu__links">
    {menu.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <button class="btn-primary" type="button">Book a call</button>
</div>

<script>
  import { gsap } from 'gsap';

  const CLOSE_DELAY_MS = 5000;
  const items = document.querySelectorAll<HTMLElement>('.mega-navbar__item');
  let openItem: HTMLElement | null = null;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  // Panels are centered with GSAP's xPercent instead of a CSS transform,
  // since GSAP tracks x/y/scale as separate components internally and
  // recomposes them on every tween — a plain CSS `transform` would get
  // clobbered the moment we animate y/scale for the open/close motion.
  document.querySelectorAll<HTMLElement>('.mega-navbar__panel').forEach((panel) => {
    gsap.set(panel, { xPercent: -50 });
  });

  function animatedChildren(panel: HTMLElement) {
    return panel.querySelectorAll('.mega-navbar__heading, .mega-navbar__row, .mega-navbar__feature');
  }

  // The hero's gaussian-splat WebGL canvas breaks backdrop-filter compositing
  // in this browser engine whenever it's rendering behind the panel — the
  // blur silently no-ops instead of erroring. The panel already fully covers
  // it while open, so hiding the canvas for that stretch costs nothing
  // visible and sidesteps the bug entirely.
  const splatCanvas = document.getElementById('splat-canvas');

  function openPanel(item: HTMLElement) {
    clearTimeout(closeTimer);
    if (openItem === item) return;
    if (!openItem && splatCanvas) splatCanvas.style.visibility = 'hidden';
    const previousItem = openItem;
    // Reassign before closing the previous item so its closePanel() call
    // sees openItem already pointing at the new item — otherwise the
    // "did we fully close" check below would restore canvas visibility for
    // one frame between switching from one open item straight to another.
    openItem = item;
    if (previousItem) closePanel(previousItem, true);

    item.classList.add('is-open');
    const panel = item.querySelector<HTMLElement>('.mega-navbar__panel')!;
    const children = animatedChildren(panel);

    gsap.killTweensOf([panel, ...children]);
    gsap.set(panel, { display: 'flex' });
    gsap.timeline()
      .fromTo(panel, { opacity: 0, y: -14, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.38, ease: 'power3.out' })
      .fromTo(children, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.32, ease: 'power2.out', stagger: 0.045 }, '-=0.22');
  }

  function closePanel(item: HTMLElement, immediate = false) {
    item.classList.remove('is-open');
    const wasOpenItem = openItem === item;
    if (wasOpenItem) openItem = null;
    if (wasOpenItem && splatCanvas) splatCanvas.style.visibility = '';
    const panel = item.querySelector<HTMLElement>('.mega-navbar__panel')!;
    const children = animatedChildren(panel);

    gsap.killTweensOf([panel, ...children]);
    gsap.to(panel, {
      opacity: 0,
      y: -10,
      scale: 0.97,
      duration: immediate ? 0.16 : 0.24,
      ease: 'power2.in',
      onComplete: () => gsap.set(panel, { display: 'none' }),
    });
  }

  function scheduleClose(item: HTMLElement) {
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      if (openItem === item) closePanel(item);
    }, CLOSE_DELAY_MS);
  }

  items.forEach((item) => {
    item.addEventListener('mouseenter', () => openPanel(item));
    item.addEventListener('mouseleave', () => scheduleClose(item));
    item.addEventListener('focusin', () => openPanel(item));
    item.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !item.contains(next)) scheduleClose(item);
    });
  });

  document.addEventListener('click', (e) => {
    if (openItem && !openItem.contains(e.target as Node)) {
      closePanel(openItem, true);
    }
  });

  const burger = document.getElementById('mobile-menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  burger.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('is-open');
    burger.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
  });
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-open');
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
    });
  });
</script>
