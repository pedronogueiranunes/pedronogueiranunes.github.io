---
import { comparison } from "../data/home";
import Eyebrow from "./Eyebrow.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
const comparisonIcons = ["work", "focus", "platforms", "time", "communication", "ownership", "next"];
const labels = ["Pedro Nogueira", "Generic freelancer", "Big agency"];
---

<section class="comparison page-section">
  <div class="section-heading">
    <div>
      <Eyebrow>Why teams switch</Eyebrow>
      <h2>
        Me <span>vs.</span> a generic freelancer
        <br />
        <span>vs.</span> a big agency.
      </h2>
    </div>
    <p>
      Same budget conversation, very different outcomes. Here is the honest
      version.
    </p>
  </div>
  <div
    class="comparison-table"
    role="table"
    aria-label="Working with Pedro, a freelancer or an agency"
  >
    <div class="comparison-head" role="row">
      <span role="columnheader" class="mono">
        What matters
      </span>
      {labels.map((label) => (
        <span role="columnheader" class="label">
          {label}
        </span>
      ))}
    </div>
    {comparison.map((row, i) => (
      <div class="comparison-row" role="row">
        <h3 role="rowheader">{row[0]}</h3>
        {row.slice(1).map((text, index) => (
          <div
            role="cell"
            class:list={[
              "comparison-cell",
              { "comparison-pedro": index === 0 },
            ]}
          >
            <span class="mono comparison-mobile-label">{labels[index]}</span>
            {i === 6 && index === 0 ? (
              <Button href="/contact">{text}</Button>
            ) : (
              <p>
                {index === 0 && <Icon name="check" size={20} />}
                <span>{text}</span>
              </p>
            )}
          </div>
        ))}
        <picture class="comparison-illustration" aria-hidden="true">
          <source media="(max-width: 768px)" srcset={`/assets/comparison/${comparisonIcons[i]}.webp`} />
          <img width="160" height="160" alt="" loading="lazy" decoding="async" />
        </picture>
      </div>
    ))}
  </div>
  <p class="comparison-email">
    Prefer email?{" "}
    <a href="mailto:pedronogueiranunes@gmail.com">
      pedronogueiranunes@gmail.com
    </a>
  </p>
</section>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  onPageLoad((scope) => {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const mobile = matchMedia("(max-width: 768px)");
    if (!("IntersectionObserver" in window)) return;
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || !mobile.matches) continue;
        observer.unobserve(entry.target);
        if (motion.matches) continue;
        const animation = entry.target.animate(
          [
            { opacity: 0, transform: "scale(0.94)", offset: 0 },
            { opacity: 0.35, transform: "scale(0.97)", offset: 0.45 },
            { opacity: 1, transform: "scale(1)", offset: 1 },
          ],
          { duration: 1600, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
        );
        animations.add(animation);
        animation.onfinish = () => animations.delete(animation);
      }
    }, { threshold: 0.15 });
    document.querySelectorAll(".comparison-illustration").forEach((icon) => observer.observe(icon));
    motion.addEventListener("change", () => {
      if (motion.matches) animations.forEach((animation) => animation.finish());
    }, { signal: scope.signal });
    scope.cleanup(() => {
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
    });
  });
</script>
