---
import { comparison } from "../data/home";
import Eyebrow from "./Eyebrow.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import ComparisonShade from "./ComparisonShade.astro";
import DitherIcon from "./DitherIcon.astro";
import ComparisonStrokes from "./ComparisonStrokes.astro";
const comparisonIcons = ["work", "focus", "platforms", "time", "communication", "ownership", "next"] as const;
const platforms = ["WordPress", "Webflow", "Framer", "Shopify", "React"];
const labels = ["Pedro Nogueira", "Generic freelancer", "Big agency"];
---

<section class="comparison page-section">
  <div class="section-heading">
    <div>
      <Eyebrow>Why teams switch</Eyebrow>
      <h2>
        Me <span>vs.</span> a generic freelancer
        <br />
        <span>vs.</span> a big agency.
      </h2>
    </div>
    <p>
      Same budget conversation, very different outcomes. Here is the honest
      version.
    </p>
  </div>
  <div
    class="comparison-table"
    role="table"
    aria-label="Working with Pedro, a freelancer or an agency"
  >
    <div class="comparison-head" role="row">
      <span role="columnheader" class="mono">
        What matters
      </span>
      {labels.map((label) => (
        <span role="columnheader" class="label">
          {label}
        </span>
      ))}
    </div>
    {comparison.map((row, i) => (
      <div class="comparison-row" role="row">
        <ComparisonShade />
        <div role="rowheader" class="comparison-rowhead">{row[0]}</div>
        {row.slice(1).map((text, index) => (
          <div
            role="cell"
            class:list={[
              "comparison-cell",
              { "comparison-pedro": index === 0 },
            ]}
          >
            <span class="mono comparison-mobile-label">{labels[index]}</span>
            {i === 6 && index === 0 ? (
              <Button href="/contact">{text}</Button>
            ) : i === 2 && index === 0 ? (
              <>
                <p class="comparison-platform-copy"><Icon name="check" size={20} /><span>{text}</span></p>
                <div class="comparison-platforms">
                  {platforms.map(platform => (
                    <span><img src={`/assets/logos/${platform.toLowerCase()}.svg`} width="22" height="22" alt="" loading="lazy" />{platform}</span>
                  ))}
                  <p>Picked for your team</p>
                </div>
              </>
            ) : (
              <p>
                {index === 0 && <Icon name="check" size={20} />}
                <span>{text}</span>
              </p>
            )}
          </div>
        ))}
        <div class="comparison-stage" aria-hidden="true" data-kind={comparisonIcons[i]}>
          {comparisonIcons[i] === "platforms" && <ComparisonStrokes kind="platforms" layer="back" />}
          <div class="comparison-illustration">
            <picture>
              <source media="(max-width: 768px)" srcset={`/assets/comparison/${comparisonIcons[i]}.webp`} />
              <img width="160" height="160" alt="" loading="lazy" decoding="async" />
            </picture>
            <DitherIcon />
          </div>
          <ComparisonStrokes kind={comparisonIcons[i]} />
        </div>
      </div>
    ))}
  </div>
  <p class="comparison-email">
    Prefer email?{" "}
    <a href="mailto:pedronogueiranunes@gmail.com">
      pedronogueiranunes@gmail.com
    </a>
  </p>
</section>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { initComparisonParallax } from "../scripts/comparison-parallax.js";
  onPageLoad((scope) => scope.cleanup(initComparisonParallax()));
</script>

<style>
  .comparison-platforms { display:none; }
  .comparison-stage { display:none; }
  @media (max-width:768px) {
    /* Full-bleed stage at the card's foot: the icon sits right, its line art uses the rest. */
    .comparison-stage { display:block; position:relative; width:calc(100% + 40px); height:260px; margin:4px -20px -20px; pointer-events:none; }
    .comparison-illustration { position:absolute; top:25px; right:-6px; width:210px; height:210px; }
    /* Icon motion, timed with each card's line art in ComparisonStrokes. Individual
       transform properties leave `transform` free for the scroll parallax. */
    [data-kind="work"] .comparison-illustration { animation:icon-write 7s ease-in-out infinite; }
    [data-kind="focus"] .comparison-illustration { animation:icon-hit .8s ease-out infinite; }
    [data-kind="platforms"] .comparison-illustration { animation:icon-breathe 4.5s ease-in-out infinite; }
    [data-kind="time"] .comparison-illustration { animation:icon-tick 1s ease-out infinite; }
    [data-kind="communication"] .comparison-illustration { animation:icon-talk 1s ease-out infinite; }
    [data-kind="ownership"] .comparison-illustration { animation:icon-turn 6s ease-out infinite; transform-origin:70% 25%; }
    [data-kind="next"] .comparison-illustration { animation:icon-ring 6s ease-out infinite; transform-origin:50% 20%; }
  }
  @keyframes icon-write { 0%,60%,100% { translate:0 0; } 8% { translate:-3px 2px; } 16% { translate:1px -1px; } 24% { translate:-4px 2px; } 32% { translate:0 1px; } 40% { translate:-3px -1px; } 48% { translate:1px 2px; } }
  @keyframes icon-hit { 0%,40%,100% { scale:1; } 50% { scale:.93; } 64% { scale:1.03; } }
  @keyframes icon-breathe { 50% { scale:1.04; rotate:-2deg; } }
  @keyframes icon-tick { 0%,24%,100% { rotate:0deg; } 6% { rotate:-4deg; } 14% { rotate:2deg; } }
  @keyframes icon-talk { 0%,32%,100% { scale:1; } 8% { scale:1.06 .94; } 18% { scale:.97 1.03; } }
  @keyframes icon-turn { 0%,16%,100% { rotate:0deg; } 5% { rotate:-14deg; } 11% { rotate:4deg; } }
  @keyframes icon-ring { 0%,20%,100% { rotate:0deg; } 2%,6%,14% { rotate:-6deg; } 4%,8%,16% { rotate:6deg; } 18% { rotate:-3deg; } 26% { scale:1.04; } 32% { scale:1; } }
  @media (prefers-reduced-motion:reduce) { .comparison-illustration { animation:none !important; } }
  /* Keep the icon above the looping strokes before its dither canvas is ready. */
  .comparison-illustration picture { position:relative; display:block; width:100%; height:100%; }
  @media (max-width:768px) {
    .comparison-platform-copy { display:none; }
    .comparison-platforms { display:flex; flex-wrap:wrap; gap:14px 20px; }
    .comparison-platforms > span { display:inline-flex; align-items:center; gap:8px; line-height:1.4; }
    .comparison-platforms img { flex-shrink:0; object-fit:contain; }
    .comparison-platforms > p { flex-basis:100%; margin:2px 0 0; }
  }
</style>
