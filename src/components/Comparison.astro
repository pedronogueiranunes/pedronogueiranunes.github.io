---
import { comparison } from "../data/home";
import Eyebrow from "./Eyebrow.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import ComparisonShade from "./ComparisonShade.astro";
import DitherIcon from "./DitherIcon.astro";
const comparisonIcons = ["work", "focus", "platforms", "time", "communication", "ownership", "next"];
const platforms = ["WordPress", "Webflow", "Framer", "Shopify", "React"];
const labels = ["Pedro Nogueira", "Generic freelancer", "Big agency"];
---

<section class="comparison page-section">
  <div class="section-heading">
    <div>
      <Eyebrow>Why teams switch</Eyebrow>
      <h2>
        Me <span>vs.</span> a generic freelancer
        <br />
        <span>vs.</span> a big agency.
      </h2>
    </div>
    <p>
      Same budget conversation, very different outcomes. Here is the honest
      version.
    </p>
  </div>
  <div
    class="comparison-table"
    role="table"
    aria-label="Working with Pedro, a freelancer or an agency"
  >
    <div class="comparison-head" role="row">
      <span role="columnheader" class="mono">
        What matters
      </span>
      {labels.map((label) => (
        <span role="columnheader" class="label">
          {label}
        </span>
      ))}
    </div>
    {comparison.map((row, i) => (
      <div class="comparison-row" role="row">
        <ComparisonShade />
        <h3 role="rowheader">{row[0]}</h3>
        {row.slice(1).map((text, index) => (
          <div
            role="cell"
            class:list={[
              "comparison-cell",
              { "comparison-pedro": index === 0 },
            ]}
          >
            <span class="mono comparison-mobile-label">{labels[index]}</span>
            {i === 6 && index === 0 ? (
              <Button href="/contact">{text}</Button>
            ) : i === 2 && index === 0 ? (
              <>
                <p class="comparison-platform-copy"><Icon name="check" size={20} /><span>{text}</span></p>
                <div class="comparison-platforms">
                  {platforms.map(platform => (
                    <span><img src={`/assets/logos/${platform.toLowerCase()}.svg`} width="22" height="22" alt="" loading="lazy" />{platform}</span>
                  ))}
                  <p>Picked for your team</p>
                </div>
              </>
            ) : (
              <p>
                {index === 0 && <Icon name="check" size={20} />}
                <span>{text}</span>
              </p>
            )}
          </div>
        ))}
        <div class="comparison-illustration" aria-hidden="true">
        <picture>
          <source media="(max-width: 768px)" srcset={`/assets/comparison/${comparisonIcons[i]}.webp`} />
          <img width="160" height="160" alt="" loading="lazy" decoding="async" />
        </picture>
          <DitherIcon />
        </div>
      </div>
    ))}
  </div>
  <p class="comparison-email">
    Prefer email?{" "}
    <a href="mailto:pedronogueiranunes@gmail.com">
      pedronogueiranunes@gmail.com
    </a>
  </p>
</section>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { initComparisonParallax } from "../scripts/comparison-parallax.js";
  onPageLoad((scope) => scope.cleanup(initComparisonParallax()));
</script>

<style>
  .comparison-platforms { display:none; }
  @media (max-width:768px) {
    .comparison-platform-copy { display:none; }
    .comparison-platforms { display:flex; flex-wrap:wrap; gap:14px 20px; }
    .comparison-platforms > span { display:inline-flex; align-items:center; gap:8px; line-height:1.4; }
    .comparison-platforms img { flex-shrink:0; object-fit:contain; }
    .comparison-platforms > p { flex-basis:100%; margin:2px 0 0; }
  }
</style>
