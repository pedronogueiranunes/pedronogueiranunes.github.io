---
interface Props { source?: string; invert?: boolean }
const { source, invert = false } = Astro.props;
---
<canvas class="dither-icon" data-source={source} data-invert={invert ? "true" : undefined} aria-hidden="true"></canvas>
<style is:global>
  :is(.problem-art, .comparison-illustration, .your-turn-growth, .offer-art, .promise-art, .footer-art) .dither-icon { position:absolute; max-width:none; pointer-events:none; transform: translate3d(var(--dither-x, 0px), var(--dither-y, 0px), 0) scale(var(--dither-zoom, 1)); transition: transform 240ms cubic-bezier(.16,1,.3,1); will-change: auto; }
  :is(.problem-art, .comparison-illustration, .your-turn-growth, .offer-art, .promise-art, .footer-art)[data-dither-ready] img { visibility:hidden; }
  .comparison-illustration .dither-icon, .promise-art .dither-icon, .footer-art .dither-icon { inset:0; }
  @media (max-width:768px) {
    .comparison-row .comparison-illustration { width:clamp(200px, 64vw, 240px); height:clamp(200px, 64vw, 240px); margin:36px -20px -8px auto; }
  }
  @media (prefers-reduced-motion: reduce) { :is(.problem-art, .comparison-illustration, .your-turn-growth, .offer-art, .promise-art, .footer-art) .dither-icon { transform:none; transition:none; } }
</style>
<script>
  import { onPageLoad } from '../scripts/page-lifecycle';
  onPageLoad((scope) => {
    document.querySelectorAll<HTMLCanvasElement>('.dither-icon').forEach((canvas) => {
      const art = canvas.parentElement!;
      const image = art.querySelector('img');
      const card = art.closest<HTMLElement>('.problem-card, .comparison-row, .your-turn-card, .offer-card, .promise-card, .footer-art');
      const ctx = canvas.getContext('2d');
      if (!image || !card || !ctx) return;
      const growth = art.classList.contains('your-turn-growth');
      const offer = art.classList.contains('offer-art');
      const problem = art.classList.contains('problem-art');
      const promise = art.classList.contains('promise-art');
      const footer = art.classList.contains('footer-art');
      const invert = canvas.dataset.invert === 'true';
      const detailed = art.classList.contains('comparison-illustration') || growth;
      // Fine grain keeps the 3D shapes of the problem and offer artwork readable:
      // one CSS pixel per dot instead of the coarser two-pixel texture. Only the
      // comparison and offer art also use the open-highlight tone curve; the Home
      // problem art keeps its denser ink so it does not wash out.
      const fineGrain = detailed || offer || problem || promise || footer;
      const fineTone = detailed || offer || promise || footer;
      const artwork = canvas.dataset.source ? new Image() : image;
      if (canvas.dataset.source) artwork.src = canvas.dataset.source;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const fine = matchMedia('(hover: hover) and (pointer: fine)');
      const mobile = matchMedia('(max-width: 768px)');
      const autoAnimate=()=>detailed && mobile.matches;
      const bayer = [0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
      let pixels: Uint8ClampedArray | undefined;
      // Preserve double precision: these image-derived values never change
      // between frames. Rebuild only when setup resamples the source image.
      let alphaCache: Float64Array, toneCache: Float64Array;
      let width = 0, height = 0, frame = 0, active = false, visible = true, last = 0;
      let elapsed = 0, mouseX = 0, mouseY = 0;
      let output: ImageData | undefined;
      // Fine-grain canvases are four times larger, so the animated wave is
      // computed without per-pixel trigonometry: sin(x) / cos(x) tables plus one
      // sin/cos pair per row.
      let sinX: Float32Array | undefined, cosX: Float32Array | undefined;
      const draw = (phase: number) => {
        if (!pixels) return;
        // Fine-grain canvases are four times larger, so reuse the output buffer
        // instead of allocating a fresh ImageData on every hover frame.
        if (!output || output.width !== width || output.height !== height) output = ctx.createImageData(width, height);
        else output.data.fill(0);
        for (let y=0; y<height; y++) {
          const i0 = y*width*4;
          // Row constants for the two wave terms.
          const rowSin = Math.sin(y*.05 - phase*4.4 + mouseX*2);
          const rowCos = Math.cos(y*.05 - phase*4.4 + mouseX*2);
          const rowWave = phase ? Math.cos(y*.09 - phase*3.2 + mouseY*2)*.09 : 0;
          for (let x=0; x<width; x++) {
            const i = i0 + x*4;
            const pixel = i / 4;
            const alpha = alphaCache[pixel];
            if (alpha < .04) continue;
            // Keep highlights open and shade the existing 3D contours with orange ink.
            const wave = phase ? (sinX![x]*rowCos + cosX![x]*rowSin)*.22 + rowWave : 0;
            const tone = toneCache[pixel];
            const ink = Math.max(0, Math.min(1, (tone + wave*(fineGrain ? .35 : 1))*alpha));
            if (ink > (bayer[(y%4)*4+x%4]+.5)/16) {
              output.data[i]=255; output.data[i+1]=90; output.data[i+2]=31; output.data[i+3]=255;
            }
          }
        }
        ctx.putImageData(output,0,0);
      };
      const tick = (now: number) => {
        frame=0;
        if (!active || !visible || document.hidden || reduced.matches) return;
        if (now-last>32) { elapsed += Math.min((now-last)/1000,.05); draw(elapsed); last=now; }
        frame=requestAnimationFrame(tick);
      };
      const start = () => { if (!frame && active && visible && !document.hidden && !reduced.matches) { if (!autoAnimate()) canvas.style.setProperty('--dither-zoom','1.06'); last=performance.now(); frame=requestAnimationFrame(tick); } };
      const rest = () => { canvas.style.setProperty('--dither-x','0px'); canvas.style.setProperty('--dither-y','0px'); canvas.style.setProperty('--dither-zoom','1'); cancelAnimationFrame(frame); frame=0; elapsed=0; draw(0); };
      const setup = () => {
        if (scope.signal.aborted || !artwork.naturalWidth) return;
        const style=getComputedStyle(image);
        for (const name of ['width','height','top','left','scale','transform-origin','mask-image','mask-size','mask-repeat','mask-position']) canvas.style.setProperty(name,style.getPropertyValue(name));
        if (detailed) { canvas.style.top='0px'; canvas.style.left='0px'; }
        // Fine-grain canvases use one CSS pixel per dot so the artwork's shapes
        // stay legible; anything else keeps the bolder two-pixel texture.
        const dotSize=fineGrain ? 1 : 2;
        width=Math.max(1,Math.round(parseFloat(style.width)/dotSize));
        height=Math.max(1,Math.round(parseFloat(style.height)/dotSize));
        canvas.width=width; canvas.height=height;
        sinX=new Float32Array(width); cosX=new Float32Array(width);
        for(let x=0;x<width;x++){ sinX[x]=Math.sin(x*.085); cosX[x]=Math.cos(x*.085); }
        canvas.style.imageRendering='pixelated';
        const source=document.createElement('canvas'); source.width=width; source.height=height;
        const sourceCtx=source.getContext('2d',{willReadFrequently:true});
        if (!sourceCtx) return;
        try {
          const fit=Math.min(width/artwork.naturalWidth,height/artwork.naturalHeight) * (canvas.dataset.source ? .6622 : 1);
          const fittedWidth=artwork.naturalWidth*fit, fittedHeight=artwork.naturalHeight*fit;
          // Keep the website anchored at the same upper-left origin when sizing it down.
          const sourceX=canvas.dataset.source ? width*.14 : (width-fittedWidth)/2;
          const sourceY=canvas.dataset.source ? height*.21 : (height-fittedHeight)/2;
          sourceCtx.drawImage(artwork,sourceX,sourceY,fittedWidth,fittedHeight);
          pixels=sourceCtx.getImageData(0,0,width,height).data;
          alphaCache = new Float64Array(width * height);
          toneCache = new Float64Array(width * height);
          for (let pixel = 0; pixel < width * height; pixel++) {
            const i = pixel * 4;
            alphaCache[pixel] = pixels[i+3]/255;
            const luminance = (pixels[i]*.2126 + pixels[i+1]*.7152 + pixels[i+2]*.0722)/255;
            const baseTone = growth ? .08 + luminance*2.6 : fineTone ? .5 + (.52-luminance)*1.8 : .98-luminance*.85;
            toneCache[pixel] = invert ? 1 - baseTone : baseTone;
          }
          draw(0); art.dataset.ditherReady='true';
        } catch { /* Keep the original artwork if the source cannot be sampled. */ }
      };
      image.addEventListener('load',setup,{signal:scope.signal});
      if (artwork !== image) artwork.addEventListener('load',setup,{signal:scope.signal});
      const resize=new ResizeObserver(setup); resize.observe(image);
      const observer=new IntersectionObserver(([entry])=>{ visible=entry.isIntersecting; if (autoAnimate()) active=true; if (visible) start(); else rest(); }); observer.observe(card);
      card.addEventListener('pointerenter',()=>{ if (fine.matches) {active=true;start();} },{signal:scope.signal});
      card.addEventListener('pointermove',(event)=>{
        if (!fine.matches || reduced.matches) return;
        const rect=card.getBoundingClientRect();
        mouseX=(event.clientX-rect.left)/rect.width*2-1;
        mouseY=(event.clientY-rect.top)/rect.height*2-1;
        canvas.style.setProperty('--dither-x',`${mouseX*8}px`);
        canvas.style.setProperty('--dither-y',`${mouseY*6}px`);
      },{signal:scope.signal,passive:true});
      card.addEventListener('pointerleave',()=>{active=autoAnimate();rest();start();},{signal:scope.signal});
      card.addEventListener('focusin',()=>{active=true;start();},{signal:scope.signal});
      card.addEventListener('focusout',(event)=>{if (!card.contains(event.relatedTarget as Node)) {active=autoAnimate();rest();start();}},{signal:scope.signal});
      mobile.addEventListener('change',()=>{active=autoAnimate();rest();start();},{signal:scope.signal});
      reduced.addEventListener('change',()=>{rest();start();},{signal:scope.signal});
      document.addEventListener('visibilitychange',()=>{rest();start();},{signal:scope.signal});
      setup();
      scope.cleanup(()=>{cancelAnimationFrame(frame);resize.disconnect();observer.disconnect();delete art.dataset.ditherReady;});
    });
  });
</script>
