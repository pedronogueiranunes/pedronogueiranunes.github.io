---
import { localeFromPath, languageCodes } from "../i18n/locales";
const locale = localeFromPath(Astro.url.pathname);
const { id = "preferences", inline = false } = Astro.props;
---

<div class="preferences" data-preferences>
  {!inline && (
    <button
      type="button"
      class="preferences-toggle"
      aria-expanded="false"
      aria-controls={`${id}-panel`}
      aria-label="Language and theme preferences"
    >
      <img
        src="/assets/figma/488-7974-imgIconGlobe.svg"
        width="16"
        height="16"
        alt=""
      />
      <span data-language-label>{languageCodes[locale]}</span>
      <span class="preferences-caret" aria-hidden="true"></span>
    </button>
  )}
  <div
    id={`${id}-panel`}
    class:list={["preferences-panel", { "preferences-panel--inline": inline }]}
    hidden={!inline}
  >
    <fieldset>
      <legend>Language</legend>
      {[
        ["en", "English", "EN"],
        ["pt-br", "Português", "BR"],
        ["es", "Español", "ES"],
        ["fr", "Français", "FR"],
      ].map(([code, label, short]) => (
        <label class="language-option">
          <input
            type="radio"
            name={`${id}-language`}
            value={code}
            checked={code === locale}
          />
          <span>{label}</span>
          <small>{short}</small>
        </label>
      ))}
    </fieldset>
    <fieldset>
      <legend>Theme</legend>
      <div class="theme-segments">
        {["Light", "Dark", "Auto"].map((label) => (
          <label title={label}>
            <input
              type="radio"
              name={`${id}-theme`}
              value={label.toLowerCase()}
              checked={label === "Auto"}
            />
            <span>
              <svg class="theme-icon" viewBox="0 0 8 8" width="12" height="12" aria-hidden="true">
                <path fill="currentColor" d={label === "Light"
                  ? "M3 0h2v1H3zM0 3h1v2H0zM7 3h1v2H7zM3 7h2v1H3zM2 2h4v4H2z"
                  : label === "Dark"
                    ? "M2 0h3v1H3v4h4v1H6v1H2V6H1V1h1z"
                    : "M2 0h4v1h1v1h1v4H7v1H6v1H2V7H1V6H0V2h1V1h1zm2 1v6h2V6h1V2H6V1z"} />
              </svg>
              <span class="theme-option-label">{label}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
</div>
<script>
  import { localeFromPath, localizePath, languageCodes, type Locale } from "../i18n/locales";
  import { changeTheme } from "../scripts/transitions";
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((scope) => {
  const roots = document.querySelectorAll<HTMLElement>("[data-preferences]");
  const sync = () => {
    const theme = document.documentElement.dataset.theme || "auto";
    roots.forEach((root) =>
      root
        .querySelectorAll<HTMLInputElement>(".theme-segments input")
        .forEach((input) => (input.checked = input.value === theme)),
    );
  };
  sync();
  const language = localeFromPath(location.pathname);
  roots.forEach(root => {
    root.querySelectorAll<HTMLInputElement>(".language-option input").forEach(input => input.checked = input.value === language);
    const label = root.querySelector("[data-language-label]");
    if (label) label.textContent = languageCodes[language];
  });
  roots.forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>(".preferences-toggle");
    const panel = root.querySelector<HTMLElement>(".preferences-panel")!;
    const close = (restore = false) => {
      if (!toggle) return;
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      if (restore) toggle.focus();
    };
    toggle?.addEventListener("click", () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) panel.querySelector<HTMLInputElement>("input:checked")?.focus();
    }, { signal: scope.signal });
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) close();
    }, { signal: scope.signal });
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle && !panel.hidden) {
        event.stopPropagation();
        close(true);
      }
    }, { signal: scope.signal });
    root.addEventListener("focusout", (event) => {
      // A label click may briefly focus the body before activating its radio.
      // Only a real focus destination outside the popover should dismiss it.
      if (
        event.relatedTarget instanceof Node &&
        !root.contains(event.relatedTarget)
      )
        close();
    }, { signal: scope.signal });
    root
      .querySelectorAll<HTMLInputElement>(".theme-segments input")
      .forEach((input) =>
        input.addEventListener("change", () => {
          changeTheme(input.value, input.closest("label")!, sync);
        }, { signal: scope.signal }),
      );
    root
      .querySelectorAll<HTMLInputElement>(".language-option input")
      .forEach((input) =>
        input.addEventListener("change", () => {
          const language = input.value as Locale;
          try { localStorage.setItem("language", language); } catch {}
          window.location.assign(localizePath(location.pathname + location.search + location.hash, language));
        }, { signal: scope.signal }),
      );
  });
  });
</script>
