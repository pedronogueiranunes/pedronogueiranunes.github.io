---
import Icon from "./Icon.astro";
import { needs, platforms, budgets, startDates } from "../data/contact";
import { site } from "../data/site";
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
---

<div class="contact-form-wrap">
  <form
    id="contact-form"
    class="contact-form"
    method="post"
    action="https://api.web3forms.com/submit"
    novalidate
    data-access-key={accessKey}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Portfolio project inquiry" />
    <input
      type="checkbox"
      name="botcheck"
      class="botcheck"
      tabindex="-1"
      aria-hidden="true"
    />
    <div class="form-step" data-step="1">
      <div class="form-progress-head">
        <span class="mono accent">Step 1 of 2</span>
        <span>Takes 60 seconds</span>
      </div>
      <div class="form-progress" aria-hidden="true">
        <span></span>
      </div>
      <h2 tabindex="-1">Where should I send your plan?</h2>
      {[
        ["name", "Full name", "text", "Jane Smith", "name"],
        ["company", "Company", "text", "Acme Co.", "organization"],
        ["email", "Work email", "email", "jane@company.com", "email"],
        ["website", "Your website", "text", "company.com", "url"],
      ].map(([name, label, type, placeholder, autocomplete]) => (
        <div
          class:list={[
            "form-field",
            { "form-field--half": name === "name" || name === "company" },
          ]}
        >
          <label for={`contact-${name}`}>{label}</label>
          <input
            id={`contact-${name}`}
            name={name}
            type={type === "email" ? "email" : "text"}
            placeholder={placeholder}
            autocomplete={autocomplete}
            required={name === "name" || name === "email"}
            maxlength={name === "website" ? 2048 : 200}
            aria-describedby={`${name}-error`}
          />
          <small class="field-error" id={`${name}-error`}></small>
        </div>
      ))}
      <button type="button" class="action" data-continue>
        Continue to step 2 <Icon name="arrow-right" />
      </button>
      <p class="form-reassurance">
        No spam, no contracts. I reply within 24 hours.
      </p>
    </div>
    <div class="form-step" data-step="2" hidden>
      <div class="form-progress-head">
        <span class="mono accent">Step 2 of 2</span>
        <span>Almost done</span>
      </div>
      <div class="form-progress form-progress--complete" aria-hidden="true">
        <span></span>
      </div>
      <h2 tabindex="-1">
        A bit about the project<span data-person-name></span>.
      </h2>
      <fieldset
        class="form-choices"
        data-required-group="needs"
        aria-describedby="needs-error"
      >
        <legend>
          What do you need? <span>Pick all that apply.</span>
        </legend>
        <div>
          {needs.map((label) => (
            <label class="choice-pill">
              <input type="checkbox" name="needs" value={label} />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <small id="needs-error" class="field-error"></small>
      </fieldset>
      <fieldset class="form-choices">
        <legend>Platform, if you already have one</legend>
        <div>
          {platforms.map(([label, logo]) => (
            <label class="choice-pill">
              <input type="radio" name="platform" value={label} />
              <span>
                {logo && (
                  <img
                    src={`/assets/logos/${logo}.svg`}
                    alt=""
                    width="14"
                    height="14"
                  />
                )}
                {label}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset
        class="form-choices"
        data-required-group="budget"
        aria-describedby="budget-error"
      >
        <legend>Budget range</legend>
        <div>
          {budgets.map((label) => (
            <label class="choice-pill">
              <input type="radio" name="budget" value={label} />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <small id="budget-error" class="field-error"></small>
      </fieldset>
      <fieldset
        class="form-choices"
        data-required-group="start"
        aria-describedby="start-error"
      >
        <legend>When do you want to start?</legend>
        <div>
          {startDates.map((label) => (
            <label class="choice-pill">
              <input type="radio" name="start" value={label} />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <small id="start-error" class="field-error"></small>
      </fieldset>
      <div class="form-field">
        <label for="contact-message">
          Anything else? <span>(optional)</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          placeholder="Links, goals, deadlines..."
          rows="4"
          maxlength="5000"
        ></textarea>
      </div>
      <button type="submit" class="action" data-submit>
        <span>Send and get my plan</span>
        <Icon name="arrow-right" />
      </button>
      <button type="button" class="form-back" data-back>
        <Icon name="arrow-left" /> Back
      </button>
    </div>
    <div
      class="form-status"
      role="status"
      aria-live="polite"
      tabindex="-1"
      hidden
    ></div>
    <noscript>
      <p>
        This form needs JavaScript. Email{" "}
        <a href={`mailto:${site.email}`}>{site.email}</a> to tell me about your
        project.
      </p>
    </noscript>
  </form>
  <div class="calendar-alternative">
    <span>or</span>
    {site.bookingUrl ? (
      <a href={site.bookingUrl}>
        <Icon name="chat" size={24} />
        <span>
          <strong>Rather talk now? Book a 30 minute call</strong>
          <small>Pick a time on my calendar</small>
        </span>
        <Icon name="arrow-right" />
      </a>
    ) : (
      <a href={`mailto:${site.email}?subject=Book%20a%2030%20minute%20call`}>
        <Icon name="chat" size={24} />
        <span>
          <strong>Rather talk now? Book a 30 minute call</strong>
          <small>Arrange a time by email</small>
        </span>
        <Icon name="arrow-right" />
      </a>
    )}
  </div>
</div>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
  const status = form.querySelector<HTMLElement>(".form-status")!;
  const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
  let current = 0;
  let sending = false;
  const show = (step: number) => {
    current = step;
    steps.forEach((node, i) => (node.hidden = i !== step));
    status.hidden = true;
    const name = form.elements.namedItem("name") as HTMLInputElement;
    form.querySelector("[data-person-name]")!.textContent = name.value.trim()
      ? `, ${name.value.trim().split(/\s+/)[0]}`
      : "";
    steps[step].querySelector<HTMLElement>("h2")?.focus();
  };
  const validateField = (input: HTMLInputElement) => {
    input.value = input.value.trim();
    const error = form.querySelector<HTMLElement>(`#${input.name}-error`);
    let message = "";
    if (input.required && !input.value)
      message =
        input.name === "name"
          ? "Please enter your name."
          : "Please enter your email.";
    else if (input.type === "email" && !input.validity.valid)
      message = "Please enter a valid email address.";
    else if (input.name === "website" && input.value) {
      try {
        const url = new URL(
          /^https?:\/\//i.test(input.value)
            ? input.value
            : `https://${input.value}`,
        );
        if (
          !url.hostname.includes(".") ||
          !["http:", "https:"].includes(url.protocol)
        )
          message = "Please enter a website, such as company.com.";
      } catch {
        message = "Please enter a website, such as company.com.";
      }
    }
    input.setAttribute("aria-invalid", String(!!message));
    if (error) error.textContent = message;
    return !message;
  };
  const validateFirst = () => {
    let valid = true;
    steps[0].querySelectorAll<HTMLInputElement>("input").forEach((input) => {
      if (!validateField(input)) valid = false;
    });
    return valid;
  };
  const validateGroups = () => {
    let valid = true;
    steps[1]
      .querySelectorAll<HTMLFieldSetElement>("[data-required-group]")
      .forEach((group) => {
        const checked = group.querySelector("input:checked");
        const error = group.querySelector<HTMLElement>(".field-error")!;
        error.textContent = checked ? "" : "Please select an option.";
        group.setAttribute("aria-invalid", String(!checked));
        if (!checked) valid = false;
      });
    return valid;
  };
  form.querySelector("[data-continue]")!.addEventListener("click", () => {
    if (validateFirst()) show(1);
    else steps[0].querySelector<HTMLElement>("[aria-invalid=true]")?.focus();
  });
  form.querySelector("[data-back]")!.addEventListener("click", () => show(0));
  steps[0].querySelectorAll<HTMLInputElement>("input").forEach((input) =>
    input.addEventListener("blur", () => {
      if (input.value || input.getAttribute("aria-invalid") === "true")
        validateField(input);
    }),
  );
  steps[1].querySelectorAll("input").forEach((input) =>
    input.addEventListener("change", () => {
      const group = input.closest<HTMLFieldSetElement>("[data-required-group]");
      if (group && group.getAttribute("aria-invalid") === "true") {
        group.setAttribute("aria-invalid", "false");
        group.querySelector(".field-error")!.textContent = "";
      }
    }),
  );
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    if (current === 0) {
      form.querySelector<HTMLButtonElement>("[data-continue]")!.click();
      return;
    }
    if (!validateFirst()) {
      show(0);
      steps[0].querySelector<HTMLElement>("[aria-invalid=true]")?.focus();
      return;
    }
    if (!validateGroups()) {
      steps[1].querySelector<HTMLElement>("[aria-invalid=true] input")?.focus();
      return;
    }
    const key = form.dataset.accessKey;
    const feedback = (message: string, error = true) => {
      status.textContent = message;
      status.hidden = false;
      status.dataset.error = String(error);
      status.focus();
    };
    if (!key) {
      feedback(
        "Online sending is not available yet. Please email pedronogueiranunes@gmail.com with your project details.",
      );
      return;
    }
    const data = new FormData(form);
    if (data.get("botcheck")) return;
    sending = true;
    submit.disabled = true;
    submit.querySelector("span")!.textContent = "Sending...";
    form.setAttribute("aria-busy", "true");
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 20000);
    try {
      const payload = Object.fromEntries(data);
      payload.needs = data.getAll("needs").join(", ");
      payload.access_key = key;
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      const result = await response.json();
      if (!response.ok || result.success !== true)
        throw new Error("Send failed");
      steps.forEach((step) => (step.hidden = true));
      feedback(
        "Thanks. Your message has been sent. I'll reply within 24 hours.",
        false,
      );
      form.reset();
    } catch {
      feedback(
        "Your message could not be sent. Please try again, or email pedronogueiranunes@gmail.com.",
      );
    } finally {
      clearTimeout(timeout);
      sending = false;
      submit.disabled = false;
      submit.querySelector("span")!.textContent = "Send and get my plan";
      form.removeAttribute("aria-busy");
    }
  });
  const service = new URLSearchParams(location.search).get("service");
  const selection =
    service === "CRO audit"
      ? "CRO audit"
      : service === "White-label for agencies"
        ? "White-label for my agency"
        : service === "Website design and build"
          ? "Website design + build"
          : null;
  if (selection) {
    form
      .querySelectorAll<HTMLInputElement>("[name=needs]")
      .forEach((input) => (input.checked = input.value === selection));
  }
</script>
