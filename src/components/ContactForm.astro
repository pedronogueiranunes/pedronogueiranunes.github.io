---
import StackGlyph from "./StackGlyph.astro";
import Icon from "./Icon.astro";
import {
  routes,
  needs,
  agencyNeeds,
  platforms,
  budgets,
  agencyBudgets,
  startDates,
} from "../data/contact";
import { site } from "../data/site";
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
// `data-routes` marks parts that only apply to some routes; the script hides and disables the rest.
const choiceGroups = [
  { name: "needs", id: "needs", routes: "project", legend: "What do you need?", hint: "Pick all that apply.", type: "checkbox", options: needs },
  { name: "needs", id: "agency-needs", routes: "agency", legend: "What do you need?", hint: "Pick all that apply.", type: "checkbox", options: agencyNeeds },
];
const budgetGroups = [
  { id: "budget", routes: "project", legend: "Budget range", options: budgets },
  { id: "agency-budget", routes: "agency", legend: "Budget range", options: agencyBudgets },
];
---

<div class="contact-form-wrap">
  <form
    id="contact-form"
    class="contact-form"
    method="post"
    action="https://api.web3forms.com/submit"
    novalidate
    data-access-key={accessKey}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Portfolio project inquiry" />
    <input
      type="checkbox"
      name="botcheck"
      class="botcheck"
      tabindex="-1"
      aria-hidden="true"
    />
    <div class="form-step" data-step="0">
      <div class="form-progress-head">
        <span class="mono accent">Step 1 of 3</span>
        <span>Takes 60 seconds</span>
      </div>
      <div class="form-progress" aria-hidden="true">
        <span style="width:33%"></span>
      </div>
      <h2 tabindex="-1">What brings you here?</h2>
      <fieldset
        class="form-choices"
        data-required-group="route"
        aria-describedby="route-error"
      >
        <legend class="sr-only">What brings you here?</legend>
        <div>
          {routes.map(([label, value]) => (
            <label class="choice-pill">
              <input type="radio" name="route" value={value} />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <small id="route-error" class="field-error"></small>
      </fieldset>
      <button type="button" class="action" data-continue>
        Continue <span class="form-action-icon"><Icon name="arrow-right" /></span>
      </button>
    </div>
    <div class="form-step" data-step="1" hidden>
      <div class="form-progress-head">
        <span class="mono accent">Step 2 of 3</span>
        <span>Takes 60 seconds</span>
      </div>
      <div class="form-progress" aria-hidden="true">
        <span style="width:67%"></span>
      </div>
      <h2 tabindex="-1">
        <span data-routes="project agency">Where should I send your plan?</span>
        <span data-routes="role" hidden>Where should I reply?</span>
      </h2>
      {[
        ["name", "Full name", "text", "Jane Smith", "name"],
        ["company", "Company", "text", "Acme Co.", "organization"],
        ["email", "Work email", "email", "jane@company.com", "email"],
        ["website", "Your website", "text", "company.com", "url"],
      ].map(([name, label, type, placeholder, autocomplete]) => (
        <div
          class:list={[
            "form-field",
            { "form-field--half": name === "name" || name === "company" },
          ]}
          data-routes={name === "website" ? "project agency" : undefined}
        >
          <label for={`contact-${name}`}>{label}</label>
          <input
            id={`contact-${name}`}
            name={name}
            type={type === "email" ? "email" : "text"}
            placeholder={placeholder}
            autocomplete={autocomplete}
            required={name === "name" || name === "email"}
            maxlength={name === "website" ? 2048 : 200}
            aria-describedby={`${name}-error`}
          />
          <small class="field-error" id={`${name}-error`}></small>
        </div>
      ))}
      <button type="button" class="action" data-continue>
        Continue to step 3 <span class="form-action-icon"><Icon name="arrow-right" /></span>
      </button>
      {/* TODO: confirm with Pedro before publishing (reply time) */}
      <p class="form-reassurance">
        No spam, no contracts. I reply within one business day.
      </p>
      <button type="button" class="form-back" data-back>
        <Icon name="arrow-left" /> Back
      </button>
    </div>
    <div class="form-step" data-step="2" hidden>
      <div class="form-progress-head">
        <span class="mono accent">Step 3 of 3</span>
        <span>Almost done</span>
      </div>
      <div class="form-progress form-progress--complete" aria-hidden="true">
        <span></span>
      </div>
      <h2 tabindex="-1">
        <span data-routes="project agency">A bit about the project</span><span data-routes="role" hidden>A bit about the role</span><span data-person-name></span>.
      </h2>
      {choiceGroups.map((group) => (
        <fieldset
          class="form-choices"
          data-required-group={group.id}
          data-routes={group.routes}
          aria-describedby={`${group.id}-error`}
        >
          <legend>
            {group.legend} <span>{group.hint}</span>
          </legend>
          <div>
            {group.options.map((label) => (
              <label class="choice-pill">
                <input type={group.type} name={group.name} value={label} />
                <span>{label}</span>
              </label>
            ))}
          </div>
          <small id={`${group.id}-error`} class="field-error"></small>
        </fieldset>
      ))}
      <fieldset class="form-choices" data-routes="project agency">
        <legend>Platform, if you already have one</legend>
        <div>
          {platforms.map(([label, logo]) => (
            <label class="choice-pill">
              <input type="radio" name="platform" value={label} />
              <span>
                {logo && (
                  <img
                    src={`/assets/logos/${logo}.svg`}
                    alt=""
                    width="14"
                    height="14"
                  />
                )}
                {label}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      {budgetGroups.map((group) => (
        <fieldset
          class="form-choices"
          data-required-group={group.id}
          data-routes={group.routes}
          aria-describedby={`${group.id}-error`}
        >
          <legend>{group.legend}</legend>
          <div>
            {group.options.map((label) => (
              <label class="choice-pill">
                <input type="radio" name="budget" value={label} />
                <span>{label}</span>
              </label>
            ))}
          </div>
          <small id={`${group.id}-error`} class="field-error"></small>
        </fieldset>
      ))}
      <fieldset
        class="form-choices"
        data-required-group="start"
        data-routes="project agency"
        aria-describedby="start-error"
      >
        <legend>When do you want to start?</legend>
        <div>
          {startDates.map((label) => (
            <label class="choice-pill">
              <input type="radio" name="start" value={label} />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <small id="start-error" class="field-error"></small>
      </fieldset>
      <div class="form-field" data-routes="role">
        <label for="contact-role_link">
          Link to the role <span>(optional)</span>
        </label>
        <input
          id="contact-role_link"
          name="role_link"
          type="text"
          placeholder="company.com/careers/role"
          autocomplete="url"
          maxlength="2048"
          aria-describedby="role_link-error"
        />
        <small class="field-error" id="role_link-error"></small>
      </div>
      <div class="form-field">
        <label for="contact-message">
          Anything else? <span>(optional)</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          placeholder="Links, goals, deadlines..."
          rows="4"
          maxlength="5000"
        ></textarea>
      </div>
      <p class="actions form-role-links" data-routes="role">
        {site.cvUrl ? (
          <a class="text-link" href={site.cvUrl} download>Download CV <Icon name="download" /></a>
        ) : (
          <a class="text-link" href={`mailto:${site.email}?subject=CV%20request`}>Request my CV <Icon name="arrow-right" /></a>
        )}
        {site.socials.linkedin && (
          <a class="text-link" href={site.socials.linkedin}>LinkedIn <Icon name="arrow-up-right" /></a>
        )}
      </p>
      <button type="submit" class="action" data-submit>
        <span>Send and get my plan</span>
        <span class="form-action-icon"><Icon name="arrow-right" /></span>
      </button>
      <button type="button" class="form-back" data-back>
        <Icon name="arrow-left" /> Back
      </button>
    </div>
    <div
      class="form-status"
      role="status"
      aria-live="polite"
      tabindex="-1"
      hidden
    ></div>
    <noscript>
      <p>
        This form needs JavaScript. Email{" "}
        <a href={`mailto:${site.email}`}>{site.email}</a> to tell me about your
        project.
      </p>
    </noscript>
  </form>
  <div class="calendar-alternative">
    <span>or</span>
    {site.bookingUrl ? (
      <a href={site.bookingUrl}>
        <StackGlyph name="chat" />
        <span>
          <strong>Rather talk now? Book a 30 minute call</strong>
          <small>Pick a time on my calendar</small>
        </span>
        <Icon name="arrow-right" />
      </a>
    ) : (
      <a href={`mailto:${site.email}?subject=Book%20a%2030%20minute%20call`}>
        <StackGlyph name="chat" />
        <span>
          <strong>Rather talk now? Book a 30 minute call</strong>
          <small>Arrange a time by email</small>
        </span>
        <Icon name="arrow-right" />
      </a>
    )}
  </div>
</div>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((scope) => {
    if (!document.querySelector("#contact-form")) return;

  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
  const status = form.querySelector<HTMLElement>(".form-status")!;
  const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
  const subject = form.elements.namedItem("subject") as HTMLInputElement;
  const subjects: Record<string, string> = {
    project: "Portfolio project inquiry",
    agency: "Portfolio agency inquiry",
    role: "Portfolio role inquiry",
  };
  let current = 0;
  let sending = false;
  const route = () =>
    (form.querySelector<HTMLInputElement>("[name=route]:checked")?.value) || "project";
  const submitLabel = () => (route() === "role" ? "Send message" : "Send and get my plan");
  // Hide and disable parts of other routes, so they are neither validated nor sent.
  const applyRoute = () => {
    const active = route();
    form.querySelectorAll<HTMLElement>("[data-routes]").forEach((part) => {
      const on = part.dataset.routes!.split(" ").includes(active);
      part.hidden = !on;
      part
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")
        .forEach((input) => (input.disabled = !on));
    });
    subject.value = subjects[active];
    if (!sending) submit.querySelector("span")!.textContent = submitLabel();
  };
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const stepAnimations = new Set<Animation>();
  const stopStepAnimations = () => {stepAnimations.forEach(animation => animation.cancel());stepAnimations.clear();};
  reducedMotion.addEventListener('change', () => {if(reducedMotion.matches)stopStepAnimations();}, {signal:scope.signal});
  scope.cleanup(stopStepAnimations);
  const show = (step: number) => {
    stopStepAnimations();
    current = step;
    steps.forEach((node, i) => (node.hidden = i !== step));
    status.hidden = true;
    const name = form.elements.namedItem("name") as HTMLInputElement;
    form.querySelector("[data-person-name]")!.textContent = name.value.trim()
      ? `, ${name.value.trim().split(/\s+/)[0]}`
      : "";
    steps[step].querySelector<HTMLElement>("h2")?.focus();
    if (!reducedMotion.matches) {
      [...steps[step].children].filter((element) => element instanceof HTMLElement && !element.hidden && element.getClientRects().length).forEach((element,index) => {
        const animation=element.animate([
          {opacity:0,transform:'translateY(10px)'},
          {opacity:1,transform:'translateY(0)'},
        ], {duration:320,delay:Math.min(index*40,240),easing:'cubic-bezier(.22,1,.36,1)',fill:'backwards'});
        stepAnimations.add(animation);
        const remove=()=>stepAnimations.delete(animation);
        animation.onfinish=remove;animation.oncancel=remove;
      });
    }
  };
  const validateField = (input: HTMLInputElement) => {
    input.value = input.value.trim();
    const error = form.querySelector<HTMLElement>(`#${input.name}-error`);
    let message = "";
    if (input.required && !input.value)
      message =
        input.name === "name"
          ? "Please enter your name."
          : "Please enter your email.";
    else if (input.type === "email" && !input.validity.valid)
      message = "Please enter a valid email address.";
    else if ((input.name === "website" || input.name === "role_link") && input.value) {
      try {
        const url = new URL(
          /^https?:\/\//i.test(input.value)
            ? input.value
            : `https://${input.value}`,
        );
        if (
          !url.hostname.includes(".") ||
          !["http:", "https:"].includes(url.protocol)
        )
          message = "Please enter a website, such as company.com.";
      } catch {
        message = "Please enter a website, such as company.com.";
      }
    }
    input.setAttribute("aria-invalid", String(!!message));
    if (error) error.textContent = message;
    return !message;
  };
  const textInputs = (step: number) =>
    [...steps[step].querySelectorAll<HTMLInputElement>(".form-field input")].filter(
      (input) => !input.disabled,
    );
  const validateGroups = (step: number) => {
    let valid = true;
    steps[step]
      .querySelectorAll<HTMLFieldSetElement>("[data-required-group]")
      .forEach((group) => {
        if (group.hidden) return;
        const checked = group.querySelector("input:checked");
        const error = group.querySelector<HTMLElement>(".field-error")!;
        error.textContent = checked ? "" : "Please select an option.";
        group.setAttribute("aria-invalid", String(!checked));
        if (!checked) valid = false;
      });
    return valid;
  };
  // Returns the first invalid control of a step, or null when the step is valid.
  const validateStep = (step: number) => {
    let valid = true;
    textInputs(step).forEach((input) => {
      if (!validateField(input)) valid = false;
    });
    if (!validateGroups(step)) valid = false;
    return valid
      ? null
      : steps[step].querySelector<HTMLElement>(
          ".form-field input[aria-invalid=true]:not(:disabled), [aria-invalid=true]:not([hidden]) input",
        );
  };
  const advance = () => {
    const invalid = validateStep(current);
    if (invalid) invalid.focus();
    else show(current + 1);
  };
  form.querySelectorAll("[data-continue]").forEach((button) =>
    button.addEventListener("click", advance, { signal: scope.signal }),
  );
  form.querySelectorAll("[data-back]").forEach((button) =>
    button.addEventListener("click", () => show(current - 1), { signal: scope.signal }),
  );
  form.querySelectorAll<HTMLInputElement>(".form-field input").forEach((input) =>
    input.addEventListener("blur", () => {
      if (input.value || input.getAttribute("aria-invalid") === "true")
        validateField(input);
    }, { signal: scope.signal }),
  );
  form.querySelectorAll<HTMLInputElement>(".form-choices input").forEach((input) =>
    input.addEventListener("change", () => {
      if (input.name === "route") applyRoute();
      const group = input.closest<HTMLFieldSetElement>("[data-required-group]");
      if (group && group.getAttribute("aria-invalid") === "true") {
        group.setAttribute("aria-invalid", "false");
        group.querySelector(".field-error")!.textContent = "";
      }
    }, { signal: scope.signal }),
  );
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    if (current < steps.length - 1) {
      advance();
      return;
    }
    for (let step = 0; step < steps.length; step++) {
      const invalid = validateStep(step);
      if (invalid) {
        if (step !== current) show(step);
        invalid.focus();
        return;
      }
    }
    const key = form.dataset.accessKey;
    const feedback = (message: string, error = true) => {
      status.textContent = message;
      status.hidden = false;
      status.dataset.error = String(error);
      status.focus();
    };
    if (!key) {
      feedback(
        "Online sending is not available yet. Please email pedronogueiranunes@gmail.com with your project details.",
      );
      return;
    }
    const data = new FormData(form);
    if (data.get("botcheck")) return;
    sending = true;
    submit.disabled = true;
    submit.querySelector("span")!.textContent = "Sending...";
    form.setAttribute("aria-busy", "true");
    const controller = new AbortController();
    const timeout = scope.timeout(() => controller.abort(), 20000);
    scope.signal.addEventListener("abort", () => {
      clearTimeout(timeout);
      controller.abort();
    }, { once: true });
    try {
      const payload = Object.fromEntries(data);
      if (data.has("needs")) payload.needs = data.getAll("needs").join(", ");
      payload.access_key = key;
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      const result = await response.json();
      if (!response.ok || result.success !== true)
        throw new Error("Send failed");
      steps.forEach((step) => (step.hidden = true));
      // TODO: confirm with Pedro before publishing (reply time)
      feedback(
        "Thanks. Your message has been sent. I'll reply within one business day.",
        false,
      );
      form.reset();
    } catch {
      if (scope.signal.aborted) return;
      feedback(
        "Your message could not be sent. Please try again, or email pedronogueiranunes@gmail.com.",
      );
    } finally {
      clearTimeout(timeout);
      sending = false;
      submit.disabled = false;
      submit.querySelector("span")!.textContent = submitLabel();
      form.removeAttribute("aria-busy");
    }
  }, { signal: scope.signal });
  // Deep links: ?route=agency|role|project and ?service=<offer title>.
  const params = new URLSearchParams(location.search);
  const serviceNeeds: Record<string, string[]> = {
    "Website design and build": ["Website design + build"],
    "Brand identity and design systems": ["Brand identity", "Design system"],
    "CRO audit and redesign": ["CRO audit or redesign"],
  };
  const selection = serviceNeeds[params.get("service") ?? ""];
  const requested = params.get("route") ?? (selection ? "project" : "");
  const routeInput = form.querySelector<HTMLInputElement>(
    `[name=route][value="${CSS.escape(requested)}"]`,
  );
  if (routeInput) routeInput.checked = true;
  applyRoute();
  if (selection) {
    form
      .querySelectorAll<HTMLInputElement>("[data-routes=project] [name=needs]")
      .forEach((input) => (input.checked = selection.includes(input.value)));
  }
  });
</script>
