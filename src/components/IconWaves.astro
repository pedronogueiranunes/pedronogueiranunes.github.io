<canvas class="icon-waves" aria-hidden="true"></canvas>
<style is:global>
  :is(.problem-card, .your-turn-card, .offer-card) > .icon-waves { position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; border-radius:inherit; }
  .your-turn-card > .icon-waves { z-index:1; }
  @media (prefers-reduced-motion:reduce) { .icon-waves { display:none; } }
</style>
<script>
  import { onPageLoad } from '../scripts/page-lifecycle';
  onPageLoad((scope)=>{
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    const hover=matchMedia('(hover: hover) and (pointer: fine)');
    document.querySelectorAll<HTMLCanvasElement>('.icon-waves').forEach((canvas)=>{
      const card=canvas.parentElement!;
      const offer=card.classList.contains('offer-card');
      const growth=card.classList.contains('your-turn-card');
      const mobile=matchMedia('(max-width:768px)');
      const autoAnimate=()=>growth && mobile.matches;
      const icon=card.querySelector<HTMLCanvasElement>('.dither-icon');
      // The offer orbit follows the original image box: it is laid out before the
      // dither canvas replaces the artwork.
      const art=offer ? card.querySelector<HTMLImageElement>('.offer-art img') ?? icon : icon;
      const ctx=canvas.getContext('2d');
      if(!ctx || !icon || !art) return;
      let maskX=0,maskY=0,maskRadius=0;
      let width=0,height=0,x=0,y=0,radius=0,frame=0,last=0,elapsed=0,visible=false,active=false;
      // Offer cards get a dotted orbit around the icon, echoing the shoulder
      // ring on the 3D portrait; the other cards keep the expanding rings.
      let intensity=0,orbitX=0,orbitY=0,orbitRX=0,orbitRY=0;
      const ORBIT_DOTS=84;
      const ORBIT_SPEED=0.45; // rad/s
      const ORBIT_TILT=-24*Math.PI/180; // Saturn-style incline
      const ORBIT_INK='#FF5A1F';
      // Silhouette of the dithered icon: the back half of the ring passes
      // behind the artwork instead of painting over it.
      let iconMask:Uint8Array|null=null, iconMaskW=0, iconMaskH=0;
      let iconLeft=0, iconTop=0, iconWidth=0, iconHeight=0;
      const measure=()=>{
        const bounds=card.getBoundingClientRect(), artBounds=art.getBoundingClientRect();
        width=card.clientWidth;height=card.clientHeight;
        const ratio=Math.min(devicePixelRatio||1,2);
        canvas.width=Math.round(width*ratio);canvas.height=Math.round(height*ratio);
        ctx.setTransform(ratio,0,0,ratio,0,0);
        x=artBounds.left-bounds.left+artBounds.width*.5;
        y=artBounds.top-bounds.top+artBounds.height*.5;
        if(offer){
          // Inclined ellipse: dots travel around the icon like a ring around a
          // planet, slightly past the artwork on every side.
          orbitX=x;orbitY=y+artBounds.height*.02;
          orbitRX=artBounds.width*.75;orbitRY=artBounds.width*.55;
          iconLeft=artBounds.left-bounds.left;
          iconTop=artBounds.top-bounds.top;
          iconWidth=artBounds.width;iconHeight=artBounds.height;
          iconMask=null;
        }
        if(growth){
          const orbit=card.querySelector('.your-turn-orbit')?.getBoundingClientRect();
          if(orbit){maskX=orbit.left-bounds.left+orbit.width/2;maskY=orbit.top-bounds.top+orbit.height/2;maskRadius=orbit.width/2;}
        }
        radius=Math.max(Math.hypot(x,y),Math.hypot(width-x,y),Math.hypot(x,height-y),Math.hypot(width-x,height-y));
      };
      const buildMask=()=>{
        if(!offer || iconMask || !art.hasAttribute('data-dither-ready')) return;
        try{
          iconMaskW=icon.width;iconMaskH=icon.height;
          if(!iconMaskW || !iconMaskH) return;
          const data=icon.getContext('2d')!.getImageData(0,0,iconMaskW,iconMaskH).data;
          const base=new Uint8Array(iconMaskW*iconMaskH);
          for(let i=0;i<base.length;i++) if(data[i*4+3]>40) base[i]=1;
          const mask=new Uint8Array(base.length);
          // Grow the silhouette so back dots do not peek through the dither gaps.
          for(let y2=0;y2<iconMaskH;y2++) for(let x2=0;x2<iconMaskW;x2++){
            if(!base[y2*iconMaskW+x2]) continue;
            for(let dy=-2;dy<=2;dy++) for(let dx=-2;dx<=2;dx++){
              const nx=x2+dx, ny=y2+dy;
              if(nx>=0 && ny>=0 && nx<iconMaskW && ny<iconMaskH) mask[ny*iconMaskW+nx]=1;
            }
          }
          iconMask=mask;
        }catch{iconMask=null;}
      };
      const insideIcon=(px:number,py:number)=>{
        if(!iconMask || !iconWidth || !iconHeight) return false;
        const mx=Math.round((px-iconLeft)/iconWidth*iconMaskW);
        const my=Math.round((py-iconTop)/iconHeight*iconMaskH);
        if(mx<0||my<0||mx>=iconMaskW||my>=iconMaskH) return false;
        return iconMask[my*iconMaskW+mx]===1;
      };
      const drawOrbit=(alpha:number)=>{
        buildMask();
        const cosT=Math.cos(ORBIT_TILT), sinT=Math.sin(ORBIT_TILT);
        ctx.fillStyle=ORBIT_INK;
        for(let i=0;i<ORBIT_DOTS;i++){
          const angle=elapsed*ORBIT_SPEED+(i/ORBIT_DOTS)*Math.PI*2;
          const ex=Math.cos(angle)*orbitRX, ey=Math.sin(angle)*orbitRY;
          const depth=Math.sin(angle); // 1 = front of the orbit, -1 = behind the icon
          const px=orbitX+ex*cosT-ey*sinT;
          const py=orbitY+ex*sinT+ey*cosT;
          // The back half of the ring hides behind the artwork.
          if(depth<0 && insideIcon(px,py)) continue;
          const size=2.4+Math.max(0,depth)*1.8;
          ctx.globalAlpha=alpha*(.35+.5*((depth+1)/2));
          ctx.fillRect(px-size/2,py-size/2,size,size);
        }
        ctx.globalAlpha=1;
      };
      const drawRings=()=>{
        ctx.save();
        if(growth){ctx.beginPath();ctx.arc(maskX,maskY,maskRadius,0,Math.PI*2);ctx.clip();}
        ctx.strokeStyle=growth ? '#FFE1CF' : '#FF5A1F';ctx.lineWidth=1.25;
        // Sparse dots echo the icon texture, with much less visual weight.
        ctx.setLineDash([2,3]);ctx.lineCap='round';
        for(let i=0;i<3;i++){
          const progress=(elapsed/8+i/3)%1;
          const fadeIn=Math.min(1,progress/.07);
          ctx.globalAlpha=.6*fadeIn*Math.pow(1-progress,1.35);
          ctx.beginPath();ctx.arc(x,y,12+progress*radius,0,Math.PI*2);ctx.stroke();
        }
        ctx.restore();
        ctx.globalAlpha=1;
      };
      const tick=(now:number)=>{
        frame=0;
        if(!visible || reduced.matches || document.hidden) return;
        if(now-last>=33){
          const dt=Math.min((now-last)/1000,.1);elapsed+=dt;last=now;
          ctx.clearRect(0,0,width,height);
          if(offer){
            const target=active ? 1 : 0;
            intensity+=(target-intensity)*Math.min(1,dt/.18);
            if(intensity<.02 && !active){intensity=0;return;}
            drawOrbit(intensity);
          } else {
            if(!active) return;
            drawRings();
          }
        }
        frame=requestAnimationFrame(tick);
      };
      const stop=()=>{cancelAnimationFrame(frame);frame=0;intensity=0;ctx.clearRect(0,0,width,height);};
      const start=()=>{if(!frame && visible && !reduced.matches && !document.hidden && (active || intensity>.01)){last=performance.now();frame=requestAnimationFrame(tick);}};
      const resize=new ResizeObserver(measure);resize.observe(card);resize.observe(art);
      const observer=new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(autoAnimate()) active=true;if(visible){measure();start();}else stop();});observer.observe(card);
      card.addEventListener('pointerenter',()=>{
        if (!hover.matches) return;
        active=true;elapsed=0;measure();buildMask();start();
      },{signal:scope.signal});
      card.addEventListener('pointerleave',()=>{
        active=autoAnimate();
        if(offer) start(); else {stop();start();}
      },{signal:scope.signal});
      hover.addEventListener('change',()=>{active=autoAnimate();stop();start();},{signal:scope.signal});
      mobile.addEventListener('change',()=>{active=autoAnimate();stop();start();},{signal:scope.signal});
      reduced.addEventListener('change',()=>{stop();start();},{signal:scope.signal});
      document.addEventListener('visibilitychange',()=>{stop();start();},{signal:scope.signal});
      scope.cleanup(()=>{stop();resize.disconnect();observer.disconnect();});
      measure();
    });
  });
</script>
