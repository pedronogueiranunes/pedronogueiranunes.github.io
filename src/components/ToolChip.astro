---
import Icon from "./Icon.astro";
interface Props {
  label: string;
  logo?: string;
  icon?: string;
  size?: "s" | "m";
}
const { label, logo, icon, size = "s" } = Astro.props;
---

<span class:list={["tool-chip", `tool-chip--${size}`]}>
  {icon && <Icon name={icon} size={size === "s" ? 14 : 16} />}
  {!icon && logo && (
    <img
      src={`/assets/logos/${logo}.svg`}
      width={size === "s" ? 12 : 16}
      height={size === "s" ? 12 : 16}
      alt=""
      loading="lazy"
    />
  )}
  {label}
</span>
