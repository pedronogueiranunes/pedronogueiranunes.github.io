<canvas class="blueprint-pixels" aria-hidden="true"></canvas>
<style is:global>
.services-page .deliverables-section { position: relative; overflow: hidden; isolation: isolate; }
.services-page .deliverables-section > div { position: relative; z-index: 1; }
.services-page .deliverables-section .blueprint-pixels { position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; }
</style>
<script>
import { onPageLoad } from "../scripts/page-lifecycle";
const BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
onPageLoad((scope)=>{
  document.querySelectorAll<HTMLCanvasElement>(".blueprint-pixels").forEach(canvas=>{
    const section=canvas.closest<HTMLElement>(".deliverables-section");
    const ctx=canvas.getContext("2d");
    if(!section||!ctx)return;
    const reduced=matchMedia("(prefers-reduced-motion: reduce)");
    let w=0,h=0,frame=0,last=0,time=0,visible=false;
    const draw=()=>{
      if(!w||!h)return;
      ctx.clearRect(0,0,w,h);
      const cell=12, cols=Math.ceil(w/cell), rows=Math.ceil(h/cell);
      const phase=reduced.matches?0.5:(time%12)/12;
      // The leading edge travels across the section, then recedes into ordered pixels.
      const reveal=reduced.matches?0.85:0.42 + 0.58 * Math.min(1,phase*2.6);
      const dissolve=reduced.matches?0:Math.max(0,Math.min(.65,(phase-.64)/.46));
      const ink=getComputedStyle(section).getPropertyValue("--green").trim()||"#52634f";
      ctx.fillStyle=ink;
      for(let y=0;y<rows;y++)for(let x=0;x<cols;x++){
        const u=x/cols,v=y/rows;
        const structure=(x%7===0||y%7===0||((x+y*3)%19===0));
        if(!structure||u>reveal)continue;
        const threshold=(BAYER[(y%4)*4+x%4]+.5)/16;
        if(threshold<dissolve)continue;
        const fade=Math.max(0.3,1-u*.5) * Math.min(1, Math.max(0, (v - 0.12) / 0.7));
        ctx.globalAlpha=fade*(structure&&x%7===0&&y%7===0 ? .25 : .14);
        const size=x%7===0&&y%7===0?4:3;
        ctx.fillRect(x*cell,y*cell,size,size);
      }
      ctx.globalAlpha=1;
    };
    const shouldRun=()=>visible&&!document.hidden&&!reduced.matches&&w>0&&h>0;
    const tick=(now:number)=>{frame=0;if(!shouldRun())return;if(!last)last=now;if(now-last>=50){time+=Math.min(now-last,100)/1000;last=now;draw();}frame=requestAnimationFrame(tick);};
    const start=()=>{if(!frame&&shouldRun()){last=0;frame=requestAnimationFrame(tick);}};
    const stop=()=>{if(frame)cancelAnimationFrame(frame);frame=0;last=0;};
    const resize=()=>{w=section.clientWidth;h=section.clientHeight;const dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.max(1,Math.round(w*dpr));canvas.height=Math.max(1,Math.round(h*dpr));ctx.setTransform(dpr,0,0,dpr,0,0);draw();};
    const io=new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(visible)start();else stop();},{threshold:0.05});io.observe(section);
    const ro=new ResizeObserver(resize);ro.observe(section);
    reduced.addEventListener("change",()=>{stop();draw();start();},{signal:scope.signal});
    document.addEventListener("visibilitychange",()=>document.hidden?stop():start(),{signal:scope.signal});
    scope.cleanup(()=>{stop();io.disconnect();ro.disconnect();});
    resize();
  });
});
</script>
