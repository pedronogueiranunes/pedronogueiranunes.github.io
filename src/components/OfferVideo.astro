---
interface Props { name: string }
const { name } = Astro.props;
const root = `/assets/service-icons/${name}`;
---
<div class="offer-dither-video" aria-hidden="true">
  <span class="offer-icon-glow">
    <span></span><span></span><span></span>
  </span>
  <img src={`${root}-poster.png`} width="220" height="220" loading="lazy" alt="" />
  <video data-hover-src={`${root}-dither.webm`} muted playsinline loop preload="none" disablepictureinpicture></video>
</div>
<style is:global>
  .offer-dither-video { position:absolute; width:220px; height:220px; left:-8px; top:0; pointer-events:none; transform-origin:center; transition:transform 320ms cubic-bezier(.22,1,.36,1); }
  .services-page .offer-art .offer-dither-video :is(img,video) { position:absolute; inset:0; width:100%; height:100%; max-width:100%; object-fit:contain; transform:none; image-rendering:pixelated; }
  .services-page .offer-card:is(:hover,:focus-within) .offer-art .offer-dither-video img { transform:none; }
  .offer-dither-video::before {
    content:"";
    position:absolute;
    left:0;
    top:194px;
    width:204px;
    height:38px;
    background:url('/assets/service-icons/service-ground-shadow.svg') center / contain no-repeat;
  }
  @media (hover:hover) and (pointer:fine) {
    .offer-card:hover .offer-dither-video::before { opacity:0; }
  }
  .offer-icon-glow {
    position:absolute;
    inset:-49px -82px -54px -38px;
    isolation:isolate;
    opacity:0;
    transition:opacity 280ms ease;
  }
  .offer-icon-glow::before {
    content:"";
    position:absolute;
    inset:7% -12% -18% 9%;
    mask-image:linear-gradient(to right, #000 64%, transparent 99%);
    background:
      radial-gradient(ellipse at 39% 36%, rgb(255 90 31 / .24), transparent 61%),
      radial-gradient(ellipse at 71% 56%, rgb(255 90 31 / .14), transparent 60%);
  }
  .offer-icon-glow > span {
    position:absolute;
    inset:9% 13% 17% 9%;
    background:
      url('/assets/service-icons/service-icon-glow.svg') center / contain no-repeat,
      radial-gradient(ellipse, rgb(255 99 38 / .72), rgb(255 90 31 / .28) 46%, transparent 72%);
    transform:translate(var(--start-x), var(--start-y));
    animation:offer-nebula-drift var(--duration) ease-in-out var(--delay) infinite paused;
  }
  .offer-icon-glow > span:nth-child(1) {
    --start-x:-32px; --start-y:-24px; --end-x:29px; --end-y:27px;
    --duration:9.8s; --mid-x:-16px; --mid-y:20px; --delay:-1s;
  }
  .offer-icon-glow > span:nth-child(2) {
    --start-x:45px; --start-y:-22px; --end-x:-37px; --end-y:18px;
    --duration:12.2s; --mid-x:22px; --mid-y:-46px; --delay:-3s;
  }
  .offer-icon-glow > span:nth-child(3) {
    --start-x:4px; --start-y:44px; --end-x:37px; --end-y:-38px;
    --duration:11.4s; --mid-x:-35px; --mid-y:-26px; --delay:-2s;
  }
  @keyframes offer-nebula-drift {
    0%, 100% { transform:translate(var(--start-x), var(--start-y)) scale(.96); opacity:.78; }
    34% { transform:translate(var(--mid-x), var(--mid-y)) scale(1.14); opacity:1; }
    68% { transform:translate(var(--end-x), var(--end-y)) scale(1.04); opacity:.86; }
  }
  @media (hover:hover) and (pointer:fine) {
    .offer-card:hover .offer-icon-glow { opacity:.86; }
    .offer-card:hover .offer-dither-video :is(img,video) { filter:url(#offer-warm) brightness(.92); }
    .offer-card:hover .offer-icon-glow > span { animation-play-state:running; }
  }
  .offer-card:has(:focus-visible) .offer-icon-glow { opacity:.86; }
  .offer-card:has(:focus-visible) .offer-dither-video :is(img,video) { filter:url(#offer-warm) brightness(.92); }
  .offer-card:has(:focus-visible) .offer-icon-glow > span { animation-play-state:running; }
  @media (prefers-reduced-motion:reduce) {
    .offer-icon-glow { transition:none; }
    .offer-icon-glow > span { animation:none; }
  }
  .offer-dither-video video { opacity:0; }
  .offer-dither-video[data-playing] video { opacity:1; }
  .offer-dither-video[data-playing] img { visibility:hidden; }
  @media (hover:hover) and (pointer:fine) {
    .offer-card:hover .offer-dither-video { transform:scale(1.04) translateY(-2px); }
  }
  .offer-card:focus-within .offer-dither-video { transform:scale(1.04) translateY(-2px); }
  @media (max-width:768px) { .offer-dither-video { left:0; } }
  @media (prefers-reduced-motion:reduce) { .offer-dither-video { transition:none; } .offer-card:is(:hover,:focus-within) .offer-dither-video { transform:none; } }
</style>
<script>
  import '../scripts/hover-icon-videos';
</script>
