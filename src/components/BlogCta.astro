---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";

interface Props {
  title: string;
  body: string;
  label: string;
  href: string;
}
const { title, body, label, href } = Astro.props;
---

<!-- One primary action per page: the topic-matched contact route. -->
<aside class="blog-cta" aria-label="Work with me">
  <div>
    <Eyebrow>Work with me</Eyebrow>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <div class="blog-cta__actions">
    <Button href={href}>{label}</Button>
    <a class="text-link" href="/projects">See the work</a>
  </div>
</aside>
