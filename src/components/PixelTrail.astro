---
interface Props {
  tone?: 'orange' | 'green';
  world?: boolean;
  /** Selector inside the section the world pulse spreads from (defaults to Bahia on the map). */
  worldOrigin?: string;
}
const { tone = 'orange', world = false, worldOrigin } = Astro.props;
---
<div class:list={["pixel-trail", { "pixel-trail--green": tone === 'green' }]} data-tone={tone} data-world={world ? '' : undefined} data-world-origin={worldOrigin} aria-hidden="true">
  <canvas class="pixel-trail__rest"></canvas>
  {world && <canvas class="pixel-trail__world"></canvas>}
  <canvas class="pixel-trail__trail"></canvas>
</div>

<style>
  .pixel-trail { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .pixel-trail canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  /* The map only covers its own band and renders at 1x: square dots stay crisp and
     the per-frame upload is a fraction of a full-resolution canvas. */
  .pixel-trail canvas.pixel-trail__world { bottom: auto; height: 88%; image-rendering: pixelated; }
  .pixel-trail--green { inset: auto; top: calc(-1 * var(--opening-nav-height, var(--projects-nav-space, 103px))); left: 50%; transform: translateX(-50%); width: 100vw; height: calc(100% + var(--opening-nav-height, var(--projects-nav-space, 103px))); z-index: -1; mask-image: linear-gradient(#000 0%, #000 55%, transparent 100%); }
  @media (hover: none), (prefers-reduced-motion: reduce) { .pixel-trail { display: none; } }
</style>

<script>
  import { onPageLoad } from '../scripts/page-lifecycle';
  import { WORLD_COLS, WORLD_ROWS, WORLD_LAND } from '../data/world-land';
  const worldBits = Uint8Array.from(atob(WORLD_LAND), (c) => c.charCodeAt(0));
  const isLand = (u: number, v: number) => {
    if (u < 0 || v < 0 || u >= 1 || v >= 1) return false;
    const i = Math.floor(v * WORLD_ROWS) * WORLD_COLS + Math.floor(u * WORLD_COLS);
    return (worldBits[i >> 3] >> (7 - (i & 7))) & 1;
  };
  onPageLoad((scope) => {
    document.querySelectorAll<HTMLElement>('.pixel-trail').forEach((root) => {
    const panel = root?.parentElement;
    const hero = panel?.closest<HTMLElement>('.home-hero') || panel;
    // Resting dots live on their own canvas, painted once per resize. Only the
    // short-lived trail repaints per frame, so an idle pointer costs nothing and
    // an active one no longer rebuilds the whole dot grid on every frame.
    const rest = root?.querySelector<HTMLCanvasElement>('.pixel-trail__rest');
    const trail = root?.querySelector<HTMLCanvasElement>('.pixel-trail__trail');
    const restCtx = rest?.getContext('2d');
    const ctx = trail?.getContext('2d');
    if (!root || !panel || !hero || !rest || !trail || !restCtx || !ctx) return;
    const media = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    const color = root.dataset.tone === 'green' ? '#BDD4B5' : '#FF5A1F';
    const lettering = panel.querySelector<HTMLElement>('.hero-lettering');
    // Pixelify Sans uses a 0.1em square for each pixel in its glyphs.
    let pixelSize = 8;
    let step = 28;
    let offset = step / 2;

    // Ripples sent out by taps on the category glyph: rings of dots that grow and fade.
    const waves: { x: number; y: number; at: number }[] = [];
    const WAVE_MS = 1400, WAVE_SPEED = 0.55, WAVE_BAND = 46;
    const cells = new Map<string, { x: number; y: number; at: number; strength: number }>();
    let width = 0, height = 0, frame = 0, visible = true;
    let previous: { x: number; y: number } | undefined;
    // Latest pointer sample; applied once per animation frame instead of on every
    // pointermove (high-rate mice otherwise force a layout read per event).
    let pending: { x: number; y: number } | undefined;
    const stop = () => { cancelAnimationFrame(frame); frame = 0; cells.clear(); waves.length = 0; previous = undefined; pending = undefined; };
    // World mode: land dots pulse in round rings spreading from Bahia (lon -39 lands
    // at ~39% of the width on a full -180..180 map), or from an origin element.
    const world = root.dataset.world !== undefined;
    const HOME = { u: (180 - 39) / 360, v: (80 + 12) / 138 };
    let land: { x: number; y: number; d: number }[] = [];
    let worldFrame = 0, worldLast = 0;
    const worldCanvas = root.querySelector<HTMLCanvasElement>('.pixel-trail__world');
    const worldCtx = worldCanvas?.getContext('2d');
    // Theme ink, cached and refreshed when the theme flips (reading styles every frame forces style work).
    let ink = color;
    const readInk = () => { ink = getComputedStyle(document.documentElement).getPropertyValue('--projects-control-ink').trim() || color; };
    const BUCKETS = 10;
    const paintWorld = (now: number) => {
      if (!worldCtx || !worldCanvas || !land.length) return;
      worldCtx.clearRect(0, 0, worldCanvas.width, worldCanvas.height);
      worldCtx.fillStyle = ink;
      // Dots are grouped into a few pulse levels, so each frame is ~10 fills instead of one per dot.
      const groups: { x: number; y: number }[][] = Array.from({ length: BUCKETS }, () => []);
      for (const dot of land) {
        // ponytail: one cosine wave over distance from home; tune period (3600ms) and wavelength (d * 9) here.
        const pulse = Math.pow(0.5 + 0.5 * Math.cos(dot.d * 9 - now / 3600 * Math.PI * 2), 2);
        groups[Math.min(BUCKETS - 1, Math.floor(pulse * BUCKETS))].push(dot);
      }
      groups.forEach((dots, level) => {
        if (!dots.length) return;
        const pulse = (level + 0.5) / BUCKETS;
        // Crest dots grow to the hover trail's pixel size.
        const size = 2.5 + pulse * (pixelSize - 2.5);
        worldCtx.globalAlpha = 0.0475 + pulse * 0.0684;
        worldCtx.beginPath();
        for (const dot of dots) worldCtx.rect(dot.x - size / 2, dot.y - size / 2, size, size);
        worldCtx.fill();
      });
      worldCtx.globalAlpha = 1;
    };
    const paintRest = () => {
      restCtx.clearRect(0, 0, width, height);
      restCtx.fillStyle = color;
      restCtx.globalAlpha = 0.055;
      // Sparse, quiet resting marks keep the field lighter than the content.
      for (let x = offset; x < width; x += step) for (let y = offset; y < height; y += step) {
        if ((Math.floor(x / step) * 7 + Math.floor(y / step) * 11) % 5 === 0) continue;
        if (world && land.length && isLand(x / width, y / (height * 0.88))) continue;
        restCtx.fillRect(x, y, 2, 2);
      }
      restCtx.globalAlpha = 1;
    };
    const buildLand = () => {
      land = [];
      if (!world || !worldCanvas) return;
      const mapHeight = height * 0.88;
      worldCanvas.width = Math.round(width);
      worldCanvas.height = Math.round(mapHeight);
      readInk();
      let ox = HOME.u * width, oy = HOME.v * mapHeight;
      const originEl = root.dataset.worldOrigin ? panel.querySelector(root.dataset.worldOrigin) : null;
      if (originEl) {
        const box = originEl.getBoundingClientRect(), base = root.getBoundingClientRect();
        ox = box.left + box.width / 2 - base.left;
        oy = box.top + box.height / 2 - base.top;
      }
      for (let x = offset; x < width; x += step) for (let y = offset; y < mapHeight; y += step) {
        if (isLand(x / width, y / mapHeight)) land.push({ x, y, d: Math.hypot(x - ox, y - oy) / mapHeight });
      }
    };
    const worldMotion = matchMedia('(prefers-reduced-motion: no-preference)');
    const worldTick = (now: number) => {
      worldFrame = requestAnimationFrame(worldTick);
      // ponytail: ~20fps is plenty for a slow pulse and keeps the hero cheap.
      if (now - worldLast < 50 || !visible || document.hidden) return;
      worldLast = now;
      paintWorld(now);
    };
    const startWorld = () => { if (world && worldMotion.matches && !worldFrame) worldFrame = requestAnimationFrame(worldTick); };
    const stopWorld = () => { cancelAnimationFrame(worldFrame); worldFrame = 0; };
    const stamp = (point: { x: number; y: number }, rect: DOMRect, now: number) => {
      const local = { x: point.x - rect.left, y: point.y - rect.top };
      if (local.x < 0 || local.y < 0 || local.x > width || local.y > height) { previous = undefined; return; }
      const start = previous || local;
      const count = Math.min(32, Math.max(1, Math.ceil(Math.hypot(local.x - start.x, local.y - start.y) / (step / 2))));
      for (let i = 1; i <= count; i++) {
        const px = start.x + (local.x - start.x) * i / count;
        const py = start.y + (local.y - start.y) * i / count;
        const col = Math.round((px - offset) / step), row = Math.round((py - offset) / step);
        for (let dx = -2; dx <= 2; dx++) for (let dy = -2; dy <= 2; dy++) {
          const distance = Math.hypot(dx, dy);
          const x = (col + dx) * step + offset, y = (row + dy) * step + offset;
          if (distance > 2.3 || x < 0 || y < 0 || x > width || y > height || ((col + dx) * 7 + (row + dy) * 11) % 5 === 0) continue;
          cells.set(`${col + dx}:${row + dy}`, { x, y, at: now, strength: (lettering ? 0.14 : 0.42) * (1 - distance / 3) });
        }
      }
      previous = local;
    };
    const paint = (now: number) => {
      frame = 0;
      if (!media.matches || !visible || document.hidden) { ctx.clearRect(0, 0, width, height); return; }
      if (pending) {
        const point = pending;
        pending = undefined;
        stamp(point, trail.getBoundingClientRect(), now);
      }
      ctx.clearRect(0, 0, width, height);
      if (!cells.size && !waves.length) return;
      ctx.fillStyle = color;
      for (let i = waves.length - 1; i >= 0; i--) {
        const wave = waves[i];
        const age = now - wave.at;
        if (age >= WAVE_MS) { waves.splice(i, 1); continue; }
        const radius = age * WAVE_SPEED, fade = 1 - age / WAVE_MS;
        // ponytail: scans only the ring's bounding box of grid cells; fine for a few waves at once.
        const c0 = Math.max(0, Math.floor((wave.x - radius - WAVE_BAND - offset) / step));
        const c1 = Math.ceil((wave.x + radius + WAVE_BAND - offset) / step);
        const r0 = Math.max(0, Math.floor((wave.y - radius - WAVE_BAND - offset) / step));
        const r1 = Math.ceil((wave.y + radius + WAVE_BAND - offset) / step);
        for (let col = c0; col <= c1; col++) for (let row = r0; row <= r1; row++) {
          if ((col * 7 + row * 11) % 5 === 0) continue;
          const x = col * step + offset, y = row * step + offset;
          if (x > width || y > height) continue;
          const crest = 1 - Math.abs(Math.hypot(x - wave.x, y - wave.y) - radius) / WAVE_BAND;
          if (crest <= 0) continue;
          const size = 2 + (pixelSize - 2) * crest;
          ctx.globalAlpha = 0.5 * crest * fade * fade;
          ctx.fillRect(x - size / 2, y - size / 2, size, size);
        }
      }
      for (const [key, cell] of cells) {
        const life = 1 - (now - cell.at) / 1050;
        if (life <= 0) { cells.delete(key); continue; }
        ctx.globalAlpha = cell.strength * life * life;
        ctx.fillRect(cell.x - pixelSize / 2, cell.y - pixelSize / 2, pixelSize, pixelSize);
      }
      ctx.globalAlpha = 1;
      if (cells.size || waves.length) frame = requestAnimationFrame(paint);
    };
    const requestPaint = () => { if (!frame) frame = requestAnimationFrame(paint); };
    const resize = new ResizeObserver(() => {
      const rect = root.getBoundingClientRect();
      width = rect.width; height = rect.height;
      pixelSize = lettering ? parseFloat(getComputedStyle(lettering).fontSize) / 10 : 8;
      step = lettering ? pixelSize : 28;
      offset = step / 2;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      rest.width = Math.round(width * ratio); rest.height = Math.round(height * ratio);
      restCtx.setTransform(ratio, 0, 0, ratio, 0, 0);
      trail.width = Math.round(width * ratio); trail.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      cells.clear(); previous = undefined; pending = undefined;
      buildLand();
      paintRest();
      paintWorld(performance.now());
      requestPaint();
    });
    resize.observe(panel);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) { stop(); stopWorld(); } else { requestPaint(); startWorld(); }
    });
    observer.observe(hero);
    hero.addEventListener('pointermove', (event) => {
      if (!media.matches || !visible || event.pointerType !== 'mouse') return;
      pending = { x: event.clientX, y: event.clientY };
      requestPaint();
    }, { signal: scope.signal, passive: true });
    hero.addEventListener('pointerdown', (event) => {
      if (!media.matches || !visible || !(event.target as Element).closest?.('[data-category-glyph]')) return;
      const rect = trail.getBoundingClientRect();
      waves.push({ x: event.clientX - rect.left, y: event.clientY - rect.top, at: performance.now() });
      requestPaint();
    }, { signal: scope.signal, passive: true });
    hero.addEventListener('pointerleave', () => { previous = undefined; pending = undefined; }, { signal: scope.signal });
    document.addEventListener('visibilitychange', () => { stop(); requestPaint(); }, { signal: scope.signal });
    media.addEventListener('change', () => { stop(); requestPaint(); }, { signal: scope.signal });
    if (world) {
      const themeObserver = new MutationObserver(() => { readInk(); paintWorld(performance.now()); });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      const scheme = matchMedia('(prefers-color-scheme: dark)');
      scheme.addEventListener('change', () => { readInk(); paintWorld(performance.now()); }, { signal: scope.signal });
      scope.cleanup(() => themeObserver.disconnect());
    }
    scope.cleanup(() => { stop(); stopWorld(); resize.disconnect(); observer.disconnect(); });
    });
  });
</script>
