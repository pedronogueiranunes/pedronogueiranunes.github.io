---
import "../styles/footer-email.css";
import LogoModel from "./LogoModel.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import FooterCtaZoom from "./FooterCtaZoom.astro";
import { site } from "../data/site";
const platforms = [
  ["wordpress", "WordPress"],
  ["webflow", "Webflow"],
  ["framer", "Framer"],
  ["shopify", "Shopify Hydrogen"],
  ["react", "React / Next.js"],
  ["claude", "AI-assisted builds"],
];
---

<footer class="site-footer" transition:name="site-footer" transition:persist="site-footer" transition:animate="none">
  <div class="footer-cta">
    <div class="footer-cta-copy">
      <h2>
        A better website, built with a global perspective.
      </h2>
      <p>
        I'm a designer and developer working with teams across the US, Canada and Germany. Let's build a site that connects with your audience.
      </p>
      <div class="actions">
        <Button href="/contact">Book a call</Button>
        <a class="text-link footer-email" href="mailto:pedronogueiranunes@gmail.com">
          Send an email <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <div class="footer-cta-slot" aria-hidden="true">
      <FooterCtaZoom />
    </div>
  </div>
  <div class="footer-columns">
    <div class="footer-bio">
      <a class="footer-logo" href="/" aria-label="Pedro Nogueira home">
        <LogoModel layers={12} step={1.6} />
      </a>
      <p>
        Senior web designer and developer. WordPress, Webflow, Framer, Shopify
        and React. 12+ years, clients in the US, Canada and Germany.
      </p>
      <p class="footer-location"><svg class="footer-flag" viewBox="0 0 20 14" aria-hidden="true" shape-rendering="crispEdges"><path fill="#26844b" d="M0 0h20v14H0z"/><path fill="#f9d63f" d="M10 2 18 7 10 12 2 7z"/><path fill="#24569a" d="M8 5h4v1h1v2h-1v1H8V8H7V6h1z"/><path fill="#fff" d="M7 6h6v1H7z"/></svg><span>Based on Vitória da Conquista, BR</span></p>
      <span class="availability" hidden>{site.availability}</span>
    </div>
    <div>
      <h4>Platforms</h4>
      {platforms.map(([logo, label]) => (
        <a href="/services#stacks">
          <img
            src={`/assets/logos/${logo}.svg`}
            width="14"
            height="14"
            alt=""
            loading="lazy"
          />
          {label}
        </a>
      ))}
    </div>
    <div>
      <h4>Services</h4>
      {[
        "CRO audits",
        "Website redesign",
        "White-label dev",
        "Headless commerce",
        "CMS setup",
        "Care plans",
      ].map((label) => (
        <a href="/services">{label}</a>
      ))}
    </div>
    <div>
      <h4>Company</h4>
      <a href="/projects">Work</a>
      <a href="/about">About</a>
      {site.blogEnabled && <a href="/thoughts">Thoughts</a>}
      <a href="/about#skills">Uses &amp; Stack</a>
    </div>
    <div>
      <h4>Contact</h4>
      <a href="mailto:pedronogueiranunes@gmail.com">
        pedronogueiranunes@gmail.com
      </a>
      <a href={site.socials.linkedin}>LinkedIn</a>
      <a href={site.socials.dribbble}>Dribbble</a>
      <a href={site.socials.vimeo}>Vimeo</a>
      <a href={site.socials.youtube}>YouTube</a>
    </div>
  </div>
  <div class="footer-legal mono">
    <span>© 2026 PEDRO JOSÉ NOGUEIRA NUNES</span>
    <span class="legal-items">
      <button type="button" data-open-legal="legal-notice" aria-haspopup="dialog" aria-controls="legal-notice">Legal</button>
      <button type="button" data-open-legal="privacy-notice" aria-haspopup="dialog" aria-controls="privacy-notice">Privacy</button>
      <button type="button" data-open-cookies aria-haspopup="dialog">Cookie choices</button>
    </span>
  </div>
  <div class="footer-lettering" aria-hidden="true">
    <div class="footer-lettering-track">
      <span>Pedro&nbsp;Nogueira&nbsp;is&nbsp;superfluid&nbsp;+&nbsp;</span>
      <span>Pedro&nbsp;Nogueira&nbsp;is&nbsp;superfluid&nbsp;+&nbsp;</span>
    </div>
  </div>
</footer>

<script>
import { onPageLoad } from '../scripts/page-lifecycle';
onPageLoad(scope => {
 const footer=document.querySelector<HTMLElement>('.site-footer');
 const model=footer?.querySelector<HTMLElement>('.footer-logo .site-logo__model');
 if(!footer||!model)return;
 const motion=matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
 let frame=0, x=0, y=0;
 const reset=()=>{cancelAnimationFrame(frame);frame=0;model.style.setProperty('--logo-tilt-x','0deg');model.style.setProperty('--logo-tilt-y','0deg');};
 footer.addEventListener('pointermove', event=>{
  if(!motion.matches||event.pointerType!=='mouse')return;
  x=event.clientX;y=event.clientY;
  if(frame)return;
  frame=requestAnimationFrame(()=>{
   frame=0;const box=model.getBoundingClientRect();const dx=x-box.left-box.width/2,dy=y-box.top-box.height/2;
   const strength=Math.max(0,1-Math.hypot(dx,dy)/420);
   model.style.setProperty('--logo-tilt-x',`${(-Math.max(-1,Math.min(1,dy/100))*4*strength).toFixed(2)}deg`);
   model.style.setProperty('--logo-tilt-y',`${(Math.max(-1,Math.min(1,dx/100))*5*strength).toFixed(2)}deg`);
  });
 }, {passive:true,signal:scope.signal});
 footer.addEventListener('pointerleave',reset,{signal:scope.signal});
 window.addEventListener('blur',reset,{signal:scope.signal});
 motion.addEventListener('change',reset,{signal:scope.signal});
 scope.cleanup(reset);
});
</script>
