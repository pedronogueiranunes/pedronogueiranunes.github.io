---
// Looping dithered line art for each mobile comparison card, drawn across the whole
// card stage and timed with the icon's own motion (see Comparison.astro).
// Coordinates are pixels of a 335 x 260 stage anchored to the card's bottom right.
// The icon box sits at x 131..341, y 25..235.
type Kind = "work" | "focus" | "platforms" | "time" | "communication" | "ownership" | "next";
interface Props { kind: Kind; layer?: "back" | "front" }
const { kind, layer = "front" } = Astro.props;

const arc = (cx: number, cy: number, r: number, from: number, to: number) => {
  const p = (a: number) => [cx + r * Math.cos((a * Math.PI) / 180), cy - r * Math.sin((a * Math.PI) / 180)].map((n) => n.toFixed(1)).join(" ");
  return `M${p(from)} A${r} ${r} 0 0 0 ${p(to)}`;
};
const cursor = "M0 0L0 22L6 17L10 26L14 24L10 15L17 15Z";
const bubble = "M0 7a7 7 0 0 1 7-7h34a7 7 0 0 1 7 7v14a7 7 0 0 1-7 7H18l-9 7v-7H7a7 7 0 0 1-7-7z M10 10h26 M10 17h16";
const folder = "M0 5a3 3 0 0 1 3-3h10l4 5h19a3 3 0 0 1 3 3v19a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3z";
const file = "M0 0h19l9 9v27H0z M19 0v9h9 M6 17h16 M6 24h16";
const px = (n: number) => `${n}px`;
---

{kind === "platforms" ? (
  // A ring of cubes circles the puzzle like Saturn's ring. Two copies share one timeline:
  // the back copy sits under the icon, the front copy over it, so cubes pass behind and in front.
  <div class:list={["orbit", `orbit--${layer}`]} aria-hidden="true">
    <div class="orbit__tilt">
      <div class="orbit__ring">
        {Array.from({ length: 6 }, (_, i) => (
          <div class="orbit__item" style={`--angle:${i * 60}deg;--phase:${-(i * 60 / 360) * 9}s`}>
            <div class="cube" style={`--spin:${-i * 1.1}s`}>
              {["front", "back", "left", "right", "top", "bottom"].map((face) => <span class={`cube__face cube__face--${face}`} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
) : (
  <svg class:list={["strokes", `strokes--${kind}`]} viewBox="0 0 335 260" aria-hidden="true" focusable="false">
    {kind === "work" && (
      // The pencil tip sketches a whole page layout across the card.
      <path class="draw" pathLength="100" d="M162 203H16V44H124V192 M16 68H124 M26 56h4 M36 56h4 M28 88h60 M28 102h40 M28 124h34v34h-34z M74 124h38 M74 138h28 M74 152h34 M28 180h40" />
    )}
    {kind === "focus" && (
      // Cursors head for the bullseye; each hit sends a ripple across the card.
      <>
        {[[0, 24], [0, 150], [40, 236]].map(([x, y], i) => (
          <>
            <circle class="ripple" style={`--i:${i}`} cx="234" cy="128" r="40" />
            <g class="aim" style={`--i:${i};--x0:${px(x)};--y0:${px(y)}`}><path d={cursor} /></g>
          </>
        ))}
      </>
    )}
    {kind === "time" && (
      // Speed lines stream out behind the stopwatch, with rings ticking round its left side.
      <>
        <path class="dial" d={arc(228, 143, 112, 112, 248)} />
        <path class="orbit-arc" pathLength="100" d={arc(228, 143, 112, 112, 248)} />
        <path class="orbit-arc orbit-arc--mid" pathLength="100" d={arc(228, 143, 136, 122, 238)} />
        <path class="orbit-arc orbit-arc--outer" pathLength="100" d={arc(228, 143, 160, 132, 228)} />
        {[[36, 1.3], [62, 1.8], [222, 1.1], [246, 1.6]].map(([y, s], i) => (
          <path class="streak" style={`--s:${s}s;--i:${i}`} d={`M150 ${y}H-20`} />
        ))}
      </>
    )}
    {kind === "communication" && (
      // A message leaves the bubbles every beat and drifts into place across the card.
      [[10, 12], [72, 62], [12, 114], [74, 166], [14, 214]].map(([x, y], i) => (
        <g class="say" style={`--i:${i};--x:${px(x)};--y:${px(y)}`}><path d={bubble} /></g>
      ))
    )}
    {kind === "ownership" && (
      // Each turn of the key hands over the files and folders, one by one.
      [[folder, 12, 22], [file, 70, 14], [file, 16, 96], [folder, 66, 92], [file, 22, 172], [file, 76, 168]].map(([d, x, y], i) => (
        <g class="hand" style={`--i:${i};--x:${px(x as number)};--y:${px(y as number)}`}><path d={d as string} /></g>
      ))
    )}
    {kind === "next" && (
      // The calendar rings, then a video call opens out of it.
      <>
        <path class="ring" d={arc(236, 130, 116, 128, 158)} />
        <path class="ring ring--outer" d={arc(236, 130, 134, 126, 160)} />
        <path class="ring" d={arc(236, 130, 116, 22, 52)} />
        <path class="ring ring--outer" d={arc(236, 130, 134, 20, 54)} />
        <g class="call">
          <rect x="0" y="0" width="116" height="84" rx="9" />
          <path d="M0 16h116" />
          <circle class="call__live" cx="10" cy="8" r="2.5" />
          <circle cx="20" cy="8" r="2.5" />
          <circle cx="40" cy="42" r="10" />
          <path d="M22 84a18 15 0 0 1 36 0" />
          {[64, 71, 78].map((x, i) => <path class="talk" style={`--i:${i}`} d={`M${x} 36v12`} />)}
          <rect class="call__self" x="82" y="56" width="26" height="20" rx="3" />
        </g>
      </>
    )}
  </svg>
)}

<style>
  .strokes, .orbit {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 335px;
    height: 260px;
    pointer-events: none;
    /* Ordered 4x4 dither (10 of 16 pixels) so the lines match the dithered icons and shade. */
    -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%224%22%20height%3D%224%22%20shape-rendering%3D%22crispEdges%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3C/svg%3E") 0 0 / 4px 4px repeat;
    mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%224%22%20height%3D%224%22%20shape-rendering%3D%22crispEdges%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3C/svg%3E") 0 0 / 4px 4px repeat;
  }
  .strokes {
    overflow: visible;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 4.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .strokes * { transform-box: fill-box; transform-origin: center; }

  /* Work: the page sketch (icon writes along, see Comparison.astro). */
  .draw { stroke-dasharray: 100; animation: draw 7s cubic-bezier(.45, 0, .3, 1) infinite; }
  @keyframes draw {
    0% { stroke-dashoffset: 100; opacity: 1; }
    60% { stroke-dashoffset: 0; opacity: 1; }
    82% { stroke-dashoffset: 0; opacity: 1; }
    92%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  /* Focus: three cursors 0.8s apart; each lands at 50% of its 2.4s run. */
  .aim, .ripple { animation: 2.4s infinite; animation-delay: calc(var(--i) * -0.8s); }
  .aim { animation-name: aim; animation-timing-function: cubic-bezier(.5, 0, .8, .6); opacity: 0; }
  @keyframes aim {
    0% { transform: translate(var(--x0), var(--y0)); opacity: 0; }
    12% { opacity: 1; }
    50% { transform: translate(218px, 112px) scale(1); opacity: 1; }
    58%, 100% { transform: translate(222px, 116px) scale(.4); opacity: 0; }
  }
  .ripple { animation-name: ripple; animation-timing-function: cubic-bezier(.2, .7, .3, 1); vector-effect: non-scaling-stroke; opacity: 0; }
  @keyframes ripple {
    0%, 50% { transform: scale(1); opacity: 0; }
    52% { opacity: .9; }
    100% { transform: scale(4.4); opacity: 0; }
  }

  /* Time */
  .dial { stroke-dasharray: 2 12; stroke-width: 3; opacity: .8; }
  .orbit-arc { stroke-dasharray: 14 10; animation: travel 3s linear infinite; }
  .orbit-arc--mid { stroke-dasharray: 6 9; animation-duration: 4.5s; animation-direction: reverse; }
  .orbit-arc--outer { stroke-dasharray: 20 26; animation-duration: 6s; }
  @keyframes travel { to { stroke-dashoffset: -48; } }
  .streak { stroke-dasharray: 46 230; stroke-dashoffset: 0; animation: streak var(--s) linear infinite; animation-delay: calc(var(--i) * -0.37s); }
  @keyframes streak { to { stroke-dashoffset: -276; } }

  /* Communication: five messages, one per second (the icon squashes on each). */
  .say { opacity: 0; animation: say 5s cubic-bezier(.2, .8, .2, 1) infinite; animation-delay: calc(var(--i) * -1s); }
  @keyframes say {
    0% { transform: translate(180px, 86px) scale(.3); opacity: 0; }
    4% { opacity: 1; }
    18% { transform: translate(var(--x), var(--y)) scale(1); }
    70% { transform: translate(var(--x), calc(var(--y) - 6px)) scale(1); opacity: 1; }
    82%, 100% { transform: translate(var(--x), calc(var(--y) - 10px)) scale(.85); opacity: 0; }
  }

  /* Ownership: the key turns at 0%, then the files leave it in turn. */
  .hand { opacity: 0; animation: hand 6s cubic-bezier(.2, .8, .2, 1) infinite backwards; animation-delay: calc(.25s + var(--i) * .3s); }
  @keyframes hand {
    0% { transform: translate(170px, 186px) scale(.2) rotate(-30deg); opacity: 0; }
    5% { opacity: 1; }
    16% { transform: translate(var(--x), var(--y)) scale(1.08) rotate(0); }
    20% { transform: translate(var(--x), var(--y)) scale(1); }
    78% { transform: translate(var(--x), var(--y)) scale(1); opacity: 1; }
    88%, 100% { transform: translate(var(--x), var(--y)) scale(.9); opacity: 0; }
  }

  /* Next: rings for the first 22%, then the call window opens. */
  .ring { opacity: 0; animation: ring 6s ease-out infinite; }
  .ring--outer { animation-delay: .15s; }
  @keyframes ring {
    0%, 2% { opacity: 0; }
    4%, 8% { opacity: 1; }
    10%, 12% { opacity: 0; }
    14%, 18% { opacity: 1; }
    22%, 100% { opacity: 0; }
  }
  .call { animation: call 6s cubic-bezier(.2, .8, .2, 1) infinite; }
  @keyframes call {
    0%, 22% { transform: translate(180px, 100px) scale(.2); opacity: 0; }
    26% { opacity: 1; }
    34% { transform: translate(6px, 62px) scale(1.04); }
    38%, 84% { transform: translate(6px, 62px) scale(1); opacity: 1; }
    94%, 100% { transform: translate(180px, 100px) scale(.2); opacity: 0; }
  }
  .call__live { fill: var(--accent-ink); animation: blink 1.2s steps(2, jump-none) infinite; }
  .call__self { animation: blink 3s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .talk { transform-origin: center; animation: talk .5s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -.17s); }
  @keyframes talk { from { transform: scaleY(.3); } to { transform: scaleY(1); } }

  /* Platforms: 3D ring of cubes around the puzzle centre (236, 130). */
  .orbit { --duration: 9s; --radius: 150px; perspective: 600px; perspective-origin: 236px 130px; }
  .orbit__tilt, .orbit__ring { position: absolute; transform-style: preserve-3d; }
  .orbit__tilt { inset: 0; transform-origin: 236px 130px; transform: rotateZ(-12deg) rotateX(-22deg); }
  .orbit__ring { left: 236px; top: 130px; width: 0; height: 0; animation: spin var(--duration) linear infinite; }
  @keyframes spin { to { transform: rotateY(360deg); } }
  .orbit__item {
    position: absolute;
    left: 0;
    top: 0;
    transform-style: preserve-3d;
    transform: rotateY(var(--angle)) translateZ(var(--radius)) translate(-50%, -50%);
    animation: var(--side) var(--duration) linear infinite;
    animation-delay: var(--phase);
  }
  /* Local time 0 is the near point of the ring; 25%..75% is the far half. */
  .orbit--front .orbit__item { --side: near; }
  .orbit--back .orbit__item { --side: far; }
  @keyframes near { 0%, 24.9% { opacity: 1; } 25%, 74.9% { opacity: 0; } 75%, 100% { opacity: 1; } }
  @keyframes far { 0%, 24.9% { opacity: 0; } 25%, 74.9% { opacity: .45; } 75%, 100% { opacity: 0; } }
  .cube { --size: 30px; position: relative; width: var(--size); height: var(--size); transform-style: preserve-3d; animation: tumble 6s linear infinite; animation-delay: var(--spin); }
  .cube__face { position: absolute; inset: 0; border: 3.6px solid var(--accent-ink); border-radius: 3px; }
  .cube__face--front { transform: translateZ(calc(var(--size) / 2)); }
  .cube__face--back { transform: rotateY(180deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--left { transform: rotateY(-90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--right { transform: rotateY(90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--top { transform: rotateX(90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--bottom { transform: rotateX(-90deg) translateZ(calc(var(--size) / 2)); }
  @keyframes tumble { to { transform: rotateX(360deg) rotateY(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .strokes *, .orbit * { animation: none !important; }
    .say, .hand { opacity: 1; transform: translate(var(--x), var(--y)); }
    .call { opacity: 1; transform: translate(6px, 62px); }
    .draw { stroke-dashoffset: 0; }
    .aim, .ripple, .ring, .streak { display: none; }
    .orbit--back { display: none; }
  }
</style>
