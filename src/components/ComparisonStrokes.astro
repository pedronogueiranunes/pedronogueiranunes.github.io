---
// Looping dithered line art beside each comparison icon (mobile only, like the icons).
// One motif per row, in the same order as the comparison data.
// Coordinates are pixels of the 240px illustration box. Every motif stays in the free
// space around its icon (left column, top band, empty corners) and inside the card,
// so nothing passes behind the icon or gets cut by the card edge.
type Kind = "work" | "focus" | "platforms" | "time" | "communication" | "ownership" | "next";
interface Props { kind: Kind }
const { kind } = Astro.props;

// 3D orbits live in the left column; `y` stacks the items into a spiral.
const orbit = {
  focus: { duration: 10, radius: 38, cx: -42, cy: 112, tilt: -10, items: Array.from({ length: 7 }, (_, i) => ({ angle: i * 103, y: (i - 3) * 26, shape: i % 5 })) },
  platforms: { duration: 9, radius: 40, cx: -46, cy: 128, tilt: -18, items: Array.from({ length: 4 }, (_, i) => ({ angle: i * 90, y: (i % 2 ? -1 : 1) * 16, shape: 0 })) },
}[kind as "focus" | "platforms"];
// The frame both layers share, in box pixels: x -110..240, y -50..250.
const frame = { x: -110, y: -50, w: 350, h: 300 };

// Small web components for the focus spiral: button, card, input, toggle, image.
const components = [
  { w: 40, h: 18, d: '<rect x="2" y="2" width="36" height="14" rx="7"/>' },
  { w: 34, h: 28, d: '<rect x="2" y="2" width="30" height="24" rx="4"/><path d="M8 10h14M8 17h18"/>' },
  { w: 44, h: 16, d: '<rect x="2" y="2" width="40" height="12" rx="3"/><path d="M8 5v6"/>' },
  { w: 30, h: 18, d: '<rect x="2" y="2" width="26" height="14" rx="7"/><circle cx="10" cy="9" r="3.5"/>' },
  { w: 32, h: 26, d: '<rect x="2" y="2" width="28" height="22" rx="3"/><path d="M5 21l8-8 6 6 4-3 5 4"/>' },
];
const bubble = "M0 7a7 7 0 0 1 7-7h34a7 7 0 0 1 7 7v14a7 7 0 0 1-7 7H18l-9 7v-7H7a7 7 0 0 1-7-7z M10 10h26 M10 17h16";
const folder = "M0 5a3 3 0 0 1 3-3h10l4 5h19a3 3 0 0 1 3 3v19a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3z";
const file = "M0 0h19l9 9v27H0z M19 0v9h9 M6 17h16 M6 24h16";
// Arc of a circle centred on the stopwatch, from `from` to `to` degrees (0 = right, counter-clockwise).
const arc = (r: number, from: number, to: number) => {
  const p = (a: number) => [120 + r * Math.cos((a * Math.PI) / 180), 124 - r * Math.sin((a * Math.PI) / 180)].map((n) => n.toFixed(1)).join(" ");
  return `M${p(from)} A${r} ${r} 0 0 0 ${p(to)}`;
};
const frameStyle = `left:${(frame.x / 240) * 100}%;top:${(frame.y / 240) * 100}%;width:${(frame.w / 240) * 100}%;height:${(frame.h / 240) * 100}%`;
---

{orbit ? (
  <div class="orbit" aria-hidden="true" style={`${frameStyle};--duration:${orbit.duration}s;--radius:${orbit.radius}px;--tilt:${orbit.tilt}deg;--cx:${((orbit.cx - frame.x) / frame.w) * 100}%;--cy:${((orbit.cy - frame.y) / frame.h) * 100}%`}>
    <div class="orbit__tilt">
      <div class="orbit__ring">
        {orbit.items.map((item) => (
          <div class="orbit__item" style={`--angle:${item.angle}deg;--y:${item.y}px;--phase:${-((item.angle % 360) / 360) * orbit.duration}s`}>
            {kind === "focus" ? (
              <svg class="orbit__shape" width={components[item.shape].w} height={components[item.shape].h} viewBox={`0 0 ${components[item.shape].w} ${components[item.shape].h}`} set:html={components[item.shape].d} />
            ) : (
              <div class="cube" style={`--spin:${-item.angle / 40}s`}>
                {["front", "back", "left", "right", "top", "bottom"].map((face) => <span class={`cube__face cube__face--${face}`} />)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
) : (
  <svg class:list={["strokes", `strokes--${kind}`]} style={frameStyle} viewBox={`${frame.x} ${frame.y} ${frame.w} ${frame.h}`} aria-hidden="true" focusable="false">
    {kind === "work" && (
      // Ink leaves the pencil tip and runs left across the whole card.
      <path class="draw" pathLength="100" d="M40 212c-8 7-18-5-28 1s-18 9-28 2-18-8-28 0-18 8-28 1-18-7-28 0-16 6-26 0" />
    )}
    {kind === "time" && (
      // Rings around the stopwatch, kept to the free left side.
      <>
        <path class="dial" d={arc(116, 118, 242)} />
        <path class="orbit-arc" pathLength="100" d={arc(116, 118, 242)} />
        <path class="orbit-arc orbit-arc--mid" pathLength="100" d={arc(138, 126, 234)} />
        <path class="orbit-arc orbit-arc--outer" pathLength="100" d={arc(160, 136, 224)} />
      </>
    )}
    {kind === "communication" && (
      // Chat windows pop up and fade around the bubbles.
      [[-88, 8], [-30, -26], [-80, 104], [-36, 60], [-62, 184], [36, 190]].map(([x, y], i) => (
        <g transform={`translate(${x} ${y})`}><path class="pop" style={`--i:${i}`} d={bubble} /></g>
      ))
    )}
    {kind === "ownership" && (
      // Folders and files show up next to the key: everything is yours.
      [[folder, -86, 40], [file, -30, -22], [file, 26, 30], [file, 40, 84], [folder, -72, 140], [file, 168, 182]].map(([d, x, y], i) => (
        <g transform={`translate(${x} ${y})`}><path class="pop" style={`--i:${i}`} d={d as string} /></g>
      ))
    )}
    {kind === "next" && (
      // A video call window opens next to the calendar.
      <g transform="translate(-92 70) scale(.86)">
        <g class="call">
          <rect x="0" y="0" width="108" height="76" rx="9" />
          <path d="M0 16h108" />
          <circle class="call__live" cx="10" cy="8" r="2.5" />
          <circle cx="20" cy="8" r="2.5" />
          <circle cx="42" cy="40" r="10" />
          <path d="M24 76a18 15 0 0 1 36 0" />
          <rect class="call__self" x="72" y="48" width="28" height="20" rx="3" />
        </g>
      </g>
    )}
  </svg>
)}

<style>
  .strokes, .orbit {
    position: absolute;
    pointer-events: none;
    /* Ordered 4x4 dither (10 of 16 pixels) so the lines match the dithered icons and shade. */
    -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%224%22%20height%3D%224%22%20shape-rendering%3D%22crispEdges%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3C/svg%3E") 0 0 / 4px 4px repeat;
    mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%224%22%20height%3D%224%22%20shape-rendering%3D%22crispEdges%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%222%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%221%22%20height%3D%221%22/%3E%3C/svg%3E") 0 0 / 4px 4px repeat;
  }
  .strokes {
    overflow: visible;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 4.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .strokes * { transform-box: fill-box; transform-origin: center; }

  /* Pencil ink */
  .draw { stroke-dasharray: 100; animation: draw 4.2s cubic-bezier(.5, 0, .3, 1) infinite; }
  @keyframes draw {
    0% { stroke-dashoffset: 100; opacity: 1; }
    60% { stroke-dashoffset: 0; opacity: 1; }
    85%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  /* Stopwatch rings: dashes travel along the arcs at different speeds. */
  .dial { stroke-dasharray: 2 12; stroke-width: 3; opacity: .8; }
  .orbit-arc { stroke-dasharray: 14 10; animation: travel 3s linear infinite; }
  .orbit-arc--mid { stroke-dasharray: 6 9; animation-duration: 4.5s; animation-direction: reverse; }
  .orbit-arc--outer { stroke-dasharray: 20 26; animation-duration: 6s; }
  @keyframes travel { to { stroke-dashoffset: -48; } }

  /* Chat windows, files and folders */
  .pop { opacity: 0; animation: pop 6s cubic-bezier(.2, .8, .2, 1) infinite; animation-delay: calc(var(--i) * 1s); }
  @keyframes pop {
    0% { transform: scale(.4) translateY(6px); opacity: 0; }
    8% { transform: scale(1.06); opacity: 1; }
    13% { transform: scale(1); }
    45% { transform: scale(1) translateY(-4px); opacity: 1; }
    56%, 100% { transform: scale(.85) translateY(-8px); opacity: 0; }
  }

  /* Video call */
  .call { animation: call 6s cubic-bezier(.2, .8, .2, 1) infinite; transform-origin: right center; }
  @keyframes call {
    0% { transform: scale(.3); opacity: 0; }
    10% { transform: scale(1.04); opacity: 1; }
    15%, 75% { transform: scale(1); opacity: 1; }
    88%, 100% { transform: scale(.6); opacity: 0; }
  }
  .call__live { fill: var(--accent-ink); animation: blink 1.2s steps(2, jump-none) infinite; }
  .call__self { animation: blink 3s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .25; } }

  /* 3D orbits */
  .orbit { perspective: 520px; perspective-origin: var(--cx) var(--cy); }
  .orbit__tilt, .orbit__ring { position: absolute; transform-style: preserve-3d; }
  .orbit__tilt { inset: 0; transform-origin: var(--cx) var(--cy); transform: rotateX(var(--tilt)); }
  .orbit__ring { left: var(--cx); top: var(--cy); width: 0; height: 0; animation: spin var(--duration) linear infinite; }
  @keyframes spin { to { transform: rotateY(360deg); } }
  .orbit__item {
    position: absolute;
    left: 0;
    top: 0;
    transform-style: preserve-3d;
    transform: rotateY(var(--angle)) translateZ(var(--radius)) translateY(var(--y)) translate(-50%, -50%);
    /* Items fade as they swing to the far side, which reads as depth. */
    animation: depth var(--duration) ease-in-out infinite;
    animation-delay: var(--phase);
  }
  @keyframes depth {
    0%, 100% { opacity: 1; }
    50% { opacity: .3; }
  }
  .orbit__shape { display: block; fill: none; stroke: var(--accent-ink); stroke-width: 3.6; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }

  .cube { --size: 24px; position: relative; width: var(--size); height: var(--size); transform-style: preserve-3d; animation: tumble 6s linear infinite; animation-delay: var(--spin); }
  .cube__face { position: absolute; inset: 0; border: 3.6px solid var(--accent-ink); border-radius: 3px; }
  .cube__face--front { transform: translateZ(calc(var(--size) / 2)); }
  .cube__face--back { transform: rotateY(180deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--left { transform: rotateY(-90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--right { transform: rotateY(90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--top { transform: rotateX(90deg) translateZ(calc(var(--size) / 2)); }
  .cube__face--bottom { transform: rotateX(-90deg) translateZ(calc(var(--size) / 2)); }
  @keyframes tumble { to { transform: rotateX(360deg) rotateY(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .strokes *, .orbit * { animation: none !important; }
    .pop, .call { opacity: 1; }
    .draw { stroke-dashoffset: 0; }
  }
</style>
