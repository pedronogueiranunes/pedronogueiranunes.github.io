---
import type { CollectionEntry } from "astro:content";
import ResponsiveImage from "./ResponsiveImage.astro";
import Icon from "./Icon.astro";
import { categoryBySlug, readingMinutes } from "../data/blog";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
  headingLevel?: "h2" | "h3";
}
const { post, featured = false, headingLevel = "h3" } = Astro.props;
const { title, excerpt, date, cover, category } = post.data;
const href = `/thoughts/${post.slug}`;
const Heading = headingLevel;
const formatted = date.toLocaleDateString(Astro.currentLocale || "en", {
  timeZone: "UTC",
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article class:list={["post-card", { "post-card--featured": featured }]}>
  <a class="post-card__cover" href={href} tabindex="-1" aria-hidden="true">
    <ResponsiveImage
      src={cover}
      width="630"
      height="420"
      loading={featured ? "eager" : "lazy"}
      sizes={featured ? "(max-width: 768px) calc(100vw - 40px), 55vw" : "(max-width: 768px) calc(100vw - 40px), 30vw"}
      alt=""
    />
  </a>
  <div class="post-card__copy">
    <p class="post-card__meta mono">
      <a class="accent" href={`/thoughts/category/${category}`}>{categoryBySlug(category)?.label}</a>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatted}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post.body)} <span>min read</span></span>
    </p>
    <Heading class="post-card__title"><a href={href}>{title}</a></Heading>
    <p class="post-card__excerpt">{excerpt}</p>
    <a class="text-link" href={href} aria-label={`Read ${title}`}>Read article <Icon name="arrow-right" /></a>
  </div>
</article>
