---
import "../styles/page-fidelity.css";
import PixelTrail from "../components/PixelTrail.astro";
import Base from "../layouts/Base.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ToolChip from "../components/ToolChip.astro";
import Icon from "../components/Icon.astro";
import DitherIcon from "../components/DitherIcon.astro";
import { promises, timeline, skills } from "../data/about";
import { site } from "../data/site";
// Short complementary lines for the police tapes, one per promise card.
const promiseIcons = ["design", "development", "motion", "collaboration"];
const tapeCopy = [
  "Design with purpose",
  "Built to work",
  "Measured, not guessed",
  "Better together",
];
import { logoFor } from "../data/home";
const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pedro Nogueira",
  alternateName: "Pedro José Nogueira Nunes",
  jobTitle: "Design Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Vitória da Conquista",
    addressRegion: "BA",
    addressCountry: "BR",
  },
  knowsLanguage: ["pt", "en", "es"],
  knowsAbout: [
    "Web design",
    "Webflow",
    "WordPress",
    "React",
    "Brand identity",
    "Design systems",
    "Conversion rate optimization",
  ],
  url: new URL("/about", Astro.site).href,
  email: `mailto:${site.email}`,
  sameAs: Object.values(site.socials).filter(Boolean),
});
// Career roll for the approach section, oldest first. Videos are pre-baked boomerangs.
const careerShots = [
  { year: "2018", label: "Jul 2018", src: "/assets/career/2018-07-desk.webp", video: "/assets/career/2018-07-desk.mp4" },
  { year: "2018", label: "Jul 2018", src: "/assets/career/2018-07-timelapse.webp", video: "/assets/career/2018-07-timelapse.mp4" },
  { year: "2018", label: "Sep 2018", src: "/assets/career/2018-09-selfie.webp" },
  { year: "2023", label: "Jan 2023", src: "/assets/career/2023-01-desk.webp", video: "/assets/career/2023-01-desk.mp4" },
  { year: "2023", label: "Apr 2023", src: "/assets/career/2023-04-coffee.webp", video: "/assets/career/2023-04-coffee.mp4" },
  { year: "2024", label: "May 2024", src: "/assets/career/2024-05-park.webp" },
  { year: "2024", label: "Sep 2024", src: "/assets/career/2024-09-selfie.webp" },
  { year: "2025", label: "May 2025", src: "/assets/career/2025-05-selfie.webp" },
  { year: "2026", label: "Feb 2026", src: "/assets/career/2026-02-balcony.webp", video: "/assets/career/2026-02-balcony.mp4" },
  { year: "2026", label: "Jul 2026", src: "/assets/career/2026-07-selfie.webp" },
];
---

<Base
  title="About Pedro Nogueira: design engineer, brand and web"
  description="Pedro Nogueira is a senior designer and developer based in Brazil, working with agencies and brands in North America and Europe since 2015. Brand, design systems, Webflow, WordPress and React."
  pageClass="about-page"
>
  <script type="application/ld+json" slot="head" set:html={personSchema} />
  <section class="about-hero page-section">
    <PixelTrail tone="green" world />
    <div class="about-portrait" id="splat-viewport" data-auto-rotate="true">
      <ResponsiveImage
        id="splat-fallback"
        src="/assets/head-hero.webp"
        width="718"
        height="937"
        alt="Pedro Nogueira"
        fetchpriority="high"
        loading="eager"
      />
      <button class="portrait-activate" type="button" aria-label="Play 3D portrait">Play 3D</button>
      <canvas id="splat-canvas" role="img" aria-label="3D portrait of Pedro. Drag or use arrow keys to rotate." aria-hidden="true"></canvas>
    </div>
    <div>
      <Eyebrow>About me</Eyebrow>
      <h1>I design it, then I build it.</h1>
      {/* TODO: confirm with Pedro before publishing ("lead" vs "work on" at BT Marketing) */}
      <p>I'm Pedro Nogueira, a design engineer based in Bahia, Brazil. For 12+ years I have taken brands and websites from the first sketch to production, for clients in the US, Canada, Germany and Brazil. Today I lead web design and CRO at BT Marketing, a Toronto agency, and take on a few projects of my own.</p>
      <div class="about-hero__actions">
        <a class="text-link" href="/contact">Start a project <Icon name="arrow-right" /></a>
        {site.cvUrl ? <a class="text-link" href={site.cvUrl} download>Download CV <Icon name="download" /></a> : <a class="text-link" href={`mailto:${site.email}?subject=CV%20request`}>Request my CV <Icon name="arrow-right" /></a>}
      </div>
    </div>
  </section>
  <section class="about-approach page-section" aria-labelledby="approach-title">
    <div class="about-approach__inner">
      <div class="about-approach__lead">
        <h2 id="approach-title">From print shops to production code.</h2>
        {/* Career roll: real photos and boomerang clips, oldest first. Dates come from each file's metadata. */}
        <div class="polaroid-roll">
          <button class="polaroid-stack" type="button" aria-label="Show the next photo" data-polaroid-stack>
            {careerShots.map((shot, index) => (
              <figure class="polaroid" style={`--i:${index % 5}`} data-year={shot.year}>
                {shot.video ? (
                  <video class="polaroid__photo" src={shot.video} poster={shot.src} muted loop playsinline preload="none" aria-hidden="true"></video>
                ) : (
                  <img class="polaroid__photo" src={shot.src} alt="" width="360" height="400" loading="lazy" decoding="async" />
                )}
                <figcaption>{shot.label}</figcaption>
              </figure>
            ))}
          </button>
          <div class="polaroid-years" role="group" aria-label="Jump to a year">
            {[...new Set(careerShots.map((shot) => shot.year))].map((year) => (
              <button type="button" data-year={year}>{year}</button>
            ))}
          </div>
        </div>
      </div>
      <div class="about-approach__copy">
        <span class="about-approach__mark" aria-hidden="true"></span>
        <p>I started in graphic design for print, preparing films and plates, and moved to the web soon after. Along the way I spent years in an agency doing art direction, video and motion, then went all in on front-end. From 2021 to 2025 I ran SUPERFLUID, my own studio, designing and building brands, sites and web apps for clients abroad. Since then I have worked inside agencies and consultancies on enterprise Webflow builds, landing pages and conversion work. That mix is the point: I can sit with a brand team in the morning and review a pull request in the afternoon.</p>
      </div>
    </div>
  </section>
  <section class="promises-section page-section" id="how-i-work">
    <Eyebrow>How I work</Eyebrow>
    <h2>From the first idea to the finished experience.</h2>
    <p>I connect the visual and technical details, collaborating with teams to bring thoughtful work to life.</p>
    <div class="promises-grid">
      {promises.map(([title, body], i) => {
        const tape = tapeCopy[i];
        return (
          <article class="promise-card">
            <span class="promise-tape" aria-hidden="true">
              <span class="promise-tape__track">
                <span class="promise-tape__group">
                  <span class="promise-tape__text">{tape}</span>
                  <span class="promise-tape__text">{tape}</span>
                </span>
                <span class="promise-tape__group">
                  <span class="promise-tape__text">{tape}</span>
                  <span class="promise-tape__text">{tape}</span>
                </span>
              </span>
            </span>
            <div class="promise-art">
              <ResponsiveImage
                src={`/assets/about-icons/${promiseIcons[i]}.webp`}
                width="138"
                height="138"
                loading="lazy"
                alt=""
              />
              <DitherIcon />
            </div>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        );
      })}
    </div>
    <div class="promise-facts">
      <p><span class="mono">Based in</span>Bahia, Brazil · Remote</p>
      <p><span class="mono">Languages</span>Portuguese (native), English (professional), Spanish (advanced)</p>
      {/* TODO: confirm with Pedro before publishing */}
      <p><span class="mono">Working hours</span>Overlaps US Eastern and Pacific</p>
    </div>
  </section>
  <section class="career-section page-section" id="timeline">
    <h2>Experience across teams and disciplines</h2>
    {site.cvUrl ? <a class="text-link career-cv" href={site.cvUrl} download>Download CV <Icon name="download" /></a> : <a class="text-link career-cv" href={`mailto:${site.email}?subject=CV%20request`}>Request my CV <Icon name="arrow-right" /></a>}
    <ol class="career-timeline">
      {timeline.map(([date, title, description], index) => (
        <li data-preview={index}>
          <span class="career-date mono">{date}</span>
          <div>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
    {/* TODO: mock previews. Three solid tones per role stand in for Pedro's photos. */}
    <div class="career-preview" aria-hidden="true" data-career-preview>
      {timeline.map((_, index) => (
        <div class="career-preview__set" data-set={index}>
          {[0, 1, 2].map((shot) => (
            <span class="career-preview__shot" style={`--tone:${["#e9b49a", "#b9cbb4", "#a9b7c9", "#d9c7a7", "#cfd6c6", "#f0c9a8", "#c3cdd8"][(index + shot * 2) % 7]}`}>
              <small>[{String(index + 1).padStart(2, "0")} / {shot + 1}]</small>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>
  <section class="skills-section page-section" id="skills">
    <h2 class="skills-title">Skills &amp; tools</h2>
    <div class="skills-grid">
      {skills.map(([title, tools]) => (
        <article>
          <h3>{title}</h3>
          <div class="chips">
            {tools.map((tool) => (
              <ToolChip
                label={tool === "Semrush" ? "SEMrush" : tool}
                logo={logoFor(tool)}
                size="m"
              />
            ))}
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href="/services#stacks">
      See the full stack <Icon name="arrow-right" />
    </a>
  </section>
  <script>
    import { onPageLoad } from "../scripts/page-lifecycle";
    import { loadPlayCanvas } from "../scripts/playcanvas-loader";
    import { initReveal } from "../scripts/reveal.js";
    onPageLoad((scope) => {
      if (!document.querySelector(".about-page")) return;
      scope.cleanup(initReveal());
      const approach = document.querySelector<HTMLElement>(".about-approach");
      const heading = approach?.querySelector<HTMLHeadingElement>("h2");
      // Highlights "production" in each locale (EN/FR production, ES producción, PT produção).
      const wordPattern = /produ(?:ction|cción|ção)/i;
      if (approach && heading && !heading.querySelector(".approach-word")) {
        const text = heading.textContent || "";
        const match = wordPattern.exec(text);
        if (match && match.index !== undefined) {
          const word = document.createElement("span");
          word.className = "approach-word";
          const letters = Array.from(match[0]);
          word.setAttribute("aria-label", match[0]);
          for (let i = 0; i < letters.length; i++) {
            const segment = document.createElement("span");
            segment.className = "approach-word__segment";
            segment.setAttribute("aria-hidden", "true");
            const original = document.createElement("span");
            original.className = "approach-word__original";
            original.textContent = letters[i];
            const alternate = document.createElement("span");
            alternate.className = "approach-word__alternate";
            alternate.textContent = original.textContent;
            segment.append(original, alternate);
            word.append(segment);
          }
          heading.replaceChildren(text.slice(0, match.index), word, text.slice(match.index + match[0].length));
        }
      }
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      let scrollFrame = 0;
      const fitApproachLetters = () => {
        heading?.querySelectorAll<HTMLElement>(".approach-word__segment").forEach((segment) => {
          const alternate = segment.querySelector<HTMLElement>(".approach-word__alternate");
          if (!alternate) return;
          alternate.style.transform = "none";
          const width = alternate.getBoundingClientRect().width;
          if (width) alternate.style.transform = `scaleX(${segment.getBoundingClientRect().width / width})`;
        });
      };
      document.fonts.ready.then(() => { if (!scope.signal.aborted) fitApproachLetters(); });
      const updateApproach = () => {
        scrollFrame = 0;
        if (!approach || reducedMotion.matches) return;
        const rect = heading!.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (innerHeight * 1.05 - rect.top) / (innerHeight * .55)));
        const segments = heading!.querySelectorAll<HTMLElement>(".approach-word__segment");
        const completed = Math.floor(progress * segments.length);
        segments.forEach((segment, index) => segment.classList.toggle("is-resolved", index < completed));
      };
      const scheduleApproach = () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateApproach);
      };
      window.addEventListener("scroll", scheduleApproach, { passive: true, signal: scope.signal });
      window.addEventListener("resize", () => { fitApproachLetters(); scheduleApproach(); }, { passive: true, signal: scope.signal });
      reducedMotion.addEventListener("change", scheduleApproach, { signal: scope.signal });
      scope.cleanup(() => cancelAnimationFrame(scrollFrame));
      updateApproach();
      const promisesSection = document.querySelector(".promises-section");
      if (promisesSection && "IntersectionObserver" in window) {
        const tapeObserver = new IntersectionObserver(([entry]) => {
          promisesSection.toggleAttribute("data-tape-play", entry.isIntersecting);
        });
        tapeObserver.observe(promisesSection);
        scope.cleanup(() => tapeObserver.disconnect());
      }
      const viewport = document.getElementById("splat-viewport")!;
      let loaded = false;
      let dispose: (() => void) | undefined;
      scope.cleanup(() => dispose?.());
      const load = () => {
        if (loaded || scope.signal.aborted) return;
        loaded = true;
        loadPlayCanvas().then(() => import("../scripts/splat-hero.js")).then(({ initSplat }) => {
          if (!scope.signal.aborted && viewport.isConnected) dispose = initSplat();
        }).catch(() => { if (!scope.signal.aborted) viewport.dataset.failed = "true"; });
      };
      viewport.querySelector("button")?.addEventListener("click", load, { signal: scope.signal });
      viewport.addEventListener("pointerdown", load, { once: true, signal: scope.signal });
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !connection?.saveData) scope.idle(load);
    });
  </script>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  // Polaroid stack: every few seconds (and on click) the top photo flicks away
  // and slides to the back of the pile.
  onPageLoad((scope) => {
    const stack = document.querySelector<HTMLElement>("[data-polaroid-stack]");
    if (!stack) return;
    const cards = [...stack.querySelectorAll<HTMLElement>(".polaroid")];
    const years = [...document.querySelectorAll<HTMLButtonElement>(".polaroid-years button")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let order = cards.map((_, index) => index), busy = false, timer = 0, visible = false;
    const place = () => {
      order.forEach((card, pos) => {
        const el = cards[card];
        // --pos drives the pile offset; anything past the fifth card is tucked away.
        el.style.setProperty("--pos", String(Math.min(pos, 5)));
        el.toggleAttribute("data-visible", pos < 5);
        const video = el.querySelector("video");
        if (video) {
          if (pos === 0 && visible && !reduced.matches) { video.preload = "auto"; video.play().catch(() => {}); }
          else video.pause();
        }
      });
      const year = cards[order[0]].dataset.year;
      years.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.year === year)));
    };
    const next = () => {
      if (busy) return;
      busy = true;
      const top = cards[order[0]];
      top.classList.add("is-leaving");
      scope.timeout(() => {
        order = [...order.slice(1), order[0]];
        top.classList.remove("is-leaving");
        place();
        busy = false;
      }, reduced.matches ? 0 : 420);
    };
    // Jumping to a year rotates the pile so that year's first photo is on top.
    years.forEach((button) => button.addEventListener("click", () => {
      const target = cards.findIndex((card) => card.dataset.year === button.dataset.year);
      const at = order.indexOf(target);
      order = [...order.slice(at), ...order.slice(0, at)];
      place();
      loop();
    }, { signal: scope.signal }));
    // ponytail: 3.2s per photo; tune here.
    const loop = () => { clearInterval(timer); timer = window.setInterval(() => { if (visible && !document.hidden && !reduced.matches) next(); }, 3200); };
    stack.addEventListener("click", () => { next(); loop(); }, { signal: scope.signal });
    const io = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; place(); });
    io.observe(stack);
    place();
    loop();
    scope.cleanup(() => { clearInterval(timer); io.disconnect(); });
  });
</script>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  // Career preview: follows the cursor with a little lag and cycles the hovered role's shots.
  onPageLoad((scope) => {
    const preview = document.querySelector<HTMLElement>("[data-career-preview]");
    const list = document.querySelector<HTMLElement>(".career-timeline");
    if (!preview || !list || !matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    // Fixed positioning breaks inside the section's reveal translate, so the card lives on body.
    const home = preview.parentElement!;
    document.body.append(preview);
    scope.cleanup(() => home.append(preview));
    const sets = [...preview.querySelectorAll<HTMLElement>(".career-preview__set")];
    let x = 0, y = 0, tx = 0, ty = 0, frame = 0, timer = 0, current = -1, shot = 0;
    const show = (setIndex: number, shotIndex: number) => {
      sets.forEach((set, i) => set.classList.toggle("is-current", i === setIndex));
      sets[setIndex]?.querySelectorAll(".career-preview__shot").forEach((el, i) => el.classList.toggle("is-on", i === shotIndex));
    };
    const follow = () => {
      x += (tx - x) * .18; y += (ty - y) * .18;
      // Offset so the card sits beside the cursor; tilt slightly with horizontal speed.
      preview.style.transform = `translate(${(x + 24).toFixed(1)}px, ${(y - 90).toFixed(1)}px) rotate(${((tx - x) * .05).toFixed(2)}deg)`;
      frame = Math.abs(tx - x) + Math.abs(ty - y) > .3 ? requestAnimationFrame(follow) : 0;
    };
    list.addEventListener("pointermove", (event) => {
      tx = event.clientX; ty = event.clientY;
      if (!preview.classList.contains("is-active")) { x = tx; y = ty; }
      const row = (event.target as Element).closest<HTMLElement>("[data-preview]");
      const index = row ? Number(row.dataset.preview) : -1;
      if (index !== current && index >= 0) {
        current = index; shot = 0; show(current, shot);
        clearInterval(timer);
        // ponytail: 900ms per shot.
        timer = window.setInterval(() => { shot = (shot + 1) % 3; show(current, shot); }, 900);
      }
      preview.classList.toggle("is-active", index >= 0);
      if (!frame) frame = requestAnimationFrame(follow);
    }, { signal: scope.signal });
    list.addEventListener("pointerleave", () => { preview.classList.remove("is-active"); clearInterval(timer); current = -1; }, { signal: scope.signal });
    scope.cleanup(() => { clearInterval(timer); cancelAnimationFrame(frame); });
  });
</script>
</Base>

<style>
  :global(.about-page .promises-grid article.promise-card:nth-child(1) .promise-art) { transform: none; }
  .about-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; margin-top: 22px; }
  .about-approach { padding-block: clamp(72px, 8vw, 120px); }
  .about-approach__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    align-items: start;
    gap: clamp(40px, 5vw, 80px);
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }
  .about-approach h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(38px, 4.1vw, 62px);
    line-height: 1.08;
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .about-approach :global(.approach-word) {
    color: var(--accent);
    display: inline-block;
    white-space: nowrap;
  }
  .about-approach :global(.approach-word__segment) { position: relative; display: inline-block; }
  .about-approach :global(.approach-word__alternate) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    white-space: nowrap;
    font-family: var(--font-lettering);
    font-size: 1em;
    font-weight: 400;
    line-height: inherit;
    letter-spacing: -.025em;
    transform-origin: left center;
    transition: opacity 120ms ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-approach :global(.approach-word__original) { opacity: 0; }
    .about-approach :global(.approach-word__alternate) { opacity: 1; }
    .about-approach :global(.approach-word__segment:nth-child(3n) .approach-word__alternate) { font-family: "Silkscreen", monospace; font-size: .78em; }
    .about-approach :global(.approach-word__segment.is-resolved .approach-word__original) { opacity: 1; }
    .about-approach :global(.approach-word__segment.is-resolved .approach-word__alternate) { opacity: 0; }
  }
  .about-approach__copy { padding-top: 7px; }
  /* Career hover preview: a small card follows the cursor over the timeline and
     cycles through three shots of the hovered role. Desktop pointers only. */
  .career-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 260px;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: .85;
    box-shadow: 0 24px 50px -20px rgb(35 38 37 / .45);
    transition: opacity 220ms ease, scale 320ms cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
  }
  .career-preview.is-active { opacity: 1; scale: 1; }
  .career-preview__set { position: absolute; inset: 0; visibility: hidden; }
  .career-preview__set.is-current { visibility: visible; }
  .career-preview__shot {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 12px;
    background: var(--tone);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .career-preview__shot.is-on { opacity: 1; }
  .career-preview__shot small { color: rgb(35 38 37 / .6); font: 400 11px/1 var(--font-mono); }
  @media (hover: none), (prefers-reduced-motion: reduce) { .career-preview { display: none; } }
  /* Polaroid stack: cards sit in a loose pile; the top one flicks away and slides
     to the back on a timer or on click. --pos is 0 for the top card. */
  .polaroid-stack {
    position: relative;
    display: block;
    width: min(100%, 360px);
    aspect-ratio: 1 / 1.1;
    margin-top: 48px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .polaroid {
    --pos: var(--i);
    position: absolute;
    inset: 0 12% 6% 6%;
    margin: 0;
    padding: 12px 12px 0;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 14px 30px -12px rgb(35 38 37 / .35);
    z-index: calc(10 - var(--pos));
    transform:
      translate(calc(var(--pos) * 7px), calc(var(--pos) * 5px))
      rotate(calc((var(--i) - 2) * 3.5deg));
    transition: transform 650ms cubic-bezier(.22, 1, .36, 1);
  }
  .polaroid__photo { width: 100%; height: 100%; min-height: 0; object-fit: cover; border-radius: 1px; background: #e8e6e1; display: block; }
  .polaroid { visibility: hidden; }
  /* Only the top five cards show; the rest wait their turn at the back. */
