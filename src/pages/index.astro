---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";
import ToolChip from "../components/ToolChip.astro";
import ProjectRail from "../components/ProjectRail.astro";
import Comparison from "../components/Comparison.astro";
import Process from "../components/Process.astro";
import { problems } from "../data/home";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Pedro Nogueira | Web designer and developer">
  <section class="home-hero">
    <div class="home-hero-panel">
      <h1>
        Your next website,
        <br />
        from design to launch.
      </h1>
      <p>
        I help businesses build their websites and agencies deliver for their
        clients, bringing design and development together across WordPress,
        Webflow, Framer, and React.
      </p>
      <div class="actions">
        <Button href="/contact">Book a call</Button>
        <a class="text-link" href="#work">
          See the work <Icon name="arrow-right" />
        </a>
      </div>
      <div class="hero-lettering" aria-hidden="true">
        <div class="hero-lettering-track">
          <span>
            figma&nbsp;+&nbsp;ux&nbsp;design&nbsp;+&nbsp;web&nbsp;development&nbsp;+&nbsp;
          </span>
          <span>
            figma&nbsp;+&nbsp;ux&nbsp;design&nbsp;+&nbsp;web&nbsp;development&nbsp;+&nbsp;
          </span>
        </div>
      </div>
    </div>
    <div class="home-portrait" id="portrait-origin">
      <div class="portrait-stage" id="splat-viewport">
        <svg
          class="portrait-silhouette"
          width="338"
          height="482"
          viewBox="-34 -7 338 482"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          preserveAspectRatio="xMidYMax meet"
        >
          <path
            d="M0.338984 481.143C-0.926286 460.899 0.664299 412.494 17.1488 380.826C33.6333 349.159 38.8389 335.819 39.3812 333.108L53.4798 311.96C53.4093 309.64 52.5376 304.436 49.6146 302.177C46.6916 299.919 45.4073 296.918 45.1305 295.7L43.8019 302.177V306.827C43.8019 312.452 40.4218 315.885 37.6707 314.463C37.4972 314.373 37.3262 314.264 37.1587 314.135C35.2323 312.651 36.1557 313.33 37.1587 314.079V297.361V288.891C36.7159 288.891 35.6308 287.961 34.8337 284.241C33.8372 279.591 33.505 277.099 34.8337 276.103C36.1623 275.107 37.1587 274.11 37.1587 273.114C37.1587 272.117 36.8266 266.47 40.9785 265.806C45.1305 265.142 49.071 267.467 51.2754 262.651C53.4798 257.834 58.5828 248.534 63.067 244.714C67.5511 240.894 56.5184 244.228 50.8511 240.85C45.1838 237.471 42.9553 234.691 42.7541 221.006C42.5528 207.32 47.1234 207.723 40.9785 200.88C36.0626 195.406 38.9302 190.013 40.9785 188C38.5039 187.329 33.8104 184.498 34.8337 178.541C36.1127 171.095 37.803 167.69 36.0897 167.69C34.3763 167.69 23.4964 167.69 20.5836 163.149C17.6709 158.609 18.5276 153.469 20.5836 148.5C22.2285 144.525 23.0966 143.189 23.325 143.017C21.5545 139.505 17.8593 130.39 17.2425 122.028C18.1849 120.686 21.3032 117.933 26.2378 117.659C27.123 117.545 28.7907 116.923 28.3795 115.346C27.1516 113.262 24.8499 108.476 25.4667 106.008C26.2378 102.924 26.2378 94.9571 27.7798 92.2157C26.4376 88.9888 23.3593 82.2952 21.783 81.3357C19.8126 80.1364 16.5572 78.2517 15.9575 74.9106C15.4778 72.2377 12.5022 72.0264 11.0744 72.2549C11.2172 71.4267 11.9482 69.7019 13.7301 69.4278C12.9876 68.0571 11.7255 64.716 12.6164 62.3173C13.3589 61.689 14.6211 59.6273 13.7301 56.4061C13.673 54.2073 14.484 49.6383 18.1849 48.953C17.985 50.9519 18.4248 54.5557 21.783 52.9794C26.7352 42.7955 42.0426 20.4209 63.6543 12.3937C90.669 2.35967 90.5587 4.45467 92.9845 3.57256C95.4103 2.69044 104.452 1.58779 109.304 0.70568C114.155 -0.17643 140.949 -1.05852 156.827 3.57256C172.705 8.20363 174.028 14.0476 178.108 14.9297C182.188 15.8118 182.078 18.2376 183.511 19.23C184.945 20.2224 192.112 24.6329 193.545 26.0664C194.979 27.4998 194.537 28.9332 196.081 29.5948C197.625 30.2564 195.971 31.5796 198.838 32.6822C201.705 33.7848 201.705 37.203 203.469 38.6364C205.233 40.0699 203.8 40.6212 206.225 43.047C208.651 45.4728 218.465 57.1608 219.788 64.2176C221.111 71.2745 220.008 73.9209 220.891 79.3238C221.773 84.7267 218.024 93.4376 218.354 97.0763C218.685 100.715 216.811 111.3 217.583 115.27C218.354 119.239 209.644 129.714 209.203 130.817C208.761 131.92 205.62 149.654 204.179 153.256C202.738 156.858 199.616 167.905 199.616 171.748C199.616 175.59 200.096 182.872 198.175 185.436C198.861 185.811 200.322 187.065 200.677 189.08C201.122 191.6 206.902 213.238 207.791 216.054C208.68 218.87 216.536 243.918 216.536 243.918C217.178 244.263 218.344 245.34 217.869 246.882C218.018 248.512 219.559 252.277 224.539 254.292C227.305 256.021 233.046 260.043 233.876 262.295C238.026 266.495 247.155 275.219 250.475 276.524C260.949 287.343 283.081 310.345 287.824 315.799C293.752 322.616 316.428 349.887 319.985 357.149C323.246 363.522 330.034 379.558 331.101 392.719C332.435 409.17 338.808 435.848 337.622 444.592C336.674 451.588 337.227 471.874 337.622 481.143H0.338984Z"
            fill="url(#silhouette-fill)"
          />
          <path
            d="M56.1113 97.6849V83.9349H58.8613V94.9349H64.3613V97.6849H56.1113ZM77.0113 97.6849V94.9349H74.2613V86.6849H77.0113V83.9349H82.5113V86.6849H85.2613V94.9349H82.5113V97.6849H77.0113ZM77.0113 94.8249H82.5113V86.7949H77.0113V94.8249ZM95.1613 97.6849V86.6849H97.9113V83.9349H103.411V86.6849H106.161V97.6849H103.411V92.1849H97.9113V97.6849H95.1613ZM97.9113 89.4349H103.411V86.7949H97.9113V89.4349ZM116.061 97.6849V83.9349H124.311V86.6849H127.061V94.9349H124.311V97.6849H116.061ZM118.811 94.9349H124.201V86.6849H118.811V94.9349ZM136.961 97.6849V83.9349H139.711V97.6849H136.961ZM149.611 97.6849V83.9349H152.361V86.6849H155.111V89.4349H157.861V92.1849H160.611V83.9349H163.361V97.6849H160.611V94.9349H157.861V92.1849H155.111V89.4349H152.361V97.6849H149.611ZM176.011 86.6849V83.9349H184.261V86.6849H176.011ZM173.261 94.9349V86.6849H176.011V94.9349H173.261ZM181.511 94.9349V92.1849H178.761V89.4349H184.261V94.9349H181.511ZM176.011 97.6849V94.9349H181.511V97.6849H176.011Z"
            fill="white"
          />
          <defs>
            <linearGradient
              id="silhouette-fill"
              x1="168.884"
              y1="0"
              x2="168.884"
              y2="481.143"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#FF5A1F" />
              <stop offset="0.9" stop-color="#FF5A1F" />
              <stop offset="1" stop-color="#FF5A1F" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>
        <ResponsiveImage
          id="splat-fallback"
          src="/assets/head-hero.webp"
          width="700"
          height="910"
          alt="Pedro Nogueira"
          fetchpriority="high"
          loading="eager"
          sizes="(max-width: 768px) 304px, 560px"
        />
        <button
          class="portrait-activate"
          type="button"
          aria-label="Play 3D portrait"
        >
          Play 3D
        </button>
        <canvas
          id="splat-canvas"
          aria-label="Interactive portrait of Pedro. Drag to rotate."
          aria-hidden="true"
          role="img"
        ></canvas>
      </div>
    </div>
  </section>
  <section class="home-bio page-section">
    <div
      class="bio-portrait"
      id="portrait-destination"
      aria-hidden="true"
    ></div>
    <div>
      <Eyebrow>About me</Eyebrow>
      <h2>
        Hi, I'm Pedro. Developer, designer and illustrator, start to finish.
      </h2>
      <p>
        For 12+ years I've built websites for companies and agencies in the US,
        Canada and Germany. I work across WordPress, Webflow, Framer, Shopify
        and React, and I draw and art direct the visuals myself, so nothing gets
        lost between strategy, design and code. I work remotely from Vitória da
        Conquista, Brazil, on hours that overlap with North America. Off the
        clock, I make electronic music and study languages.
      </p>
      <div class="bio-facts">
        <span>
          <img
            src="/assets/figma/488-6649-imgIconExperience.svg"
            width="14"
            height="14"
            alt=""
          />
          12+ years
        </span>
        <span>
          <img
            src="/assets/figma/488-6649-imgIconInternationalMarkets.svg"
            width="14"
            height="14"
            alt=""
          />
          US · Canada · Germany
        </span>
        <span>
          <img
            src="/assets/figma/488-6649-imgIconRemoteLocation.svg"
            width="14"
            height="14"
            alt=""
          />
          Remote from Brazil, UTC-3
        </span>
      </div>
      <a class="text-link" href="/about">
        More about me <Icon name="arrow-right" />
      </a>
    </div>
  </section>
  <div id="work">
    <ProjectRail projects={projects} />
  </div>
  <section class="problems-section page-section">
    <div class="section-heading">
      <div>
        <Eyebrow>Where to start</Eyebrow>
        <h2>What is getting in the way?</h2>
      </div>
      <p>
        Pick the one that sounds like your last month. Each one points to where
        I'd start. Not sure? That is what the first call is for.
      </p>
    </div>
    <div class="problem-grid">
      {problems.map((problem, i) => (
        <article
          class="problem-card"
        >
          <div
            class="problem-art"
            style={`--art-mask:url('/assets/figma/488-6789-${problem.mask}.svg')`}
          >
            <ResponsiveImage
              src={`/assets/figma/488-6789-${problem.image}.webp`}
              width="412"
              height="412"
              loading="lazy"
              alt=""
            />
          </div>
          <div class="problem-top">
            <span>{String(i + 1).padStart(2, "0")}</span>
            <a href="/services" aria-label={`Services for: ${problem.title}`}>
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
          <div class="problem-copy">
          <h3>{i === 0 ? problem.title.replace(", ", ",\n") : i === 1 ? problem.title.replace(" and ", "\nand ") : problem.title}</h3>
          <p>{problem.body}</p>
          </div>
          <div class="problem-start">
            <p class="mono">I start with</p>
            <div class="chips">
              {problem.tools.map((tool, j) => (
                <>
                  {j > 0 && <span>+</span>}
                  <ToolChip label={tool} />
                </>
              ))}
            </div>
            <p class="problem-outcome">
              {problem.outcome}
              <Icon name="arrow-right" />
            </p>
          </div>
        </article>
      ))}
    </div>
    <div class="problem-followup">
    <p class="problem-note">Sounds like more than one?</p>
    <a class="text-link" href="/contact">
      That's normal. Book a call and we'll rank them together{" "}
      <Icon name="arrow-right" />
    </a>
    </div>
  </section>
  <Comparison />
  <Process />
  <section class="blog-section page-section" id="thoughts">
    <div class="section-heading">
      <div>
        <Eyebrow>blog</Eyebrow>
        <h2>Notes from the field.</h2>
        <p>Hot takes, creative ramblings and other thoughts about life.</p>
      </div>
      <a class="text-link" href="#articles">
        See all posts <Icon name="arrow-right" />
      </a>
    </div>
    <div class="article-grid" id="articles">
      {posts.map((post, i) => (
        <article
          class:list={["article-card", { "article-card--latest": i === 0 }]}
        >
          <a
            href={`/thoughts/${post.slug}`}
            class="article-cover"
            aria-label={`Read ${post.data.title}`}
          >
            <ResponsiveImage
              src={`/assets/figma/488-7471-imgCover${i || ""}.webp`}
              width="630"
              height="420"
              loading="lazy"
              alt=""
            />
          </a>
          <div class="article-copy">
            <p class="mono">
              <span class="accent">{post.data.tag}</span> ·{" "}
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
            </p>
            <h3>
              <a href={`/thoughts/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p>{post.data.excerpt}</p>
            <a class="text-link" href={`/thoughts/${post.slug}`}>
              Read more <Icon name="arrow-right" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <!-- Hidden/OLD Figma sections retained in docs/legacy/home-before-redesign.astro.txt. -->
  <script>
    import { initPortraitTravel } from "../scripts/portrait-travel.js";
    initPortraitTravel();
    // Keep mobile's first view light. The original splat is activated on portrait interaction.
    const viewport = document.getElementById("splat-viewport");
    if (viewport) {
      let loaded = false;
      const isWebGLAvailable = () => {
        try {
          const testCanvas = document.createElement("canvas");
          return !!(
            window.WebGLRenderingContext &&
            (testCanvas.getContext("webgl2") || testCanvas.getContext("webgl"))
          );
        } catch {
          return false;
        }
      };

      if (!isWebGLAvailable()) {
        viewport.dataset.failed = "true";
      }

      const load = () => {
        if (loaded || viewport.dataset.failed === "true")
          return;
        loaded = true;
        const script = document.createElement("script");
        script.src = "/assets/vendor/playcanvas.min.js";
        script.onload = () =>
          import("../scripts/splat-hero.js").then(({ initSplat }) => {
            try {
              initSplat();
            } catch {
              viewport.dataset.failed = "true";
            }
          });
        script.onerror = () => {
          viewport.dataset.failed = "true";
        };
        document.head.appendChild(script);
      };
      viewport.querySelector("button")?.addEventListener("click", load);
      viewport.addEventListener("pointerdown", load, { once: true });
      if (
        !matchMedia("(max-width: 1024px)").matches &&
        !(navigator as Navigator & { connection?: { saveData?: boolean } })
          .connection?.saveData
      ) {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if ("requestIdleCallback" in window)
              window.requestIdleCallback(load, { timeout: 4000 });
            else setTimeout(load, 1000);
          }),
        );
      }
    }
  </script>
</Base>
