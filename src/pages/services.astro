---
import { getCollection } from "astro:content";
import "../styles/page-fidelity.css";
import PixelTrail from "../components/PixelTrail.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ToolChip from "../components/ToolChip.astro";
import CheckList from "../components/CheckList.astro";
import RelatedProjects from "../components/RelatedProjects.astro";
import FAQ from "../components/FAQ.astro";
import DitherIcon from "../components/DitherIcon.astro";
import IconWaves from "../components/IconWaves.astro";
import StackGlyph from "../components/StackGlyph.astro";
import BlueprintPixels from "../components/BlueprintPixels.astro";
import ResearchRobot from "../components/ResearchRobot.astro";
import {
  offers,
  capabilities,
  deliverables,
  schedule,
  faq,
  caseResults,
  bundleNote,
} from "../data/services";
import { logoFor } from "../data/home";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectsBySlug = new Map(
  projects.map((project) => [project.data.caseSlug, project]),
);
const resultSlides = caseResults.map((result) => {
  const project = projectsBySlug.get(result.slug);
  return {
    ...result,
    image: result.image ?? project?.data.cover ?? "",
    tint: project?.data.tint ?? "#f3e8c6",
  };
});
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
});
---

<Base
  title="Services: websites, brand identity, design systems and CRO | Pedro Nogueira"
  description="Senior design engineer for agencies and brands in North America and Europe. Brand identity, design systems, and websites designed and built on Webflow, WordPress or React."
  pageClass="services-page"
>
  <script type="application/ld+json" slot="head" set:html={faqSchema} />
  <section class="service-hero page-section">
    <PixelTrail tone="green" world worldOrigin="[data-result-slider]" />
    <div>
      <Eyebrow>Services</Eyebrow>
      <h1>
        Brands, design systems and websites.
        <br />
        Designed and built by the same senior pair of hands.
      </h1>
      <p>
        I design the identity, turn it into a system, and ship the site on the
        platform your team can run. 12+ years of client work, with the
        illustration and motion that keep a brand from looking like a template.
      </p>
      <CheckList
        items={[
          "Brand, design system and build in one place",
          "Research and CRO before any redesign",
          "Webflow, WordPress, React or Shopify, chosen for your team",
        ]}
      />
      <div class="actions">
        <Button href="/contact">Start a project</Button>
        <Button href="#results" secondary>
          See the work
        </Button>
      </div>
      <div class="builds-on">
        <span class="mono">Builds on</span>
        {["WordPress", "Webflow", "Framer", "Shopify Hydrogen", "React"].map(
          (tool) => (
            <img
              src={`/assets/logos/${logoFor(tool)}.svg`}
              alt={tool}
              width="24"
              height="24"
            />
          ),
        )}
      </div>
      <p class="mono muted">
        Clients in the US, Canada, Germany and Brazil · Remote, US hours
      </p>
    </div>
    <div class="service-result-slider" data-result-slider>
      <div class="service-result">
        {resultSlides.map((slide, index) => (
          <article
            class="service-result-slide"
            data-result-slide
            hidden={index > 0}
          >
            <div
              class="service-result-image"
              style={`background:${slide.tint}`}
            >
              <ResponsiveImage
                src={slide.image}
                width="1600"
                height="1039"
                alt={slide.alt}
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="service-result-body">
              <p class="result-tag">Selected work</p>
              <h2>{slide.headline}</h2>
              <table>
                <thead>
                  <tr>
                    <th>Scope</th>
                    <th>Detail</th>
                  </tr>
                </thead>
                <tbody>
                  {slide.rows.map(([label, detail]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      <td>{detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <Button secondary href={`/work/${slide.slug}`}>
                See the full case study
              </Button>
            </div>
          </article>
        ))}
      </div>
      <button
        class="result-arrow result-arrow--prev"
        type="button"
        aria-label="Previous client result"
        data-result-prev
      >
        <Icon name="arrow-left" size={18} />
      </button>
      <button
        class="result-arrow result-arrow--next"
        type="button"
        aria-label="Next client result"
        data-result-next
      >
        <Icon name="arrow-right" size={18} />
      </button>
      <p
        class="sr-only"
        aria-live="polite"
        data-result-status
      ></p>
    </div>
  </section>
  <section class="offers-section page-section">
    <div class="section-heading">
      <div>
        <Eyebrow>Engagements</Eyebrow>
        <h2>Three ways to start.</h2>
      </div>
      <p>
        Not sure which one fits? <strong>The first call sorts that out.</strong>
      </p>
    </div>
    <div class="offer-grid">
      {offers.map((offer, index) => (
        <article
          class:list={[
            "offer-card",
            { "offer-card--featured": offer.featured },
          ]}
        >
          <IconWaves />
          <div class:list={["offer-art", `offer-art--${index}`]}>
            <ResponsiveImage
              src={`/assets/figma/488-10107-imgImage${index || ""}.webp`}
              width="254"
              height="254"
              sizes="254px"
              alt=""
            />
            <DitherIcon />
          </div>
          <h3>{offer.title}</h3>
          <p>{offer.description}</p>
          <CheckList items={offer.items} />
          <div class="offer-price">
            <p class="mono">{offer.duration}</p>
            <p>{offer.price}</p>
          </div>
          <a
            class="text-link"
            href={`/contact?service=${encodeURIComponent(offer.title)}`}
          >
            Start with this <Icon name="arrow-right" />
          </a>
        </article>
      ))}
    </div>
    <p class="mono muted offer-bundle-note">{bundleNote}</p>
  </section>
  <section class="agencies-section page-section" id="agencies">
    <div class="section-heading">
      <div>
        <Eyebrow>For agencies</Eyebrow>
        <h2>White-label design and build for agencies.</h2>
      </div>
      {/* TODO: confirm with Pedro before publishing (naming On The Map, ilegra and BT Marketing) */}
      <p>
        I have worked as a subcontractor for agencies in the US and Canada, and
        inside teams at On The Map, ilegra and BT Marketing. I join your Slack,
        Jira or Asana, follow your process and hand over clean, documented
        files.
      </p>
    </div>
    <CheckList
      items={[
        "Design, development or both",
        "White-label, NDA friendly", // TODO: confirm with Pedro before publishing (NDA)
        "Monthly capacity or per project",
        "Rates on request",
      ]}
    />
    <div class="actions">
      <Button href="/contact?route=agency">Talk about a partnership</Button>
    </div>
  </section>
  <section class="capabilities page-section" id="stacks">
    <div class="section-heading">
      <div>
        <Eyebrow>Stacks &amp; skills</Eyebrow>
        <h2>Everything a site needs, under one roof.</h2>
      </div>
      <p>
        Twelve years of client work across design, front-end and motion. I pick
        the stack for how you will run the site after launch, and I bring the
        brand, illustration and motion skills most developers outsource.
      </p>
    </div>
    <div class="capability-grid">
      {capabilities.map((cap, index) => (
        <article>
          <StackGlyph name={ ["category-web", "category-brand", "grid3", "chart", "category-commerce", "category-music"][index] } />
          <h3>{cap.title}</h3>
          <p>{cap.body}</p>
          <div class="chips">
            {cap.tools.map((tool) => (
              <ToolChip label={tool} logo={logoFor(tool)} />
            ))}
          </div>
        </article>
      ))}
    </div>
    <aside class="ai-note">
      <div class="ai-note__copy">
      <span class="ai-note__label">Research-led · Human-directed</span>
      <h3>Better decisions start with evidence.</h3>
      <p>I combine research and data with AI-assisted exploration. I review the insights, make the decisions and shape every design and build.</p>
      </div>
      <ResearchRobot />
    </aside>
  </section>
  <section class="deliverables-section page-section">
    <div>
      <Eyebrow>What you get</Eyebrow>
      <h2>You'll know exactly what you're paying for.</h2>
      <p>
        This list goes into your proposal before we start. If something is not
        on it, you do not pay for it. If you want something added, we talk about
        it first.
      </p>
      {/* TODO: confirm with Pedro before publishing (weekly updates, 30 days of fixes) */}
      <dl class="deliverable-stats">
        <div>
          <dt>things you get, in writing</dt>
          <dd>6</dd>
        </div>
        <div>
          <dt>a short call or Loom update</dt>
          <dd>Weekly</dd>
        </div>
        <div>
          <dt>of fixes after launch</dt>
          <dd>30 days</dd>
        </div>
      </dl>
    </div>
    <div class="deliverable-table">
      <div class="deliverable-table-head">
        <div>
          <small class="mono">Your proposal · Website build</small>
          <h3>What's included</h3>
        </div>
        <span class="tool-chip">In your proposal</span>
      </div>
      <ol>
        {deliverables.map((row) => (
          <li>
            <div>
              <h4>{row[0]}</h4>
              <p>{row[1]}</p>
            </div>
            <span class="mono">{row[2]}</span>
          </li>
        ))}
      </ol>
      <p class="deliverable-foot">
        We agree on this together before I build anything{" "}
        <a href="/contact" class="text-link">
          Ask for a sample proposal <Icon name="arrow-right" size={12} />
        </a>
      </p>
    </div>
    <BlueprintPixels />
  </section>
  <section class="schedule-section page-section">
    <div class="section-heading schedule-heading">
      <div>
        <Eyebrow>How it works</Eyebrow>
        <h2>From first call to a site that sells.</h2>
      </div>
      {/* TODO: confirm with Pedro before publishing (2 weeks to first designs) */}
      <div class="schedule-intro">
        <span class="schedule-number" data-magnetic-number>
          {/* ponytail: 12 stacked copies x 2px give the extrusion, like the navbar logo. */}
          <span class="schedule-number__model">
            {Array.from({ length: 12 }, (_, depth) => (
              <span class="schedule-number__layer" style={`--depth:${depth}`} aria-hidden={depth > 0 ? "true" : undefined}>2</span>
            ))}
          </span>
        </span>
        <div>
          <small class="mono accent">weeks</small>
          <p>From yes to first designs.<br />You see the plan before you pay for the build.</p>
        </div>
      </div>
    </div>
    <div class="schedule-grid">
      {schedule.map((row) => (
        <article>
          <p class="mono accent">{row[0]}</p>
          <h3>{row[1]}</h3>
          <p>{row[2]}</p>
        </article>
      ))}
    </div>
  </section>
  <div id="results">
    <RelatedProjects projects={projects} />
  </div>
  <section class="faq-section page-section">
    <Eyebrow>Before you hit send</Eyebrow>
    <h2>Common questions.</h2>
    <FAQ items={faq} />
  </section>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  // The schedule "2" tilts toward the pointer when it comes close, then settles back.
  onPageLoad((scope) => {
    const number = document.querySelector<HTMLElement>("[data-magnetic-number]");
    if (!number || !matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    addEventListener("pointermove", (event) => {
      if (reduced.matches || frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const box = number.getBoundingClientRect();
        const dx = event.clientX - (box.left + box.width / 2), dy = event.clientY - (box.top + box.height / 2);
        // ponytail: 360px reach; pull and tilt fade with distance.
        const pull = Math.max(0, 1 - Math.hypot(dx, dy) / 360);
        number.style.setProperty("--num-x", `${(dx / 12) * pull}px`);
        number.style.setProperty("--num-y", `${(dy / 12) * pull}px`);
        number.style.setProperty("--num-ry", `${(dx / 6) * pull}deg`);
        number.style.setProperty("--num-rx", `${(-dy / 6) * pull}deg`);
      });
    }, { signal: scope.signal, passive: true });
    scope.cleanup(() => cancelAnimationFrame(frame));
  });
</script>
</Base>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { initReveal } from "../scripts/reveal.js";
  onPageLoad((scope) => {
    if (!document.querySelector(".services-page")) return;
    scope.cleanup(initReveal({ stagger: 60, maxDelay: 240 }));
    // Client-result carousel: all slides are rendered for translation and SEO;
    // the arrows only toggle which one is visible.
    const slider = document.querySelector<HTMLElement>("[data-result-slider]");
    if (!slider) return;
    const slides = [...slider.querySelectorAll<HTMLElement>("[data-result-slide]")];
    const prev = slider.querySelector<HTMLButtonElement>("[data-result-prev]");
    const next = slider.querySelector<HTMLButtonElement>("[data-result-next]");
    const status = slider.querySelector<HTMLElement>("[data-result-status]");
    if (!slides.length || !prev || !next) return;
    let index = 0;
    const show = (target: number, animate = true) => {
      index = (target + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.hidden = !active;
      });
      if (animate) {
        const slide = slides[index];
        const elements = slide.querySelectorAll<HTMLElement>(".service-result-image, .result-tag, h2, thead, tbody tr, .service-result-body .action");
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          elements.forEach((element, i) => {
            element.getAnimations().forEach((animation) => animation.cancel());
            element.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 240, delay: Math.min(i * 35, 210), fill: "backwards", easing: "cubic-bezier(.16,1,.3,1)" });
          });
        }
      }
      if (status) {
        const headline = slides[index].querySelector("h2")?.textContent?.trim() ?? "";
        status.textContent = `${index + 1} / ${slides.length} · ${headline}`;
      }
    };
    const step = (delta: number) => () => show(index + delta);
    prev.addEventListener("click", step(-1), { signal: scope.signal });
    next.addEventListener("click", step(1), { signal: scope.signal });
    slider.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); show(index - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); show(index + 1); }
    }, { signal: scope.signal });
    show(0, false);
  });
</script>
