---
import { getCollection } from "astro:content";
import IconWaves from "../components/IconWaves.astro";
import DitherIcon from "../components/DitherIcon.astro";
import PixelTrail from "../components/PixelTrail.astro";
import Base from "../layouts/Base.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import CategoryGlyph from "../components/CategoryGlyph.astro";
import { featuredMetrics } from "../data/cases";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categories = [
  "Web Design & Dev",
  "Branding & Graphic Design",
  "Digital Art & Illustration",
  "Music & Audiovisual",
  "Experiments",
];
const categoryIcons = ["category-web", "category-brand", "category-art", "category-music", "category-experiment"];
const gridOrder = [0, 1, 2, 3, 4, 5];
const years = [...new Set(projects.map(project => project.data.year))].sort((a,b) => Number(b)-Number(a));
const platforms = new Set(["Webflow", "WordPress", "Next.js", "JavaScript", "Shopify Lite"]);
const unique = (values: string[]) => [...new Set(values)].sort();
const stacks = unique(projects.flatMap(p => p.data.tools.filter(tool => platforms.has(tool))));
const tools = unique(projects.flatMap(p => p.data.tools.filter(tool => !platforms.has(tool))));
const services = unique(projects.map(p => p.data.category));
const locations = unique(projects.flatMap(p => (p.data.location || "").split(" · ")));
const colors = unique(projects.map(p => p.data.tint || p.data.color || "").filter(Boolean));

---

<Base title="Projects | Pedro Nogueira" pageClass="projects-page">
  <header class="projects-header page-section">
    <PixelTrail tone="green" />
    <div class="projects-header-copy">
      <Eyebrow>Projects</Eyebrow>
      <h1>
        Creative range. Digital focus. Measurable impact.
      </h1>
      <p>
        Specialized in websites and interaction, with work spanning brand identity, illustration, music and audiovisual. Different disciplines, connected by craft and purpose.
      </p>
    </div>
    <div class="category-glyph-slot"><CategoryGlyph /></div>
  </header>
  <div data-projects-filter>
    <div class="projects-filters">
      <div class="category-filters" role="group" aria-label="Project category">
        {categories.map((category, i) => (
          <button type="button" data-category={i} aria-pressed={i === 0}>
            <Icon name={categoryIcons[i]} size={22} />
            <span>{category}</span>
          </button>
        ))}
        <button type="button" data-category="all" aria-pressed="false"><Icon name="grid2" size={22} /><span>All</span></button>
      </div>
      <div class="view-controls" role="group" aria-label="Project layout">
        {[
          ["2", "grid2", "Two columns"],
          ["3", "grid3", "Three columns"],
          ["list", "list", "List view"],
          ["timeline", "timeline", "Timeline view"],
        ].map(([view, icon, label]) => (
          <button
            type="button"
            data-view={view}
            aria-label={label}
            aria-pressed={view === "3"}
          >
            <Icon name={icon} />
          </button>
        ))}
      </div>
      <details class="filter-options">
        <summary>
          Filter <Icon name="filter" />
        </summary>
        <div>
          <label>
            Year
            <select name="year">
              <option value="">All years</option>
              {years.map(year => <option>{year}</option>)}
            </select>
          </label>
          <label>
            Location
            <select name="location">
              <option value="">All locations</option>
              {locations.map(value => <option>{value}</option>)}
            </select>
          </label>
          {[ ["stack", "Stack", stacks], ["tool", "Tools", tools], ["service", "Project type", services] ].map(([name, label, values]) => (
            <label>{label as string}<select name={name as string} data-facet><option value="">All</option>{(values as string[]).map(value => <option>{value}</option>)}</select></label>
          ))}
          <label>Card color<select name="color" data-facet><option value="">All</option>{colors.map((color,index) => <option value={color}>{color}</option>)}</select></label>
          <div class="filter-color-preview" aria-hidden="true">{colors.map(color => <span style={`background:${color}`} />)}</div>
          <button type="button" data-reset>
            Reset filters
          </button>
        </div>
      </details>
    </div>
    <section class="featured-project page-section" data-featured data-featured-paused hidden>
      <div class="featured-project-card">
        <ResponsiveImage
          src="/assets/figma/488-8155-imgImageBsaLegal.webp"
          width="900"
          height="650"
          alt="BSA Legal website"
        />
        <div class="featured-project-copy">
          <div class="chips">
            <span class="featured-label mono">Featured</span>
            <span class="outline-chip mono">Web Design &amp; Dev</span>
            <span class="outline-chip mono">Law firm · Brazil</span>
          </div>
          <h2>A law firm site that finally brings in qualified leads.</h2>
          <dl class="featured-metrics">
            {featuredMetrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
          <a class="text-link" href="/work/bsa-legal">
            Read the full case study <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </section>
    <section class="all-projects page-section">
      <p class="sr-only" data-count aria-live="polite"></p>
      <aside class="timeline-ruler" aria-label="Browse by year" hidden>
        <div class="timeline-ruler-ticks" aria-hidden="true"></div>
        <label class="sr-only" for="timeline-year-range">Year</label>
        <input id="timeline-year-range" type="range" min="0" max={Math.max(0,years.length-1)} value="0" step="1" aria-valuetext={years[0]} />
        <div class="timeline-ruler-years">{years.map((year,index)=><button type="button" data-timeline-year={year} data-year-index={index} aria-pressed={index===0}>{year}</button>)}</div>
      </aside>
      <div class="project-grid">
        {gridOrder.map((i) => (
          <div
            data-project
            data-kind={i === 4 || i === 5 ? "0,1" : "0"}
            data-year={projects[i].data.year}
            data-location={projects[i].data.location}
            data-stack={JSON.stringify(projects[i].data.tools.filter(tool => platforms.has(tool)))}
            data-tool={JSON.stringify(projects[i].data.tools.filter(tool => !platforms.has(tool)))}
            data-service={projects[i].data.category}
            data-color={projects[i].data.tint || projects[i].data.color}
          >
            <ProjectCard project={projects[i]} />
          </div>
        ))}
        <article class="your-turn-card">
          <IconWaves />
          <div class="your-turn-graphics" aria-hidden="true">
            <picture class="your-turn-orbit">
              <source media="(max-width: 768px)" srcset="/assets/figma/projects-cta-ellipse-mobile.svg" />
              <img src="/assets/figma/projects-cta-ellipse-desktop.svg" width="536" height="536" alt="" loading="lazy" />
            </picture>
            <div class="your-turn-growth">
            <ResponsiveImage
              src="/assets/figma/488-8180-img3DResultsGrowthBlack.webp"
              width="300"
              height="300"
              sizes="(max-width: 768px) 194px, 270px"
              alt=""
              loading="lazy"
            />
              <DitherIcon />
            </div>
            <p class="your-turn-label">Your<br />turn</p>
          </div>
          <div class="your-turn-copy">
            <h2>Want numbers like these on your site?</h2>
            <p>
              Book a 30 minute call. I will review your site first and bring the
              three fixes I would ship this month.
            </p>
          </div>
          <div class="your-turn-actions">
            <Button href="/contact">Book a call</Button>
            <small>Reply within 24 hours. No pitch deck.</small>
          </div>
        </article>
      </div>
      <p data-empty hidden>
        No projects in this category yet.{" "}
        <a href="/contact">Tell me what you have in mind.</a>
      </p>
    </section>
  </div>
  <script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import "../scripts/category-rail";

  onPageLoad((scope) => {
    if (!document.querySelector("[data-projects-filter]")) return;

    const root = document.querySelector<HTMLElement>("[data-projects-filter]")!;
    const categoryRail = root.querySelector<HTMLElement>(".category-filters")!;
    const updateCategoryEdges = () => {
      const max = categoryRail.scrollWidth - categoryRail.clientWidth;
      categoryRail.toggleAttribute("data-more-before", categoryRail.scrollLeft > 1);
      categoryRail.toggleAttribute("data-more-after", categoryRail.scrollLeft < max - 1);
    };
    categoryRail.addEventListener("scroll", updateCategoryEdges, { passive: true, signal: scope.signal });
    const categoryObserver = new ResizeObserver(updateCategoryEdges);
    categoryObserver.observe(categoryRail);
    categoryRail.querySelectorAll("button").forEach((button) => categoryObserver.observe(button));
    scope.cleanup(() => categoryObserver.disconnect());
    document.fonts.ready.then(() => { if (!scope.signal.aborted) updateCategoryEdges(); });
    updateCategoryEdges();
    const banner = root.querySelector<HTMLElement>(".your-turn-card");
    const introAnimations = new Set<Animation>();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    if (banner && "IntersectionObserver" in window) {
      const introObserver = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        introObserver.disconnect();
        if (reducedMotion.matches) return;
        [".your-turn-growth", ".your-turn-label"].forEach((selector, index) => {
          const element = banner.querySelector(selector);
          if (!element) return;
          const animation = element.animate([
            { opacity: 0, transform: `translateY(${index ? 6 : 16}px) scale(0.97)` },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ], { duration: 1400, delay: index * 120, fill: "backwards", easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
          introAnimations.add(animation);
          animation.onfinish = () => introAnimations.delete(animation);
        });
      }, { threshold: 0.2 });
      introObserver.observe(banner);
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) introAnimations.forEach((animation) => animation.finish());
      }, { signal: scope.signal });
      scope.cleanup(() => { introObserver.disconnect(); introAnimations.forEach((animation) => animation.cancel()); });
    }
    let category = "0";
    let dispatchedCategory: string | null = null;
    const buttons = root.querySelectorAll<HTMLButtonElement>(
      "button[data-category]",
    );
    const year = root.querySelector<HTMLSelectElement>("[name=year]")!;
    const location = root.querySelector<HTMLSelectElement>("[name=location]")!;
    const facets = Array.from(root.querySelectorAll<HTMLSelectElement>("[data-facet]"));
    const grid = root.querySelector<HTMLElement>(".all-projects > .project-grid")!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>("[data-project]"));
    const yearHeadings = new Map<string, HTMLHeadingElement>();
    [...new Set(items.map(item => item.dataset.year!))].sort((a,b)=>Number(b)-Number(a)).forEach(value=>{
      const heading=document.createElement("h2");
      heading.className="project-year-heading";
      heading.textContent=value;
      heading.hidden=true;
      yearHeadings.set(value,heading);
      grid.insertBefore(heading,banner || null);
    });
    const ruler=root.querySelector<HTMLElement>(".timeline-ruler")!;
    const yearRange=ruler.querySelector<HTMLInputElement>("input")!;
    const yearControls=Array.from(ruler.querySelectorAll<HTMLButtonElement>("[data-timeline-year]"));
    let rulerFrame=0;
    let rulerYears:string[]=[];
    const measureTimeline = () => {
      rulerFrame=0;
      const visible=items.filter(item=>!item.hidden);
      const timeline=root.dataset.view === "timeline";
      ruler.hidden=!timeline || !visible.length;
      if(!timeline || !visible.length)return;
      const gridBox=grid.getBoundingClientRect();
      const first=visible[0].getBoundingClientRect();
      const last=visible[visible.length-1].getBoundingClientRect();
      grid.style.setProperty("--timeline-line-start",`${first.top-gridBox.top}px`);
      grid.style.setProperty("--timeline-line-height",`${last.bottom-first.top}px`);
      ruler.toggleAttribute("data-in-range",gridBox.bottom>160 && gridBox.top<innerHeight*.8);
      const headings=Array.from(yearHeadings.entries()).filter(([,heading])=>!heading.hidden);
      rulerYears=headings.map(([value])=>value);
      yearRange.max=String(Math.max(0,rulerYears.length-1));
      yearRange.disabled=rulerYears.length<2;
      const active=headings.filter(([,heading])=>heading.getBoundingClientRect().top<innerHeight*.4).at(-1) || headings[0];
      yearControls.forEach(button=>{button.hidden=!headings.some(([value])=>value===button.dataset.timelineYear);button.setAttribute("aria-pressed",String(button.dataset.timelineYear===active?.[0]));});
      if(active){
        const index=rulerYears.indexOf(active[0]);
        yearRange.value=String(index);yearRange.setAttribute("aria-valuetext",active[0]);
      }
      const progress=Math.max(0,Math.min(1,(innerHeight*.4-first.top)/Math.max(1,last.bottom-first.top)));
      ruler.style.setProperty("--ruler-offset",reducedMotion.matches?"0px":`${(progress*240).toFixed(1)}px`);
    };
    const scheduleRuler = () => {if(!rulerFrame)rulerFrame=requestAnimationFrame(measureTimeline);};
    const goToYear=(value:string)=>{
      const heading=yearHeadings.get(value);
      if(heading && !heading.hidden)heading.scrollIntoView({behavior:reducedMotion.matches?"instant":"smooth",block:"start"});
    };
    yearControls.forEach(button=>button.addEventListener("click",()=>goToYear(button.dataset.timelineYear!),{signal:scope.signal}));
    yearRange.addEventListener("input",()=>goToYear(rulerYears[Number(yearRange.value)]),{signal:scope.signal});
    document.addEventListener("scroll",scheduleRuler,{passive:true,signal:scope.signal});
    window.addEventListener("resize",scheduleRuler,{passive:true,signal:scope.signal});
    const timelineObserver=new ResizeObserver(scheduleRuler);timelineObserver.observe(grid);
    scope.cleanup(()=>{cancelAnimationFrame(rulerFrame);timelineObserver.disconnect();});
    const updateTimeline = () => {
      const timeline=root.dataset.view === "timeline";
      yearHeadings.forEach((heading,value)=>{
        const group=items.filter(item=>item.dataset.year===value);
        heading.hidden=!timeline || !group.some(item=>!item.hidden);
        if(timeline){grid.append(heading);group.forEach(item=>grid.append(item));}
      });
      if(!timeline) items.forEach(item=>grid.append(item));
      if(banner)grid.append(banner);
      scheduleRuler();
    };
    scope.cleanup(()=>yearHeadings.forEach(heading=>heading.remove()));
    const update = () => {
      let count = 0;
      root.querySelectorAll<HTMLElement>("[data-project]").forEach((item) => {
        const match =
          (category === "all" || item.dataset.kind!.split(",").includes(category)) &&
          (!year.value || item.dataset.year === year.value) &&
          (!location.value || item.dataset.location!.includes(location.value)) &&
          facets.every(select => !select.value || (["stack", "tool"].includes(select.name)
            ? JSON.parse(item.dataset[select.name] || "[]").includes(select.value)
            : item.dataset[select.name] === select.value));
        item.hidden = !match;
        if (match) count++;
      });
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.category === category),
        ),
      );
      root.dataset.activeCategory = category;
      if (category !== dispatchedCategory) {
        dispatchedCategory = category;
        document.dispatchEvent(
          new CustomEvent("portfolio:category-change", {
            detail: { category },
          }),
        );
      }
      root.querySelector<HTMLElement>("[data-featured]")!.hidden =
        root.querySelector("[data-featured]")!.hasAttribute("data-featured-paused") || category !== "0" || !!year.value || !!location.value;
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = count !== 0;
      root.querySelector("[data-count]")!.textContent = `${count} projects`;
      updateTimeline();
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.category!;
        update();
      }, { signal: scope.signal }),
    );
    facets.forEach(select => select.addEventListener("change", update, { signal: scope.signal }));
    year.addEventListener("change", update, { signal: scope.signal });
    location.addEventListener("change", update, { signal: scope.signal });
    root.querySelector("[data-reset]")!.addEventListener("click", () => {
      facets.forEach(select => select.value = "");
      year.value = "";
      location.value = "";
      category = "0";
      update();
    }, { signal: scope.signal });
    const param = new URLSearchParams(window.location.search).get("category");
    if (param === "all") category = "all";
    else if (param === "experiments") category = "4";
    else if (param && /^[0-4]$/.test(param)) category = param;
    const layoutAnimations = new Set<Animation>();
    scope.cleanup(() => layoutAnimations.forEach(animation => animation.cancel()));
    reducedMotion.addEventListener("change", () => { if(reducedMotion.matches) layoutAnimations.forEach(animation => animation.cancel()); }, {signal:scope.signal});
    root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) =>
      button.addEventListener("click", () => {
        if ((root.dataset.view || "3") === button.dataset.view) return;
        layoutAnimations.forEach(animation => animation.cancel());
        layoutAnimations.clear();
        root.dataset.view = button.dataset.view;
        updateTimeline();
        if (!reducedMotion.matches) {
          items.filter(item => !item.hidden).forEach((item, index) => {
            const animation = item.animate([
              { opacity: 0, transform: "translateY(16px) scale(.99)" },
              { opacity: 1, transform: "translateY(0) scale(1)" },
            ], { duration: 300, delay: Math.min(index * 35, 210), easing: "cubic-bezier(.22,1,.36,1)", fill: "backwards" });
            layoutAnimations.add(animation);
            animation.onfinish = () => layoutAnimations.delete(animation);
          });
        }
        root
          .querySelectorAll("[data-view]")
          .forEach((control) =>
            control.setAttribute("aria-pressed", String(control === button)),
          );
      }, { signal: scope.signal }),
    );
    update();

  });
  </script>
</Base>

<style>
  :global(.your-turn-card) { isolation:isolate; }
  :global(.your-turn-card .your-turn-actions .action:not(.action--secondary):is(:hover, :focus-visible):not(:disabled):not([aria-disabled="true"])) { background:#fff; color:#232625; }
  :global(.your-turn-growth) { z-index:2; }
  :global(.your-turn-growth img) { width:100%; height:100%; object-fit:contain; }
  :global(.your-turn-label), :global(.your-turn-copy), :global(.your-turn-actions) { z-index:2; }
  .projects-filters .category-filters button { display:flex; align-items:center; gap:10px; }
  @media (max-width:768px) {
    .your-turn-card .your-turn-graphics { height:254px; }
    .your-turn-card .your-turn-orbit { width:536.204px; height:536.204px; top:-282.13px; left:calc(50% - 268.102px); }
    .projects-filters .category-filters { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); width:100%; max-width:100%; gap:8px; padding:0; overflow:visible; mask-image:none; cursor:auto; touch-action:auto; }
    .projects-filters .category-filters button { width:100%; min-width:0; max-width:none; justify-self:stretch; justify-content:flex-start; border-radius:14px; padding:14px 12px; min-height:76px; text-align:left; white-space:normal; font-size:11px; line-height:1.5; letter-spacing:.02em; gap:10px; }
    .projects-filters .category-filters button > span:last-child { min-width:0; overflow-wrap:normal; }
  }
</style>
