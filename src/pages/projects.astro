---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { featuredMetrics } from "../data/cases";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categories = [
  "Web Design & Dev",
  "Branding & Graphic Design",
  "Digital Art & Illustration",
  "Music & Audiovisual",
  "Experiments",
];
const gridOrder = [0, 2, 4, 1, 5, 3];
---

<Base title="Projects | Pedro Nogueira">
  <header class="projects-header page-section">
    <Eyebrow>Projects</Eyebrow>
    <h1>
      Real sites.
      <br />
      Measured results.
    </h1>
    <p>
      Every number on this page comes from the client's own analytics. Filter by
      the kind of work you need to see.
    </p>
  </header>
  <div data-projects-filter>
    <div class="projects-filters">
      <div class="category-filters" role="group" aria-label="Project category">
        {categories.map((category, i) => (
          <button type="button" data-category={i} aria-pressed={i === 0}>
            {category}
          </button>
        ))}
      </div>
      <div class="view-controls" role="group" aria-label="Project layout">
        {[
          ["2", "grid2", "Two columns"],
          ["3", "grid3", "Three columns"],
          ["list", "list", "List view"],
        ].map(([view, icon, label]) => (
          <button
            type="button"
            data-view={view}
            aria-label={label}
            aria-pressed={view === "3"}
          >
            <Icon name={icon} />
          </button>
        ))}
      </div>
      <details class="filter-options">
        <summary>
          Filter <Icon name="filter" />
        </summary>
        <div>
          <label>
            Year
            <select name="year">
              <option value="">All years</option>
              <option>2025</option>
              <option>2024</option>
            </select>
          </label>
          <label>
            Location
            <select name="location">
              <option value="">All locations</option>
              <option>USA</option>
              <option>Brazil</option>
              <option>Germany</option>
            </select>
          </label>
          <button type="button" data-reset>
            Reset filters
          </button>
        </div>
      </details>
    </div>
    <section class="featured-project page-section" data-featured>
      <div class="featured-project-card">
        <ResponsiveImage
          src="/assets/figma/488-8155-imgImageBsaLegal.webp"
          width="900"
          height="650"
          alt="BSA Legal website"
        />
        <div class="featured-project-copy">
          <div class="chips">
            <span class="featured-label mono">Featured</span>
            <span class="outline-chip mono">Web Design &amp; Dev</span>
            <span class="outline-chip mono">Law firm · Brazil</span>
          </div>
          <h2>A law firm site that finally brings in qualified leads.</h2>
          <p>
            BSA Legal needed a site that matched the firm and actually generated
            contacts. New Webflow build with CMS, legal blog and automated
            forms.
          </p>
          <dl class="featured-metrics">
            {featuredMetrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
          <p class="featured-quote">
            "[Short client quote about the result.]" [Name], BSA Legal
          </p>
          <a class="text-link" href="/work/bsa-legal">
            Read the full case study <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </section>
    <section class="all-projects page-section">
      <p class="sr-only" data-count aria-live="polite"></p>
      <div class="project-grid">
        {gridOrder.map((i) => (
          <div
            data-project
            data-kind={i === 4 || i === 5 ? "0,1" : "0"}
            data-year={projects[i].data.year}
            data-location={projects[i].data.location}
          >
            <ProjectCard project={projects[i]} />
          </div>
        ))}
        <article class="your-turn-card">
          <div class="your-turn-graphics" aria-hidden="true">
            <picture class="your-turn-orbit">
              <source media="(max-width: 768px)" srcset="/assets/figma/projects-cta-ellipse-mobile.svg" />
              <img src="/assets/figma/projects-cta-ellipse-desktop.svg" width="536" height="536" alt="" loading="lazy" />
            </picture>
            <ResponsiveImage
              class="your-turn-growth"
              src="/assets/figma/488-8180-img3DResultsGrowthBlack.webp"
              width="300"
              height="300"
              sizes="(max-width: 768px) 194px, 270px"
              alt=""
              loading="lazy"
            />
            <p class="your-turn-label">Your<br />turn</p>
          </div>
          <div class="your-turn-copy">
            <h2>Want numbers like these on your site?</h2>
            <p>
              Book a 30 minute call. I will review your site first and bring the
              three fixes I would ship this month.
            </p>
          </div>
          <div class="your-turn-actions">
            <Button href="/contact">Book a call</Button>
            <small>Reply within 24 hours. No pitch deck.</small>
          </div>
        </article>
      </div>
      <p data-empty hidden>
        No projects in this category yet.{" "}
        <a href="/contact">Tell me what you have in mind.</a>
      </p>
    </section>
  </div>
  <script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((scope) => {
    if (!document.querySelector("[data-projects-filter]")) return;

    const root = document.querySelector<HTMLElement>("[data-projects-filter]")!;
    const categoryRail = root.querySelector<HTMLElement>(".category-filters")!;
    const updateCategoryEdges = () => {
      const max = categoryRail.scrollWidth - categoryRail.clientWidth;
      categoryRail.toggleAttribute("data-more-before", categoryRail.scrollLeft > 1);
      categoryRail.toggleAttribute("data-more-after", categoryRail.scrollLeft < max - 1);
    };
    categoryRail.addEventListener("scroll", updateCategoryEdges, { passive: true, signal: scope.signal });
    const categoryObserver = new ResizeObserver(updateCategoryEdges);
    categoryObserver.observe(categoryRail);
    categoryRail.querySelectorAll("button").forEach((button) => categoryObserver.observe(button));
    scope.cleanup(() => categoryObserver.disconnect());
    document.fonts.ready.then(() => { if (!scope.signal.aborted) updateCategoryEdges(); });
    updateCategoryEdges();
    const banner = root.querySelector<HTMLElement>(".your-turn-card");
    const introAnimations = new Set<Animation>();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    if (banner && "IntersectionObserver" in window) {
      const introObserver = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        introObserver.disconnect();
        if (reducedMotion.matches) return;
        [".your-turn-growth", ".your-turn-label"].forEach((selector, index) => {
          const element = banner.querySelector(selector);
          if (!element) return;
          const animation = element.animate([
            { opacity: 0, transform: `translateY(${index ? 6 : 16}px) scale(0.97)` },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ], { duration: 1400, delay: index * 120, fill: "backwards", easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
          introAnimations.add(animation);
          animation.onfinish = () => introAnimations.delete(animation);
        });
      }, { threshold: 0.2 });
      introObserver.observe(banner);
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) introAnimations.forEach((animation) => animation.finish());
      }, { signal: scope.signal });
      scope.cleanup(() => { introObserver.disconnect(); introAnimations.forEach((animation) => animation.cancel()); });
    }
    let category = "0";
    const buttons = root.querySelectorAll<HTMLButtonElement>(
      "button[data-category]",
    );
    const year = root.querySelector<HTMLSelectElement>("[name=year]")!;
    const location = root.querySelector<HTMLSelectElement>("[name=location]")!;
    const update = () => {
      let count = 0;
      root.querySelectorAll<HTMLElement>("[data-project]").forEach((item) => {
        const match =
          item.dataset.kind!.split(",").includes(category) &&
          (!year.value || item.dataset.year === year.value) &&
          (!location.value || item.dataset.location!.includes(location.value));
        item.hidden = !match;
        if (match) count++;
      });
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.category === category),
        ),
      );
      root.querySelector<HTMLElement>("[data-featured]")!.hidden =
        category !== "0" || !!year.value || !!location.value;
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = count !== 0;
      root.querySelector("[data-count]")!.textContent = `${count} projects`;
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.category!;
        update();
      }, { signal: scope.signal }),
    );
    year.addEventListener("change", update, { signal: scope.signal });
    location.addEventListener("change", update, { signal: scope.signal });
    root.querySelector("[data-reset]")!.addEventListener("click", () => {
      year.value = "";
      location.value = "";
      category = "0";
      update();
    }, { signal: scope.signal });
    const param = new URLSearchParams(window.location.search).get("category");
    if (param === "experiments") category = "4";
    else if (param && /^[0-4]$/.test(param)) category = param;
    root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) =>
      button.addEventListener("click", () => {
        root.dataset.view = button.dataset.view;
        root
          .querySelectorAll("[data-view]")
          .forEach((control) =>
            control.setAttribute("aria-pressed", String(control === button)),
          );
      }, { signal: scope.signal }),
    );
    update();

  });
  </script>
</Base>
