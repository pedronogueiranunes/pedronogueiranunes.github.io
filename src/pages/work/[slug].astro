---
import { getCollection } from "astro:content";
import FilmGallery from "../../components/FilmGallery.astro";
import MusicCase from "../../components/MusicCase.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import ProjectVideo from "../../components/ProjectVideo.astro";
import { videoFor } from "../../data/project-videos";
import PixelTrail from "../../components/PixelTrail.astro";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import Button from "../../components/Button.astro";
import ToolChip from "../../components/ToolChip.astro";
import Icon from "../../components/Icon.astro";
import CaseShowcase from "../../components/CaseShowcase.astro";
import RelatedProjects from "../../components/RelatedProjects.astro";
import { logoFor } from "../../data/home";
import { PERSON_ID, ORIGIN, jsonLd } from "../../data/seo";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.caseSlug || project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const p = project.data;
const video = videoFor(p.caseSlug || project.slug);
const liveUrl = site.projectUrls[project.slug];
const archiveUrl = liveUrl ? `https://web.archive.org/web/*/${liveUrl}` : undefined;
const stack = p.tools;
const toolIcon = (tool: string) => /GA4|GTM|analytics/i.test(tool) ? "chart" : /GSAP/i.test(tool) ? "category-experiment" : "category-web";
// TODO: Replace layout fixtures with verified project narratives before publishing.
// Fixtures are intentionally excluded from production output.
const showMock = import.meta.env.DEV;
const strategyTitles: Record<string, string> = {
  "green-nation-collective": "From a collective idea to a campaign ready to launch.",
  "lemmbra-olympiad": "One registration journey across two countries.",
  "molina-chambo": "A clearer path from legal expertise to consultation.",
  "pinelake-broken-bow": "A direct route from cabin discovery to booking.",
  "waipono-farms": "Bring the farm identity into the online experience.",
};
const strategyTitle = p.strategyTitle || strategyTitles[project.slug] || p.title;
const caseSlug = p.caseSlug || project.slug;
// ponytail: metrics left out of schema until the TODO numbers are confirmed.
const caseSchema = jsonLd({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${ORIGIN}/work/${caseSlug}/#work`,
  name: p.title,
  description: p.summary,
  url: `${ORIGIN}/work/${caseSlug}/`,
  image: (p.collection || p.archivedWebsite || p.films.length > 0 || p.releases.length > 0) ? `${ORIGIN}${p.cover || p.image}` : `${ORIGIN}/assets/og/${caseSlug}.jpg`,
  ...(p.year ? { dateCreated: p.year } : {}),
  creator: { "@id": PERSON_ID },
  keywords: [p.category, ...p.tools].join(", "),
  locationCreated: p.country,
  ...(liveUrl ? { sameAs: liveUrl } : {}),
});
const related = (await getCollection("projects"))
  .filter((other) => other.slug !== project.slug)
  .sort((a, b) => a.data.order - b.data.order);
const metrics = p.metrics.map((m) => ({ ...m, baseline: "" }));
---

<Base title={`${p.title} | Pedro Nogueira`} description={p.summary || undefined} image={(p.collection || p.archivedWebsite || p.films.length > 0 || p.releases.length > 0) ? p.cover || p.image : `/assets/og/${caseSlug}.jpg`} ogType="article" pageClass="case-page">
  <script type="application/ld+json" slot="head" set:html={caseSchema} />
  {p.releases.length > 0 ? (
    <>
      <MusicCase project={p} />
      <RelatedProjects title="More music and audiovisual." eyebrow="Music & Audiovisual" projects={related.filter(other => other.data.films.length > 0 || other.data.releases.length > 0)} />
    </>
  ) : p.films.length > 0 ? (
    <>
      <section class="film-case page-section">
        <nav class="case-breadcrumb mono" aria-label="Breadcrumb"><a href="/projects?category=3">Projects</a><span>/</span><span>Music &amp; Audiovisual</span></nav>
        <h1>{p.title}</h1>
        <div class="film-case__details"><span>{p.filmType}</span><span>{p.practice}</span>{p.year && <span>{p.year}</span>}</div>
        <p class="film-case__summary">{p.summary}</p>
        <FilmGallery films={p.films} />
      </section>
      <RelatedProjects title="More films and performances." eyebrow="Music & Audiovisual" projects={related.filter(other => other.data.films.length > 0 || other.data.releases.length > 0).sort((a,b) => Number(b.data.filmType === p.filmType) - Number(a.data.filmType === p.filmType))} />
    </>
  ) : (p.collection || p.archivedWebsite) ? (
    <>
      <section class:list={["art-collection page-section", { "archived-website-case": p.archivedWebsite }]}>
        <nav class="case-breadcrumb mono" aria-label="Breadcrumb"><a href={`/projects?category=${p.kinds?.[0] || "2"}`}>Projects</a><span>/</span><span>{p.category}</span></nav>
        <h1>{p.title}</h1>
        {p.studio && <p class="case-studio mono">{p.studio}</p>}
        {p.summary && <p>{p.summary}</p>}
        <div class="art-collection-grid" data-lightbox-group>
          {p.gallery.map((piece) => (
            <figure>
              {piece.video ? (
                <video controls playsinline preload="none" poster={piece.src} aria-label={piece.alt}>
                  <source src={piece.video} type="video/mp4" />
                </video>
              ) : <a href={piece.src} data-gallery-src={piece.src} data-gallery-alt={piece.alt} data-gallery-caption={piece.caption} aria-label={piece.alt}>
                <ResponsiveImage src={piece.src} alt={piece.alt} sizes="(max-width: 768px) calc(100vw - 40px), 50vw" loading="lazy" />
              </a>}
              {piece.caption && <figcaption>{piece.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <ImageLightbox />
      </section>
      <RelatedProjects title={p.archivedWebsite ? "More websites from SUPERFLUID." : undefined} eyebrow={p.archivedWebsite ? "SUPERFLUID" : undefined} projects={related.filter(other => p.archivedWebsite ? other.data.archivedWebsite : other.data.collection)} />
    </>
  ) : (
    <>
  <section class="case-hero page-section">
    <PixelTrail tone="green" />
    <div class="case-hero-top">
      <div class="case-intro">
        <nav class="case-breadcrumb mono" aria-label="Breadcrumb">
          <a href="/projects">Projects</a>
          <span>/</span>
          <span>{p.category}</span>
          <span>/</span>
          <span>{p.title.split(":")[0]}</span>
        </nav>
        <h1>{p.title}</h1>
        <p>{p.summary}</p>
        <div class="chips">
          <ToolChip label={p.category} icon="category-web" />
          {p.location && <ToolChip label={p.location} icon="location" />}
          {p.year && <ToolChip label={p.year} icon="calendar" />}
        </div>
        <div class="case-identity-group">
        <div class="case-client-row">
          <div class="case-client-badge">
            <span class="case-client-avatar" aria-hidden="true"><Icon name="category-brand" size={18} /></span>
            <div>
              <p class="case-client">
                {p.title.split(":")[0]}
              </p>
            </div>
          </div>
        </div>
        <div class="case-hero-stack" aria-label="Stack">
          {stack.map((tool) => <ToolChip label={tool} logo={logoFor(tool)} icon={logoFor(tool) ? undefined : toolIcon(tool)} />)}
        </div>
        </div>
        <div class="case-external-actions">
          <Button
            href={liveUrl || undefined}
            disabled={!liveUrl}
            secondary
            icon="arrow-up-right"
          >
            Visit live site
          </Button>
          <Button href={archiveUrl} disabled={!archiveUrl} secondary icon="history">Wayback Machine</Button>
        </div>
      </div>
      {metrics.length > 0 && <div class="case-result-card">
        <p class="mono accent"><Icon name="chart" size={16} />Results</p>
        <dl>
          {metrics.map((metric) => (
            <div>
              <dt>
                {metric.label}
                {metric.baseline && <small>{metric.baseline}</small>}
              </dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </div>}
    </div>
    <div class="browser-mockup" tabindex="0" aria-label="Website preview">
      <div class="browser-toolbar">
        <div aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <span class="mono">{liveUrl ? new URL(liveUrl).hostname : p.title.split(":")[0]}</span>
        {p.year && <small>Live since {p.year}</small>}
      </div>
      <div class="browser-mockup-viewport">
        {video ? <ProjectVideo base={video} full /> : (
        <div class="browser-mockup-track">
          <ResponsiveImage
            src={p.cover || p.image}
            loading="eager"
            sizes="(max-width: 768px) calc(100vw - 40px), calc(100vw - 128px)"
            width="1312"
            height="800"
            alt={`${p.title} website`}
            fetchpriority="high"
          />
        </div>
        )}
      </div>
    </div>
  </section>
  <div class="case-body page-section">
    <div class="case-narrative">
      {showMock && <p class="case-mock-notice"><Icon name="category-experiment" />Mock content for layout review. Development preview only.</p>}
      <section>
        <h2>The challenge</h2>
        <h3>{p.title}</h3>
        <p>{p.summary}</p>
        {showMock && <>
          <p>This sample brief explores how a growing team could present a complex offer clearly, support different audiences and keep the next step easy to find. It is a layout fixture, not a verified description of this project.</p>
          <p>A longer narrative needs room for context, constraints and competing priorities. This paragraph tests reading rhythm, line length and the spacing between ideas before the final case copy is available.</p>
        </>}
      </section>
      {showMock && <section>
        <h2>The strategy</h2>
        <h3>{strategyTitle}</h3>
        <ol class="strategy-list">
          <li><h4>Clarify the journey</h4><p>Map the questions a visitor may bring, group related information and establish a clear path through the page. This is sample strategy content for reviewing the template.</p></li>
          <li><h4>Build a flexible system</h4><p>Explore reusable sections, readable typography and a consistent set of controls. Test both short and long content across desktop, tablet and mobile layouts.</p></li>
          <li><h4>Review before launch</h4><p>Check navigation, forms and responsive behavior, then document what still needs real content or validation. No project outcome is implied by this mock narrative.</p></li>
        </ol>
      </section>}
      {p.metrics.length > 0 && <section>
        <h2>The results</h2>
        <h3>{p.title.split(":")[0]}</h3>
        <dl class="featured-metrics">
          {p.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </section>}
      {p.gallery.length > 0 && <section>
        <h2>Screens</h2>
        <div class="art-collection-grid" data-lightbox-group>
          {p.gallery.map((piece) => (
            <figure><a href={piece.src} data-gallery-src={piece.src} data-gallery-alt={piece.alt} data-gallery-caption={piece.caption} aria-label={piece.alt}>
              <ResponsiveImage src={piece.src} alt={piece.alt} sizes="(max-width: 768px) calc(100vw - 40px), 40vw" loading="lazy" />
            </a>{piece.caption && <figcaption>{piece.caption}</figcaption>}</figure>
          ))}
        </div>
        <ImageLightbox />
      </section>}
      {showMock && <blockquote class="case-testimonial">
        <small class="case-testimonial-note">Fictional quote for layout review</small>
        <span aria-hidden="true">“</span>
        <p>We needed a website that made the idea easy to understand and gave our team the confidence to keep it moving. The result feels clear, considered and easy to build on.</p>
        <cite><Icon name="chat" />Sample client, fictional testimonial</cite>
      </blockquote>}
    </div>
    <aside class="case-sidebar">
      <div class="snapshot">
        <h2>Project snapshot</h2>
        <dl>
          {[
            ["Client", p.title.split(":")[0]],
            ["Studio", p.studio],
            ["Market", p.location],
            ["Services", p.services],
            ["Timeline", p.duration],
          ].filter(([, value]) => value?.length).map(([key, value]) => (
            <div>
              <dt>{key}</dt>
              <dd>{Array.isArray(value) ? value.map((item, n) => <>{n > 0 && ", "}<span>{item}</span></>) : value}</dd>
            </div>
          ))}
        </dl>
        {stack.length > 0 && <div class="snapshot-stack">
          <h3><Icon name="category-web" />Stack</h3>
          <div class="chips">{stack.map((tool) => <ToolChip label={tool} logo={logoFor(tool)} icon={logoFor(tool) ? undefined : toolIcon(tool)} />)}</div>
        </div>}
      </div>
      <div class="case-sidebar-cta">
        <h2>Need a site that brings in qualified leads?</h2>
        <p>
          Book a 30 minute call. I will review your site first and come with
          three fixes.
        </p>
        <Button href="/contact">Book a call</Button>
        <a href="mailto:pedronogueiranunes@gmail.com">
          or email pedronogueiranunes@gmail.com
        </a>
      </div>
    </aside>
  </div>
  <CaseShowcase project={p} liveUrl={liveUrl} />
  <RelatedProjects projects={related} />
    </>
  )}
</Base>

<style>
  .film-case { padding-top: clamp(140px, 15vw, 190px); padding-bottom: 80px; max-width: 1160px; margin-inline: auto; }
  .film-case h1 { margin: 28px 0 24px; font-size: clamp(36px, 5vw, 64px); line-height: 1.08; }
  .film-case__details { display: flex; flex-wrap: wrap; gap: 12px 24px; color: var(--text-secondary); font: 500 13px/1.5 var(--font-mono); margin-bottom: 20px; }
  .film-case__summary { max-width: 70ch; margin-bottom: 40px; }
  .art-collection { padding-top: clamp(128px, 14vw, 184px); padding-bottom: 80px; }
  .art-collection h1 { margin: 24px 0 48px; font-size: clamp(36px, 5vw, 64px); line-height: 1.08; }
  .art-collection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; align-items: start; }
  .archived-website-case .art-collection-grid { grid-template-columns: minmax(0, 1fr); }
  .archived-website-case .case-studio { margin: -24px 0 12px; }
  .archived-website-case > p:last-of-type { margin-bottom: 32px; }
  .art-collection-grid figure { margin: 0; }
  .art-collection-grid a { display: block; border-radius: 14px; overflow: hidden; }
  .art-collection-grid :global(img) { display: block; width: 100%; height: auto; }
  .art-collection-grid video { display: block; width: 100%; height: auto; border-radius: 14px; }
  .art-collection-grid figcaption { padding-top: 12px; }
  @media (max-width: 768px) { .art-collection-grid { grid-template-columns: 1fr; gap: 24px; } }
</style>
