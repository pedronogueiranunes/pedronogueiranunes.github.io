---
import PixelTrail from "../components/PixelTrail.astro";
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ContactForm from "../components/ContactForm.astro";
import CheckList from "../components/CheckList.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import { nextSteps, testimonial } from "../data/contact";
import { faq } from "../data/services";
import { site } from "../data/site";
const hasTestimonial = !!testimonial.quote && !testimonial.quote.includes("[");
---

<Base
  title="Contact Pedro Nogueira: projects, agency work and roles"
  description="Start a website, brand or CRO project, talk about agency partnerships, or reach out about a senior design engineer role."
  pageClass="contact-page"
>
  <section class="contact-hero page-section">
    <PixelTrail tone="green" world worldOrigin=".contact-form-wrap" />
    <div class="contact-intro">
      <Eyebrow>Contact</Eyebrow>
      <h1>
        Tell me what you're working on.
        <br />
        <span>I'll reply with a clear next step.</span>
      </h1>
      <div class="first-call">
        <h2>What you get from the first call</h2>
        <CheckList
          items={[
            "A look at your site or brief before we talk",
            "Honest advice on scope, platform and timeline",
            "A written price range, yours to keep even if you do not hire me",
          ]}
        />
      </div>
      <div class="next-steps">
        <h2 class="mono accent">What happens next</h2>
        <ol>
          {nextSteps.map(([title, body]) => (
            <li>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="contact-meta">
      {hasTestimonial ? (
        <blockquote class="contact-testimonial">
          <span class="testimonial-avatar" aria-hidden="true"></span>
          <div>
            <p>
              {testimonial.quote}{" "}
              <small aria-label="5 out of 5 stars">{testimonial.rating}</small>
            </p>
            <cite>{testimonial.attribution}</cite>
          </div>
        </blockquote>
      ) : (
        <p class="contact-client-note">
          Recent clients include BSA Legal, Molina Chambô and PineLake Broken Bow.
        </p>
      )}
      <dl class="contact-details">
        <div>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
        <div>
          <dt>Time zone</dt>
          {/* TODO: confirm with Pedro before publishing */}
          <dd>Brasília (UTC−3) · Calls 11 am to 4 pm ET</dd>
        </div>
        <div>
          <dt>Reply time</dt>
          {/* TODO: confirm with Pedro before publishing */}
          <dd>Within one business day</dd>
        </div>
      </dl>
      </div>
    </div>
    <ContactForm />
  </section>
  <section class="faq-section page-section">
    <Eyebrow>Before you hit send</Eyebrow>
    <h2>Common questions.</h2>
    <FAQ
      items={faq.filter(
        (item) => item.question !== "Which platforms do you work with?",
      )}
    />
  </section>
  <div class="social-links page-section">
    {Object.entries(site.socials).map(([name, url]) =>
      url ? (
        <a class="text-link" href={url}>
          {name}
          <Icon name="arrow-up-right" />
        </a>
      ) : (
        <span class="text-link social-unavailable">
          {name}
          <Icon name="arrow-up-right" />
        </span>
      ),
    )}
  </div>
</Base>
