---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LegalModals from "../components/LegalModals.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {Astro.url.pathname === "/" && <link rel="icon" href="data:," /> }
    <meta
      name="description"
      content="Senior web designer and developer. WordPress, Webflow, Framer, Shopify and React. 12+ years, clients in the US, Canada and Germany."
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="preload"
      href="/assets/fonts/manrope-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/hanken-grotesk-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Runs before paint so there's no flash of the wrong theme.
      try {
        const saved = localStorage.getItem("theme");
        const theme = saved === "light" || saved === "dark" ? saved : "auto";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "auto";
      }
    </script>
  </head>
  <body>
    <Navbar />

    <main id="main" tabindex="-1" transition:name="page-content" transition:animate="none">
      <slot />
    </main>

    <Footer />
    <LegalModals />
    <div id="pixel-curtain" aria-hidden="true"></div>
    <script>
      import "../scripts/transitions";
    </script>
  </body>
</html>
