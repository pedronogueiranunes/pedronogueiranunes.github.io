---
import "../styles/global.css";
import "../styles/remaining-fidelity.css";
import "../styles/case-template.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LegalModals from "../components/LegalModals.astro";

import { localeFromPath } from "../i18n/locales";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  /** Social preview image path, 1200x630. */
  image?: string;
  ogType?: "website" | "article" | "profile";
}
const {
  title,
  description = "Senior web designer and developer. WordPress, Webflow, Framer, Shopify and React. 12+ years, clients in the US, Canada and Germany.",
  pageClass,
  image = "/assets/og/default.jpg",
  ogType = "website",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogLocale = { en: "en_US", "pt-br": "pt_BR", es: "es_ES", fr: "fr_CA" }[localeFromPath(Astro.url.pathname)];
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {/^\/(?:pt-br\/?|es\/?|fr\/?)?$/.test(Astro.url.pathname) && <link rel="icon" href="data:," /> }
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pedro Nogueira" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
    <link
      rel="preload"
      href="/assets/fonts/manrope-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/hanken-grotesk-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Lets CSS hide media that fades in once it has decoded, with a no-JS fallback.
      document.documentElement.classList.add("js");
      // Restore an explicitly selected language on unprefixed entry URLs.
      try {
        const language = localStorage.getItem("language");
        if (["pt-br", "es", "fr"].includes(language || "") && !/^\/(pt-br|es|fr)(\/|$)/.test(location.pathname)) {
          location.replace(`/${language}${location.pathname}${location.search}${location.hash}`);
        }
      } catch {}
      // Runs before paint so there's no flash of the wrong theme.
      try {
        const saved = localStorage.getItem("theme");
        const theme = saved === "light" || saved === "dark" ? saved : "auto";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "auto";
      }
    </script>
  </head>
  <body>
    <Navbar />

    <main class={pageClass} id="main" tabindex="-1" transition:name="page-content" transition:animate="none">
      <slot />
    </main>

    <Footer />
    <LegalModals />
    <div id="pixel-curtain" aria-hidden="true"></div>
    <script>
      import "../scripts/transitions";
      import "../scripts/page-arrival";
      import "../scripts/localization";
      import "../scripts/pointer-glow";
      import { onPageLoad } from "../scripts/page-lifecycle";
      import { initScrollPreviews } from "../scripts/project-media-scroll";
      onPageLoad((scope) => {
        scope.cleanup(initScrollPreviews());
      });
    </script>
  </body>
</html>
